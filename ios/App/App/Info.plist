<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>SkateHubba</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>com.skatehubba.app</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.2.0</string> <!-- x-release-please-version -->
	<key>CFBundleVersion</key>
	<string>11</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>SkateHubba uses the camera to show a live preview so you can line up your trick, to record it, and to take a profile photo. The camera turns off when you leave the record screen or the app.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>SkateHubba uses the microphone so your trick clips have sound. It is on only while the record screen is open and turns off when you leave that screen or the app.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>SkateHubba opens your photo library only when you choose something from it: a profile photo or banner, or a skate video to upload or edit in the clip editor.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>SkateHubba saves full-quality clips you export from the clip editor to your camera roll.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>SkateHubba uses your location only while you are using the app, to show skate spots near you and to confirm you are at a spot when you check in. Your exact location is never shown to other skaters.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
