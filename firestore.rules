rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Shared document-lookup helpers (pure aliases for get/getAfter/exists/existsAfter).
    function fsGet(c, id) { return get(/databases/$(database)/documents/$(c)/$(id)); }
    function fsGetAfter(c, id) { return getAfter(/databases/$(database)/documents/$(c)/$(id)); }
    function fsExists(c, id) { return exists(/databases/$(database)/documents/$(c)/$(id)); }
    function fsExistsAfter(c, id) { return existsAfter(/databases/$(database)/documents/$(c)/$(id)); }


    // ── Project bucket name (audit S5+S12, PR-B) ──
    // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r1
    function FIREBASE_BUCKET() {
      return 'sk8hub-d7806\\.firebasestorage\\.app';
    }

    // Fully-assembled regex literals. The match-resolution `allow update`
    // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r2
    function BUCKET_DL_URL_RE() {
      return '^https://firebasestorage\\.googleapis\\.com/v0/b/sk8hub-d7806\\.firebasestorage\\.app/.+';
    }
    //   • both forms (download-URL + bucket-as-host CDN) — used by
    //     currentTrickVideoUrl / clips.videoUrl.
    function BUCKET_BOTH_FORMS_RE() {
      return '^https://(firebasestorage\\.googleapis\\.com/v0/b/sk8hub-d7806\\.firebasestorage\\.app|sk8hub-d7806\\.firebasestorage\\.app)/.+';
    }

    // ── Helper functions ──

    // ── Customizable profile helpers ──
    function pcLinkOk(url) {
      return url is string && url.size() <= 200
        && url.matches('^https://([a-z0-9-]+\\.)?(instagram\\.com|tiktok\\.com|youtube\\.com|youtu\\.be|x\\.com|twitter\\.com|twitch\\.tv|spotify\\.com|soundcloud\\.com|linktr\\.ee|threads\\.net|facebook\\.com|vimeo\\.com|myshopify\\.com|bigcartel\\.com|etsy\\.com|depop\\.com|skatehubba\\.com)(/[^\\s]*)?$');
    }
    function pcHex(v) {
      return v is string && v.matches('^#[0-9A-Fa-f]{6}$');
    }
    function pcInt(v, lo, hi) {
      return v is int && v >= lo && v <= hi;
    }
    function pcStr(v, lo, hi) {
      return v is string && v.size() >= lo && v.size() <= hi;
    }
    function pcLinkAt(l, i) {
      return i >= l.size() || (
        l[i] is map && l[i].keys().hasOnly(['label', 'url']) && l[i].keys().hasAll(['label', 'url'])
        && pcStr(l[i].label, 1, 30) && pcLinkOk(l[i].url));
    }
    function pcSponsorAt(l, i) {
      return i >= l.size() || (
        l[i] is map && l[i].keys().hasOnly(['name', 'url']) && l[i].keys().hasAll(['name', 'url'])
        && pcStr(l[i].name, 1, 40) && (l[i].url == '' || pcLinkOk(l[i].url)));
    }
    function pcStrAt(l, i, hi) {
      return i >= l.size() || pcStr(l[i], 1, hi);
    }
    function profileCustomValid(d) {
      return d.keys().hasOnly(['accent', 'gradientFrom', 'gradientTo', 'gradientAngle',
          'bannerPosX', 'bannerPosY', 'bannerZoom', 'sections', 'pinnedClipIds',
          'showcaseSignature', 'bio', 'links', 'sponsors', 'favoriteTricks',
          'themeSongId', 'updatedAt'])
        && d.keys().hasAll(['accent', 'gradientFrom', 'gradientTo', 'gradientAngle',
          'bannerPosX', 'bannerPosY', 'bannerZoom', 'sections', 'pinnedClipIds',
          'showcaseSignature', 'bio', 'links', 'sponsors', 'favoriteTricks',
          'themeSongId', 'updatedAt'])
        && d.updatedAt == request.time
        && pcHex(d.accent) && pcHex(d.gradientFrom) && pcHex(d.gradientTo)
        && pcInt(d.gradientAngle, 0, 359)
        && pcInt(d.bannerPosX, 0, 100) && pcInt(d.bannerPosY, 0, 100)
        && pcInt(d.bannerZoom, 100, 200)
        && d.sections is list && d.sections.size() == 5
        && d.sections.hasAll(['clips', 'stats', 'closet', 'crew', 'spots'])
        && d.pinnedClipIds is list && d.pinnedClipIds.size() <= 3
        && pcStrAt(d.pinnedClipIds, 0, 128) && pcStrAt(d.pinnedClipIds, 1, 128) && pcStrAt(d.pinnedClipIds, 2, 128)
        && d.showcaseSignature is bool
        && pcStr(d.bio, 0, 280)
        && d.links is list && d.links.size() <= 5
        && pcLinkAt(d.links, 0) && pcLinkAt(d.links, 1) && pcLinkAt(d.links, 2)
        && pcLinkAt(d.links, 3) && pcLinkAt(d.links, 4)
        && d.sponsors is list && d.sponsors.size() <= 5
        && pcSponsorAt(d.sponsors, 0) && pcSponsorAt(d.sponsors, 1) && pcSponsorAt(d.sponsors, 2)
        && pcSponsorAt(d.sponsors, 3) && pcSponsorAt(d.sponsors, 4)
        && d.favoriteTricks is list && d.favoriteTricks.size() <= 5
        && pcStrAt(d.favoriteTricks, 0, 40) && pcStrAt(d.favoriteTricks, 1, 40) && pcStrAt(d.favoriteTricks, 2, 40)
        && pcStrAt(d.favoriteTricks, 3, 40) && pcStrAt(d.favoriteTricks, 4, 40)
        && d.themeSongId in ['', 'boom-bap-90', 'punk-170', 'lofi-75', 'breaks-128'];
    }

    // Closet Studio (VITE_FEATURE_CLOSET_STUDIO) — mirror: services/closetStudio.ts.
    // Fixed keys, picture URL pinned to the owner's own object, Mike White
    // credit required on anything made from his templates, and a design is
    // public only after the image filter passed.
    function closetDesignValid(d, uid, designId) {
      return d.keys().hasOnly(['name', 'slot', 'templateId', 'credit', 'imageUrl',
          'layerCount', 'shared', 'moderation', 'updatedAt'])
        && d.keys().hasAll(['name', 'slot', 'templateId', 'credit', 'imageUrl',
          'layerCount', 'shared', 'moderation', 'updatedAt'])
        && d.updatedAt == request.time
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
        && d.slot in ['shoes', 'top', 'bottom', 'head', 'deck']
        && d.templateId is string && d.templateId.size() <= 64
        && d.templateId.matches('^[a-z0-9_]*$')
        && d.credit == (d.templateId.matches('^mike_white.*') ? 'Based on a Mike White design' : '')
        && d.imageUrl is string
        && d.imageUrl.matches('^https://firebasestorage\\.googleapis\\.com/v0/b/' + FIREBASE_BUCKET() +
          '/o/closetDesigns%2F' + uid + '%2F' + designId + '\\.webp(\\?.*)?$')
        && d.layerCount is int && d.layerCount >= 1 && d.layerCount <= 8
        && d.shared is bool
        && d.moderation in ['pending', 'passed']
        && (!d.shared || d.moderation == 'passed');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Admin custom claim ──
    // `admin: true` is minted on the ID token by the Admin SDK (out-of-band
    // console tooling) and can never be self-assigned by a client, so it is a
    // safe authorization signal for the privileged console surfaces:
    // Verified-Pro granting (users/{uid}), badge + gear awarding
    // (users/{uid}/achievements, users/{uid}/locker) and report moderation
    // (reports/{reportId}). The claim only widens WHO may write — every admin
    // path below stays field-scoped, so a stolen admin token still cannot
    // rewrite usernames, inflate stats, or edit a report's evidence.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // WTT helpers: verified email on the token; Verified-Pro flag on the
    // user's public profile (set only by admin tooling).
    function emailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isVerifiedPro() {
      return fsGet('users', request.auth.uid).data.get('isVerifiedPro', false) == true;
    }

    // ── Ban gate (moderation) ──
    // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r3
    function notBanned() {
      return !fsExists('bans', request.auth.uid);
    }

    function isPlayer(game) {
      return isSignedIn() && (
        request.auth.uid == game.player1Uid ||
        request.auth.uid == game.player2Uid
      );
    }

    // A judge is a non-player third user nominated at game creation who
    // rules on disputes and "Call BS" claims. Judge fields may be null on
    // honor-system games — always guard with 'judgeId' in-check first.
    function isJudge(game) {
      return isSignedIn()
        && 'judgeId' in game
        && game.judgeId != null
        && request.auth.uid == game.judgeId;
    }

    // Game doc is readable by either player OR the nominated judge.
    function isParticipant(game) {
      return isPlayer(game) || isJudge(game);
    }

    // True when a judge is actively seated (accepted the invite). Honor-system
    // rules apply until this is true — no dispute/BS transitions permitted.
    function judgeActive(game) {
      return 'judgeId' in game && game.judgeId != null
        && 'judgeStatus' in game && game.judgeStatus == 'accepted';
    }

    // ── Video-URL bucket pins (audit P2) ──
    // Factored out of the games match-resolution / dispute / clips rules so
    // the bucket-pin predicate doesn't blow the per-rule 1000-expression
    // evaluation ceiling when layered on top of the turn-order seize guard.
    // Semantics are identical to the previous inline checks:
    //   • matchVideoUrlOk: accepts the unchanged value, explicit null, or a
    //     string pinned to FIREBASE_BUCKET() via the getDownloadURL() form.
    //   • videoUrlBucketPinned: the both-forms (download-URL + bucket-as-host
    //     CDN) check used by currentTrickVideoUrl and clips.videoUrl.
    function videoUrlBucketPinned(url) {
      return url is string && url.matches(BUCKET_BOTH_FORMS_RE());
    }

    function matchVideoUrlOk(newUrl, oldUrl) {
      return newUrl == oldUrl
        || newUrl == null
        || (newUrl is string && newUrl.matches(BUCKET_DL_URL_RE()));
    }

    // ── User-uploaded clip video pin ──
    // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r4
    function userClipVideoUrlOk(url, uid) {
      return url is string
        && url.size() <= 2048
        && url.matches(
          '^https://firebasestorage\\.googleapis\\.com/v0/b/' + FIREBASE_BUCKET() +
          '/o/userClips%2F' + uid + '%2F[A-Za-z0-9_-]+\\.(webm|mp4)(\\?.*)?$'
        );
    }

    // Approved playback lives under approvedClips/{uid}/ so a signed-in
    // reader can fetch it without a per-request Firestore lookup. Pending
    // clips must not point here.
    function userClipPublicUrlOk(url, uid) {
      return url is string
        && url.size() <= 2048
        && url.matches(
          '^https://firebasestorage\\.googleapis\\.com/v0/b/' + FIREBASE_BUCKET() +
          '/o/approvedClips%2F' + uid + '%2F[A-Za-z0-9_-]+\\.(webm|mp4)(\\?.*)?$'
        );
    }

    // ── Game-clip video pin (security audit 2026-10-21, H1) ──
    // A game clip's video must be the attributed player's own upload for that
    // exact game, turn and role. Storage pins every game upload to
    // games/{gameId}/turn-{n}/{role}-{uploaderUid}.{ext}, so only the player
    // named in the file can have written it. Without this, any participant
    // could publish any bucket object as the opponent's clip.
    function gameClipVideoUrlOk(d) {
      return d.videoUrl is string
        && d.videoUrl.size() <= 2048
        && d.gameId.matches('^[A-Za-z0-9_-]{1,128}$')
        && d.videoUrl.matches(
          '^https://firebasestorage\\.googleapis\\.com/v0/b/' + FIREBASE_BUCKET() +
          '/o/games%2F' + d.gameId + '%2Fturn-' + string(d.turnNumber) + '%2F' + d.role + '-' +
          d.playerUid + '\\.(webm|mp4)(\\?.*)?$'
        );
    }

    // Server-side moderation switch. config/moderation { enabled: bool } is
    // written only by the Admin SDK. When it is on, a user clip must start
    // pending; absent or off keeps the moderation-off direct publish.
    function moderationOn() {
      return fsExists('config', 'moderation')
        && fsGet('config', 'moderation').data.get('enabled', false) == true;
    }

    // ── User-clip creation rate limit (30s) ──
    // Same two-part idiom as /reports + reports_limits: a pre-state read
    // proves the cooldown elapsed, and a getAfter() on the SAME batch
    // proves the caller advanced the anchor. Unlike the best-effort
    // lastSpotCreatedAt gate, the getAfter() makes the companion write
    // MANDATORY — a client that simply omits it is denied instead of
    // silently skipping the cooldown forever. The anchor lives on
    // users/{uid}.lastClipCreatedAt, pinned to request.time by the owner-
    // update rule, so it cannot be back-dated.
    function clipRateLimitOk() {
      return (
        !('lastClipCreatedAt' in fsGet('users', request.auth.uid).data)
        || request.time > fsGet('users', request.auth.uid).data.lastClipCreatedAt + duration.value(30, 's')
      )
      && fsGetAfter('users', request.auth.uid).data.lastClipCreatedAt == request.time;
    }

    // ── Spot creation rate limit (30s) ── mirrors clipRateLimitOk().
    function spotRateLimitOk() {
      return (
        !('lastSpotCreatedAt' in fsGet('users', request.auth.uid).data)
        || request.time > fsGet('users', request.auth.uid).data.lastSpotCreatedAt + duration.value(30, 's')
      )
      && fsGetAfter('users', request.auth.uid).data.lastSpotCreatedAt == request.time;
    }

    // ── Clip vote aggregates ──
    // The two counters on /clips are driven exclusively by the caller's own
    // clipVotes/{uid}_{clipId} doc. Every accepted shape below is proven
    // against that doc's pre- and post-write state, so a client can never
    // move a counter without moving its vote in lockstep.
    function clipVoteRef(clipId) {
      return /databases/$(database)/documents/clipVotes/$(request.auth.uid + '_' + clipId);
    }
    // Legacy vote docs pre-date `value` and were all upvotes → default 1.
    function voteValueBefore(clipId) {
      return get(clipVoteRef(clipId)).data.get('value', 1);
    }
    function voteValueAfter(clipId) {
      return getAfter(clipVoteRef(clipId)).data.get('value', 1);
    }
    // Legacy clips pre-date both aggregates → default 0 on BOTH sides so an
    // untouched counter reads as a zero delta rather than an error.
    function clipUpDelta() {
      return request.resource.data.get('upvoteCount', 0) - resource.data.get('upvoteCount', 0);
    }
    function clipDownDelta() {
      return request.resource.data.get('downvoteCount', 0) - resource.data.get('downvoteCount', 0);
    }
    function clipVoteDeltaOk(clipId) {
      return (
        // Vote CAST: doc absent before, present after. The new doc's own
        // `value` decides which counter moves; the other must not budge.
        (!exists(clipVoteRef(clipId)) && existsAfter(clipVoteRef(clipId))
          && (
            (voteValueAfter(clipId) == 1 && clipUpDelta() == 1 && clipDownDelta() == 0)
            || (voteValueAfter(clipId) == -1 && clipDownDelta() == 1 && clipUpDelta() == 0)
          ))
        ||
        // Vote WITHDRAWN: doc present before, absent after. The stored
        // value decides which counter is decremented.
        (exists(clipVoteRef(clipId)) && !existsAfter(clipVoteRef(clipId))
          && (
            (voteValueBefore(clipId) == 1 && clipUpDelta() == -1 && clipDownDelta() == 0)
            || (voteValueBefore(clipId) == -1 && clipDownDelta() == -1 && clipUpDelta() == 0)
          ))
        ||
        // Vote FLIPPED: the same voteId is deleted and re-created inside one
        // transaction — which Firestore coalesces into a single mutation on
        // the vote doc (see the clipVotes flip clause). Both counters move
        // by exactly one, in OPPOSITE directions, and which is which is
        // proven by the stored vs. post-write `value`.
        (exists(clipVoteRef(clipId)) && existsAfter(clipVoteRef(clipId))
          && (
            (voteValueBefore(clipId) == 1 && voteValueAfter(clipId) == -1
              && clipUpDelta() == -1 && clipDownDelta() == 1)
            || (voteValueBefore(clipId) == -1 && voteValueAfter(clipId) == 1
              && clipDownDelta() == -1 && clipUpDelta() == 1)
          ))
      );
    }
    // A clipVotes create must move the matching counter +1 in the same
    // write. Without this, a bare create followed by a paired delete
    // drains the tally: the delete still requires -1.
    function clipVoteCreateTallyOk() {
      return (
        (request.resource.data.value == 1
          && fsGetAfter('clips', request.resource.data.clipId).data.get('upvoteCount', 0)
             == fsGet('clips', request.resource.data.clipId).data.get('upvoteCount', 0) + 1
          && fsGetAfter('clips', request.resource.data.clipId).data.get('downvoteCount', 0)
             == fsGet('clips', request.resource.data.clipId).data.get('downvoteCount', 0))
        || (request.resource.data.value == -1
          && fsGetAfter('clips', request.resource.data.clipId).data.get('downvoteCount', 0)
             == fsGet('clips', request.resource.data.clipId).data.get('downvoteCount', 0) + 1
          && fsGetAfter('clips', request.resource.data.clipId).data.get('upvoteCount', 0)
             == fsGet('clips', request.resource.data.clipId).data.get('upvoteCount', 0))
      );
    }
    // Same shape for a dispute verdict: the matching tally goes +1 and the
    // other tally stays put. getAfter sees the dispute write in this commit.
    function disputeVoteCreateTallyOk() {
      return (
        (request.resource.data.verdict == 'land'
          && fsGetAfter('disputes', request.resource.data.disputeId).data.landVotes
             == fsGet('disputes', request.resource.data.disputeId).data.get('landVotes', 0) + 1
          && fsGetAfter('disputes', request.resource.data.disputeId).data.get('bailVotes', 0)
             == fsGet('disputes', request.resource.data.disputeId).data.get('bailVotes', 0))
        || (request.resource.data.verdict == 'bail'
          && fsGetAfter('disputes', request.resource.data.disputeId).data.bailVotes
             == fsGet('disputes', request.resource.data.disputeId).data.get('bailVotes', 0) + 1
          && fsGetAfter('disputes', request.resource.data.disputeId).data.get('landVotes', 0)
             == fsGet('disputes', request.resource.data.disputeId).data.get('landVotes', 0))
      );
    }

    // ── Stats are server-only (client fan-out lockdown) ──
    // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r5

    // ── turnHistory growth bounds ──
    // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r6
    function turnHistoryGrowthOk() {
      return (
        (!('turnHistory' in resource.data) && !('turnHistory' in request.resource.data))
        || (
          'turnHistory' in request.resource.data
          && request.resource.data.turnHistory is list
          && request.resource.data.turnHistory.size() <= 200
          && (
            // Cheap size-based checks FIRST so a growing/unchanged history
            // never reaches the O(n) full-list equality below — that compare
            // over a ~200-element array is the dominant node cost and, summed
            // across the OR-chain of game-update rules, can blow Firestore's
            // 1000-node per-evaluation budget (silent deny). Semantics are
            // unchanged: these clauses are OR'd, so order doesn't affect the
            // accepted set, only evaluation cost.
            //
            // Appended exactly one entry to an existing history array.
            ('turnHistory' in resource.data
              && request.resource.data.turnHistory.size() == resource.data.turnHistory.size() + 1)
            // Unchanged size against an existing history — same size is the
            // common no-append case (judge accept, setReview auto-clear, etc.).
            || ('turnHistory' in resource.data
                && request.resource.data.turnHistory.size() == resource.data.turnHistory.size()
                && request.resource.data.turnHistory == resource.data.turnHistory)
            // First-ever append: resource has no turnHistory yet, request
            // introduces a single-entry list.
            || (!('turnHistory' in resource.data)
                && request.resource.data.turnHistory.size() <= 1)
          )
        )
      );
    }

    // Same length, or both absent. A same-length rewrite is still denied by
    // turnHistoryGrowthOk, which compares the lists only after the sizes
    // match and skips that compare on an append. This helper must not walk
    // the list: a full compare on every game-update branch crosses
    // Firestore's 1000-expression cap (the forfeit write is the one that
    // pays for the branches ahead of it).
    function turnHistoryUnchanged() {
      return (!('turnHistory' in resource.data) && !('turnHistory' in request.resource.data))
        || ('turnHistory' in resource.data
            && 'turnHistory' in request.resource.data
            && resource.data.turnHistory is list
            && request.resource.data.turnHistory is list
            && request.resource.data.turnHistory.size() == resource.data.turnHistory.size());
    }

    // Unchanged history, including content, with the 200-entry ceiling.
    // One size-gated compare. Used where an append is not a legal outcome,
    // so the growth helper's +1 arm would be evaluated and then rejected.
    function turnHistoryFrozenOk() {
      return (!('turnHistory' in resource.data) && !('turnHistory' in request.resource.data))
        || ('turnHistory' in resource.data
            && 'turnHistory' in request.resource.data
            && resource.data.turnHistory is list
            && request.resource.data.turnHistory is list
            && request.resource.data.turnHistory.size() <= 200
            && request.resource.data.turnHistory.size() == resource.data.turnHistory.size()
            && request.resource.data.turnHistory == resource.data.turnHistory);
    }

    // The three fields stats close-out trusts, read off the one new entry.
    function appendedEntryAgrees(entry, landed, letterTo, matcherUid) {
      return entry.landed == landed
        && entry.letterTo == letterTo
        && entry.matcherUid == matcherUid;
    }

    function lastTurnAgrees(landed, letterTo, matcherUid) {
      return 'turnHistory' in request.resource.data
        && request.resource.data.turnHistory is list
        && request.resource.data.turnHistory.size() > 0
        && (
          !('turnHistory' in resource.data)
          || (resource.data.turnHistory is list
              && request.resource.data.turnHistory.size() == resource.data.turnHistory.size() + 1)
        )
        && appendedEntryAgrees(
          request.resource.data.turnHistory[request.resource.data.turnHistory.size() - 1],
          landed,
          letterTo,
          matcherUid
        );
    }

    // ── Users ──
    // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r7
    // ── Runtime feature testers ──
    // config/featureTesters { uids: [...] }. A listed uid may read it (the
    // client turns every VITE_FEATURE_* flag on); anyone else is denied, so
    // the list never leaks. Written only from the console / Admin SDK.
    match /config/featureTesters {
      // Testers read their own listing; admins read it for the feature
      // switches viewer (admin claim only, never pros).
      allow get: if isAdmin() || (request.auth != null
        && resource.data.uids is list
        && request.auth.uid in resource.data.uids);
      allow list, write: if false;
    }

    // ── Map flags (docs/MAP_ROADMAP.md Phase 1) ──
    // `publicBrowse: true` lets signed-out visitors read active public spots.
    // Admin SDK only; absent doc = signed-in only (the pre-Phase-1 behavior).
    match /config/mapFlags {
      allow get: if true;
      allow list, write: if false;
    }

    function mapPublicBrowse() {
      return fsExists('config', 'mapFlags') && fsGet('config', 'mapFlags').data.get('publicBrowse', false) == true;
    }

    // Spot fields only the Admin SDK (check-in callable, seed script) writes.
    function spotServerKeys() {
      return ['isLegendary', 'legendaryBadgeId', 'checkinCount', 'lastCheckinAt', 'source', 'osmId', 'kind', 'checkinsAllowed'];
    }

    // ── Map state (check-in anti-spoofing: last fix, hourly cap, strikes) ──
    match /mapState/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if false;
    }

    // ── Spot passport visibility (off unless the owner turns it on) ──
    match /passportSettings/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['public'])
        && request.resource.data.public is bool;
      allow delete: if isOwner(uid);
    }

    // ── Crew-only and private spots ──
    // Kept out of spots/ so a public map query can never surface them.
    // Readable by the owner, and by uids in crewUids when visibility is crew.
    match /privateSpots/{spotId} {
      function privateSpotShapeOk(d) {
        return d.keys().hasOnly(['createdBy', 'name', 'description', 'latitude', 'longitude', 'gnarRating',
            'bustRisk', 'obstacles', 'photoUrls', 'isVerified', 'isActive', 'visibility', 'crewUids',
            'createdAt', 'updatedAt'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 80
          && (d.get('description', null) == null || (d.description is string && d.description.size() <= 500))
          && d.latitude is number && d.latitude >= -90 && d.latitude <= 90
          && d.longitude is number && d.longitude >= -180 && d.longitude <= 180
          && d.gnarRating is int && d.gnarRating >= 1 && d.gnarRating <= 5
          && d.bustRisk is int && d.bustRisk >= 1 && d.bustRisk <= 5
          && d.obstacles is list && d.obstacles.size() <= 14
          && d.photoUrls is list && d.photoUrls.size() <= 5
          && d.visibility in ['crew', 'private']
          && d.crewUids is list && d.crewUids.size() <= 50;
      }
      allow read: if isSignedIn()
        && resource.data.isActive == true
        && (resource.data.createdBy == request.auth.uid
            || (resource.data.visibility == 'crew' && request.auth.uid in resource.data.crewUids));
      allow create: if isSignedIn()
        && notBanned()
        && request.auth.token.email_verified == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.isVerified == false
        && request.resource.data.isActive == true
        && privateSpotShapeOk(request.resource.data)
        && spotRateLimitOk();
      allow update: if isSignedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.latitude == resource.data.latitude
        && request.resource.data.longitude == resource.data.longitude
        && request.resource.data.isVerified == resource.data.isVerified
        && request.resource.data.isActive == resource.data.isActive
        && privateSpotShapeOk(request.resource.data);
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /users/{uid} {
      // Split read into get/list deliberately. `get` is public so a shared
      // `/player/{uid}` link resolves for a signed-OUT visitor — the link
      // already carries the uid, and this doc holds only fields that are
      // safe to expose (see the public/private split note above). `list`
      // stays signed-in: a public `read` would cover BOTH verbs and let an
      // anonymous client enumerate every account in the app. The only
      // production list queries are getPlayerDirectory / getLeaderboard in
      // src/services/users.ts, both of which run signed-in.
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isOwner(uid)
        // One profile per UID — prevent a race condition from overwriting an existing profile
        && !fsExists('users', uid)
        && request.resource.data.uid == uid
        // Absence is a deny, not an evaluation error. A present clock must
        // be request.time — a client cannot backdate the profile.
        && 'createdAt' in request.resource.data
        && request.resource.data.createdAt == request.time
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3  // USERNAME_MIN
        && request.resource.data.username.size() <= 20 // USERNAME_MAX
        // Enforce lowercase alphanumeric + underscore only (matches client-side normalisation)
        && request.resource.data.username.matches('[a-z0-9_]+') // USERNAME_RE body
        // ── Username reservation binding (uniqueness bypass guard) ──
        // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r8
        && fsGetAfter('usernames', request.resource.data.username).data.uid == uid
        // wins/losses must start at zero if present (prevents leaderboard inflation
        // by injecting arbitrary stats at profile creation time)
        && (!('wins' in request.resource.data) || request.resource.data.wins == 0)
        && (!('losses' in request.resource.data) || request.resource.data.losses == 0)
        // Tier-1 stat counters (server-written by applyGameStats) get the same
        // zero-seed treatment: a signup must not mint a streak or games-played
        // history for itself.
        && (!('gamesPlayed' in request.resource.data) || request.resource.data.gamesPlayed == 0)
        && (!('currentWinStreak' in request.resource.data) || request.resource.data.currentWinStreak == 0)
        && (!('bestWinStreak' in request.resource.data) || request.resource.data.bestWinStreak == 0)
        && (!('lettersGiven' in request.resource.data) || request.resource.data.lettersGiven == 0)
        && (!('lettersTaken' in request.resource.data) || request.resource.data.lettersTaken == 0)
        // Binding-dispute stat counters (server-written by the dispute referee)
        // get the same zero-seed treatment — a signup must not mint a dispute
        // history for itself. Written exclusively server-side; see the update
        // backstop below.
        && (!('tricksDisputed' in request.resource.data) || request.resource.data.tricksDisputed == 0)
        && (!('disputesRaised' in request.resource.data) || request.resource.data.disputesRaised == 0)
        && (!('disputesRight' in request.resource.data) || request.resource.data.disputesRight == 0)
        && (!('disputesWrong' in request.resource.data) || request.resource.data.disputesWrong == 0)
        // My Stats counters (server-written by the applyGameStats close-out via
        // Admin SDK) get the same zero-seed treatment. These lists are
        // allowlist-by-omission: a counter missing here is client-mintable at
        // signup, so every new field name MUST be added to both this block and
        // the update backstop below.
        && (!('cleanWins' in request.resource.data) || request.resource.data.cleanWins == 0)
        && (!('tricksLanded' in request.resource.data) || request.resource.data.tricksLanded == 0)
        && (!('tricksFailed' in request.resource.data) || request.resource.data.tricksFailed == 0)
        && (!('forfeitLosses' in request.resource.data) || request.resource.data.forfeitLosses == 0)
        && (!('comebackWins' in request.resource.data) || request.resource.data.comebackWins == 0)
        && (!('totalGameDurationMs' in request.resource.data) || request.resource.data.totalGameDurationMs == 0)
        // Divisor for the average-game-length tile: counts only the games whose
        // duration could actually be measured, so it must be as unforgeable as
        // the numerator it pairs with.
        && (!('gamesWithDuration' in request.resource.data) || request.resource.data.gamesWithDuration == 0)
        && (!('gamesJudged' in request.resource.data) || request.resource.data.gamesJudged == 0)
        && (!('turnsJudged' in request.resource.data) || request.resource.data.turnsJudged == 0)
        // XP counters are server-written. A signup that omits them is fine;
        // a signup that seeds a non-zero value is not. `level` may only start
        // at 1. `xpDay` and the clip-binding id stay absent.
        && (!('xp' in request.resource.data) || request.resource.data.xp == 0)
        && (!('level' in request.resource.data) || request.resource.data.level == 1)
        && !('xpDay' in request.resource.data)
        && (!('xpToday' in request.resource.data) || request.resource.data.xpToday == 0)
        && (!('uniqueOpponents' in request.resource.data) || request.resource.data.uniqueOpponents == 0)
        && (!('spotsPlayed' in request.resource.data) || request.resource.data.spotsPlayed == 0)
        && (!('gamesAtMySpots' in request.resource.data) || request.resource.data.gamesAtMySpots == 0)
        && (!('disputeVotesCast' in request.resource.data) || request.resource.data.disputeVotesCast == 0)
        && (!('clipsPosted' in request.resource.data) || request.resource.data.clipsPosted == 0)
        && !('clipsPostedClipId' in request.resource.data)
        // recentResults is a rolling "W"/"L" list (max 10), not a counter — the
        // zero-seed equivalent is an empty list.
        && (!('recentResults' in request.resource.data) || request.resource.data.recentResults == [])
        // Pro fields are admin-only — clients cannot set them at creation
        && !('banned' in request.resource.data)
        && !('isVerifiedPro' in request.resource.data)
        && !('verifiedBy' in request.resource.data)
        && !('verifiedAt' in request.resource.data)
        // Pro-authored profile fields: never at creation (no one is a pro yet)
        && !('proBio' in request.resource.data)
        && !('proSignatureTricks' in request.resource.data)
        && !('proTagline' in request.resource.data)
        && !('proHometown' in request.resource.data)
        && !('proSponsors' in request.resource.data)
        // Sensitive fields MUST live in users/{uid}/private/* instead of
        // the public profile doc. Strict on CREATE — no new doc may
        // introduce them. (Legacy docs are handled by the update rule below.)
        && !('email' in request.resource.data)
        && !('emailVerified' in request.resource.data)
        && !('dob' in request.resource.data)
        && !('parentalConsent' in request.resource.data)
        && !('fcmTokens' in request.resource.data)
        // Rate-limit cooldown anchors are server-managed: the only legitimate
        // writer is the best-effort `setDoc(…, { merge: true })` that fires
        // AFTER a successful game / spot create (see
        // src/services/games.ts and src/services/spots.ts). Seeding them at
        // profile-create time is pure attack surface — a stale value would
        // instantly satisfy the 30s cooldown the first time the user creates
        // a game or spot. Require the fields to be absent on create; the
        // update rule then pins any future write to serverTimestamp().
        && !('lastGameCreatedAt' in request.resource.data)
        && !('lastSpotCreatedAt' in request.resource.data)
        && !('lastClipCreatedAt' in request.resource.data)
        // ── profileImageUrl bucket + UID pinning on CREATE (Codex P1) ──
        // Same anti-phishing predicate as the update rule below: an avatar
        // URL set during initial profile creation MUST match the project
        // bucket + this user's UID, or be null/absent. Without this, a
        // malicious signup could persist an arbitrary external URL on the
        // first write and bypass the update-side guard entirely.
        && (
          !('profileImageUrl' in request.resource.data.keys())
          || request.resource.data.profileImageUrl == null
          || (
            request.resource.data.profileImageUrl is string
            && request.resource.data.profileImageUrl.matches(
              '^https://firebasestorage\\.googleapis\\.com/v0/b/' + FIREBASE_BUCKET() +
              '/o/users%2F' + uid + '%2Favatar\\.(webp|jpeg|png)(\\?.*)?$'
            )
          )
        )
        // ── bannerImageUrl bucket + UID pinning (profile banner) ──
        // Same anti-phishing pin as profileImageUrl, for users/{uid}/banner.webp.
        && (
          !('bannerImageUrl' in request.resource.data.keys())
          || request.resource.data.bannerImageUrl == null
          || (
            request.resource.data.bannerImageUrl is string
            && request.resource.data.bannerImageUrl.matches(
              '^https://firebasestorage\\.googleapis\\.com/v0/b/' + FIREBASE_BUCKET() +
              '/o/users%2F' + uid + '%2Fbanner\\.webp(\\?.*)?$'
            )
          )
        );
      allow update: if isOwner(uid)
        // ── Privileged-field self-modify guard (F2 — defense in depth) ──
        // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r9
        && !(request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['uid', 'username', 'createdAt',
                     'banned',
                     'isVerifiedPro', 'verifiedBy', 'verifiedAt',
                     'email', 'emailVerified', 'dob', 'parentalConsent',
                     'fcmTokens',
                     'wins', 'losses', 'lastStatsGameId',
                     'gamesPlayed', 'currentWinStreak', 'bestWinStreak',
                     'lettersGiven', 'lettersTaken',
                     'tricksDisputed', 'disputesRaised', 'disputesRight', 'disputesWrong',
                     'cleanWins', 'tricksLanded', 'tricksFailed', 'forfeitLosses',
                     'comebackWins', 'totalGameDurationMs', 'gamesWithDuration',
                     'recentResults', 'gamesJudged', 'turnsJudged',
                     'xp', 'level', 'xpDay', 'xpToday',
                     'uniqueOpponents', 'spotsPlayed', 'gamesAtMySpots',
                     'disputeVotesCast']))
        // clipsPosted is the one client-writable exception: exactly +1, and
        // only in the same write as a brand-new user-source clip whose
        // playerUid is the caller. clipsPostedClipId names that clip so the
        // rule can see it. Any other change to either field is denied.
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['clipsPosted', 'clipsPostedClipId'])
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasAll(['clipsPosted', 'clipsPostedClipId'])
            && request.resource.data.clipsPosted is int
            && request.resource.data.clipsPosted == resource.data.get('clipsPosted', 0) + 1
            && request.resource.data.clipsPostedClipId is string
            && request.resource.data.clipsPostedClipId.size() > 0
            && request.resource.data.clipsPostedClipId.size() <= 128
            && !fsExists('clips', request.resource.data.clipsPostedClipId)
            && fsGetAfter('clips', request.resource.data.clipsPostedClipId).data.source == 'user'
            && fsGetAfter('clips', request.resource.data.clipsPostedClipId).data.playerUid == request.auth.uid
            // A pending, rejected, or removed clip does not count. The
            // moderation function adds one when it approves, and takes one
            // back when that approval is undone.
            && fsGetAfter('clips', request.resource.data.clipsPostedClipId).data.moderationStatus == 'active'
            && !('moderation' in fsGetAfter('clips', request.resource.data.clipsPostedClipId).data)
          )
        )
        // Pro-authored fields: only an already-verified pro may write their
        // own bio (string <= 280) and signature tricks (list of <= 3 short
        // strings). Every other pro power stays server/admin-only.
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['proBio', 'proSignatureTricks', 'proTagline', 'proHometown', 'proSponsors'])
          || (
            resource.data.get('isVerifiedPro', false) == true
            && (!('proBio' in request.resource.data)
                || (request.resource.data.proBio is string
                    && request.resource.data.proBio.size() <= 280))
            && (!('proSignatureTricks' in request.resource.data)
                || (request.resource.data.proSignatureTricks is list
                    && request.resource.data.proSignatureTricks.size() <= 3
                    && (request.resource.data.proSignatureTricks.size() < 1
                        || (request.resource.data.proSignatureTricks[0] is string
                            && request.resource.data.proSignatureTricks[0].size() <= 40))
                    && (request.resource.data.proSignatureTricks.size() < 2
                        || (request.resource.data.proSignatureTricks[1] is string
                            && request.resource.data.proSignatureTricks[1].size() <= 40))
                    && (request.resource.data.proSignatureTricks.size() < 3
                        || (request.resource.data.proSignatureTricks[2] is string
                            && request.resource.data.proSignatureTricks[2].size() <= 40))))
            && (!('proTagline' in request.resource.data)
                || (request.resource.data.proTagline is string
                    && request.resource.data.proTagline.size() <= 80))
            && (!('proHometown' in request.resource.data)
                || (request.resource.data.proHometown is string
                    && request.resource.data.proHometown.size() <= 60))
            && (!('proSponsors' in request.resource.data)
                || (request.resource.data.proSponsors is list
                    && request.resource.data.proSponsors.size() <= 3
                    && (request.resource.data.proSponsors.size() < 1
                        || (request.resource.data.proSponsors[0] is string
                            && request.resource.data.proSponsors[0].size() <= 40))
                    && (request.resource.data.proSponsors.size() < 2
                        || (request.resource.data.proSponsors[1] is string
                            && request.resource.data.proSponsors[1].size() <= 40))
                    && (request.resource.data.proSponsors.size() < 3
                        || (request.resource.data.proSponsors[2] is string
                            && request.resource.data.proSponsors[2].size() <= 40))))
          )
        )
        // Cannot change username or uid after creation
        && request.resource.data.username == resource.data.username
        && request.resource.data.uid == resource.data.uid
        // Pro fields are admin-only — clients cannot modify them
        && (!('isVerifiedPro' in request.resource.data) || request.resource.data.isVerifiedPro == resource.data.isVerifiedPro)
        && (!('verifiedBy' in request.resource.data) || request.resource.data.verifiedBy == resource.data.verifiedBy)
        && (!('verifiedAt' in request.resource.data) || request.resource.data.verifiedAt == resource.data.verifiedAt)
        // Sensitive fields live in `users/{uid}/private/*` per the public/
        // private split and are forbidden on the public doc — strict on
        // update, mirroring the create rule above.
        && !('email' in request.resource.data)
        && !('emailVerified' in request.resource.data)
        && !('dob' in request.resource.data)
        && !('parentalConsent' in request.resource.data)
        && !('fcmTokens' in request.resource.data)
        // wins / losses / lastStatsGameId are NOT validated here — they are
        // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r10
        && (
          (!('lastGameCreatedAt' in request.resource.data)
            && !('lastGameCreatedAt' in resource.data))
          || ('lastGameCreatedAt' in resource.data
              && 'lastGameCreatedAt' in request.resource.data
              && request.resource.data.lastGameCreatedAt == resource.data.lastGameCreatedAt)
          || request.resource.data.lastGameCreatedAt == request.time
        )
        // lastSpotCreatedAt is the sibling 30s cooldown anchor for spot
        // creation (see /spots create rule). Exact same attack surface and
        // exact same three-branch guard — kept in lockstep with
        // lastGameCreatedAt above. The spot-create flow writes this via
        // `batch.set(…, { lastSpotCreatedAt: serverTimestamp() }, { merge: true })`
        // in the same batch as the spot (src/services/spots.ts createSpot);
        // the /spots create rule requires it via getAfter().
        && (
          (!('lastSpotCreatedAt' in request.resource.data)
            && !('lastSpotCreatedAt' in resource.data))
          || ('lastSpotCreatedAt' in resource.data
              && 'lastSpotCreatedAt' in request.resource.data
              && request.resource.data.lastSpotCreatedAt == resource.data.lastSpotCreatedAt)
          || request.resource.data.lastSpotCreatedAt == request.time
        )
        // lastSpotMessageAt is the 3s cooldown anchor for spot group messages
        // (see spots/{spotId}/messages create rule). Same attack surface and
        // same three-branch guard — kept in lockstep with lastGameCreatedAt
        // and lastSpotCreatedAt above. The spot-message flow writes this via
        // batch rules in the same write as the message; the message create
        // rule requires it via getAfter().
        && (
          (!('lastSpotMessageAt' in request.resource.data)
            && !('lastSpotMessageAt' in resource.data))
          || ('lastSpotMessageAt' in resource.data
              && 'lastSpotMessageAt' in request.resource.data
              && request.resource.data.lastSpotMessageAt == resource.data.lastSpotMessageAt)
          || request.resource.data.lastSpotMessageAt == request.time
        )
        // lastClipCreatedAt is the 30s cooldown anchor for user-uploaded
        // clip creation (see the /clips user-source create rule, which
        // getAfter()s this exact field). Identical three-branch guard to
        // the two anchors above: pinning the new value to request.time is
        // what stops a client from seeding epoch 0 and posting unlimited
        // clips.
        && (
          (!('lastClipCreatedAt' in request.resource.data)
            && !('lastClipCreatedAt' in resource.data))
          || ('lastClipCreatedAt' in resource.data
              && 'lastClipCreatedAt' in request.resource.data
              && request.resource.data.lastClipCreatedAt == resource.data.lastClipCreatedAt)
          || request.resource.data.lastClipCreatedAt == request.time
        )
        // ── profileImageUrl bucket + UID pinning (PR-B, audit S5+S12) ──
        // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r11
        && (
          !('profileImageUrl' in request.resource.data.keys())
          || request.resource.data.profileImageUrl == null
          || (
            request.resource.data.profileImageUrl is string
            && request.resource.data.profileImageUrl.matches(
              '^https://firebasestorage\\.googleapis\\.com/v0/b/' + FIREBASE_BUCKET() +
              '/o/users%2F' + uid + '%2Favatar\\.(webp|jpeg|png)(\\?.*)?$'
            )
          )
        )
        // ── bannerImageUrl bucket + UID pinning (profile banner) ──
        // Same anti-phishing pin as profileImageUrl, for users/{uid}/banner.webp.
        && (
          !('bannerImageUrl' in request.resource.data.keys())
          || request.resource.data.bannerImageUrl == null
          || (
            request.resource.data.bannerImageUrl is string
            && request.resource.data.bannerImageUrl.matches(
              '^https://firebasestorage\\.googleapis\\.com/v0/b/' + FIREBASE_BUCKET() +
              '/o/users%2F' + uid + '%2Fbanner\\.webp(\\?.*)?$'
            )
          )
        );
      // ── Verified-Pro grant / revoke (admin custom claim) ──
      // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r12
      allow update: if isAdmin()
        && uid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isVerifiedPro', 'verifiedBy', 'verifiedAt'])
        && request.resource.data.isVerifiedPro is bool
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.verifiedAt == request.time;
      // ── Ban flag mirror (admin custom claim) ──
      // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r13
      allow update: if isAdmin()
        && uid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned'])
        && request.resource.data.banned is bool;
      // NOTE: there is deliberately no peer-write branch. wins/losses were
      // once closed out by either participant (canPeerCloseStats); that
      // client fan-out corrupted counters and has been removed. Stats are
      // written exclusively by the applyGameStats Cloud Function (admin
      // SDK), so the only client `allow update` is the owner branch above,
      // and it can never touch wins/losses/lastStatsGameId.
      // Users may delete their own profile (account deletion flow)
      allow delete: if isOwner(uid);

      // ── Private profile (subcollection) ──
      // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r14
      match /private/{docId} {
        allow read: if isOwner(uid);

        // ── fcmTokens cap ──
        // Every push registration write goes here; cap at ≤10 entries
        // (one per device the user is currently signed into). String type
        // is not enforced individually because the FCM SDK opaquely wraps
        // them, but list shape is mandatory.
        function fcmTokensOk() {
          return !('fcmTokens' in request.resource.data)
            || (request.resource.data.fcmTokens is list
                && request.resource.data.fcmTokens.size() <= 10);
        }

        // ── Onboarding field shape validation ──
        // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r15
        function onboardingTutorialVersionOk() {
          return !('onboardingTutorialVersion' in request.resource.data)
            || request.resource.data.onboardingTutorialVersion == null
            || (request.resource.data.onboardingTutorialVersion is int
                && request.resource.data.onboardingTutorialVersion >= 0);
        }
        function onboardingCompletedAtOk() {
          return !('onboardingCompletedAt' in request.resource.data)
            || request.resource.data.onboardingCompletedAt == null
            || request.resource.data.onboardingCompletedAt == request.time
            || (request.resource.data.onboardingCompletedAt is timestamp
                && request.resource.data.onboardingCompletedAt <= request.time + duration.value(5, 's'));
        }
        function onboardingSkippedAtOk() {
          return !('onboardingSkippedAt' in request.resource.data)
            || request.resource.data.onboardingSkippedAt == null
            || request.resource.data.onboardingSkippedAt == request.time
            || (request.resource.data.onboardingSkippedAt is timestamp
                && request.resource.data.onboardingSkippedAt <= request.time + duration.value(5, 's'));
        }

        // Push opt-out toggle written by setPushEnabled
        // (src/services/pushPreferences.ts). Absent == enabled, so the field is
        // optional. The `is bool` pin keeps the STORED type unambiguous:
        // getPushEnabled coerces anything non-boolean to enabled
        // (`typeof value === "boolean" ? value : true`), so a client that wrote
        // the string "false" would read back as opted-IN while the Settings UI
        // believed otherwise — and any future reader without that fail-open
        // coercion would inherit the ambiguity.
        // Per-screen Hesher tips (src/services/tips.ts): ids of tip sets the
        // user has seen, plus the Settings "don't show tips" switch.
        function tipsOk() {
          return (!('tipsSeen' in request.resource.data)
              || (request.resource.data.tipsSeen is list
                  && request.resource.data.tipsSeen.size() <= 64))
            && (!('tipsDisabled' in request.resource.data)
              || request.resource.data.tipsDisabled is bool);
        }

        function pushEnabledOk() {
          return !('pushEnabled' in request.resource.data)
            || request.resource.data.pushEnabled is bool;
        }

        // Trick-training opt-in. Default is the field's absence (off).
        // Age (18+) is enforced in src/services/trainingConsent.ts — rules
        // cannot subtract 18 years from request.time.
        function trainingConsentStampOk(field) {
          return !(field in request.resource.data)
            || request.resource.data[field] == null
            || request.resource.data[field] == request.time
            || (request.resource.data[field] is timestamp
                && request.resource.data[field] <= request.time + duration.value(5, 's'));
        }
        function trainingConsentOk() {
          return (!('trainingConsentOptedIn' in request.resource.data)
              || request.resource.data.trainingConsentOptedIn is bool)
            && (!('trainingConsentPolicyVersion' in request.resource.data)
              || (request.resource.data.trainingConsentPolicyVersion is string
                  && request.resource.data.trainingConsentPolicyVersion.size() > 0
                  && request.resource.data.trainingConsentPolicyVersion.size() <= 32))
            && trainingConsentStampOk('trainingConsentUpdatedAt')
            && trainingConsentStampOk('trainingConsentRevokedAt')
            && trainingConsentStampOk('trainingConsentPromptSeenAt');
        }

        // ── Allowlist of accepted keys ──
        // Every key currently written to users/{uid}/private/profile by
        // the codebase. Keep in sync with UserPrivateProfile in
        // src/services/users.ts and the onboarding writers in
        // src/services/onboarding.ts. An unknown key here is a bug or an
        // attack — fail closed.
        function privateProfileKeysOk() {
          return request.resource.data.keys().hasOnly([
            'emailVerified',
            'dob',
            'parentalConsent',
            'fcmTokens',
            'onboardingTutorialVersion',
            'onboardingCompletedAt',
            'onboardingSkippedAt',
            'pushEnabled',
            'trainingConsentOptedIn',
            'trainingConsentPolicyVersion',
            'trainingConsentUpdatedAt',
            'trainingConsentRevokedAt',
            'trainingConsentPromptSeenAt',
            'tipsSeen',
            'tipsDisabled'
          ]);
        }

        allow create: if isOwner(uid)
          && privateProfileKeysOk()
          && fcmTokensOk()
          && onboardingTutorialVersionOk()
          && onboardingCompletedAtOk()
          && onboardingSkippedAtOk()
          && pushEnabledOk()
          && tipsOk()
          && trainingConsentOk();
        allow update: if isOwner(uid)
          && privateProfileKeysOk()
          && fcmTokensOk()
          && onboardingTutorialVersionOk()
          && onboardingCompletedAtOk()
          && onboardingSkippedAtOk()
          && pushEnabledOk()
          && tipsOk()
          && trainingConsentOk();
        allow delete: if isOwner(uid);
      }

      // ── Blocked Users (subcollection) ──
      // Each user maintains their own block list.  Only the owner can
      // create, read, or delete entries.  Blocking is bidirectional at
      // the application layer — game creation checks both directions.
      match /blocked_users/{blockedUid} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.blockedUid == blockedUid
          && request.resource.data.blockedUid is string
          // Cannot block yourself
          && blockedUid != uid;
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      // ── Achievements (subcollection) ──
      // Earned-achievement records. Grants are PRIVILEGED writes: either the
      // Admin SDK (server-side award pipeline, bypasses these rules) or an
      // operator holding the `admin: true` custom claim (console award).
      // Ordinary clients never mint or mutate them. The owner needs DELETE so
      // the account-deletion batch in src/services/users.ts (~345-353) can
      // wipe them atomically alongside /private + the parent user doc; under
      // default-deny that batch fails closed and breaks GDPR erasure.
      match /achievements/{achievementId} {
        // Badges are public reputation — any signed-in user renders them on
        // another skater's profile (/player/:uid).
        allow read: if isSignedIn();
        // Award shape is pinned exactly: no extra keys (a badge that carries
        // client-chosen fields becomes an unbounded write surface),
        // server-stamped earnedAt, bounded human-readable reason.
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['earnedAt', 'reason'])
          && request.resource.data.earnedAt == request.time
          && request.resource.data.reason is string
          && request.resource.data.reason.size() <= 200;
        // A badge is never edited — a wrong award is revoked and re-issued,
        // which keeps earnedAt honest.
        allow update: if false;
        // Owner: GDPR erasure batch. Admin: revoke a wrongly-awarded badge.
        allow delete: if isOwner(uid) || isAdmin();
      }

      // ── XP markers (opponent and spot first-seen flags) ──
      // Server-written. The owner can list and delete them so account erasure
      // still works. Clients cannot create or edit.
      match /xpMarkers/{markerId} {
        allow read: if isOwner(uid);
        allow create, update: if false;
        allow delete: if isOwner(uid);
      }

      // ── Spot passport (map check-ins) ──
      // Written only by the mapCheckin callable. Others see public-spot
      // stamps only when the owner turned passportSettings/{uid}.public on;
      // their query must filter scope == 'public'.
      match /passport/{stampId} {
        allow read: if isOwner(uid)
          || (isSignedIn()
              && resource.data.scope == 'public'
              && fsExists('passportSettings', uid)
              && fsGet('passportSettings', uid).data.public == true);
        allow create, update: if false;
        allow delete: if isOwner(uid);
      }

      // ── Check-in log (idempotency + audit). Callable-written. ──
      match /checkins/{checkinId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if false;
      }

      // ── Locker (subcollection) ──
      // Each doc is one owned closet copy. Copies are minted, moved by
      // trades and equipped only by the closet callables (Admin SDK, see
      // functions/src/closet/), which keep the copy, serials/{id} and the
      // Bucks ledger consistent in one transaction. A client-side write here
      // would desync the copy from its serial, so no client writes at all.
      // Deletable by the owner so the account-deletion batch stays atomic.
      match /locker/{copyId} {
        // Closet items are public reputation, shown on /player/:uid.
        allow read: if isSignedIn();
        // Closet copies are minted by the callables (Admin SDK). The one
        // client path kept from main is the admin award panel: exact shape,
        // bounded strings, server-stamped acquiredAt.
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(
               ['type', 'brand', 'name', 'imageUrl', 'rarity', 'acquiredAt', 'provenance'])
          && request.resource.data.type is string
          && request.resource.data.type.size() <= 100
          && request.resource.data.brand is string
          && request.resource.data.brand.size() <= 100
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.rarity is string
          && request.resource.data.rarity.size() <= 100
          && (request.resource.data.imageUrl == null || request.resource.data.imageUrl is string)
          && request.resource.data.acquiredAt == request.time
          && request.resource.data.provenance is map
          && request.resource.data.provenance.keys().hasOnly(['reason'])
          && request.resource.data.provenance.reason is string
          && request.resource.data.provenance.reason.size() <= 200;
        allow update: if false;
        // Owner: GDPR erasure batch. Admin: revoke wrongly-awarded gear.
        allow delete: if isOwner(uid) || isAdmin();
      }

      // ── Closet Bucks wallet + ledger (subcollections) ──
      // wallet/main holds balance, earnedBal and boughtBal; ledger/{txId} is
      // the append-only transaction log whose sum must equal the balance
      // (nightly audit). Only the closet callables write either, so a
      // client can never credit itself. Private to the owner: the balance
      // and spending history are hidden from profile visitors.
      // ── Customizable profile (VITE_FEATURE_PROFILE_CUSTOM) ──
      // users/{uid}/profileCustom/main. Public get (same as the profile
      // doc), owner-only write, fixed key set, caps on every field and a
      // host allowlist on every link (mirror: services/profileCustom.ts).
      match /profileCustom/{docId} {
        allow get: if true;
        allow list: if false;
        allow create, update: if isOwner(uid)
          && docId == 'main'
          && profileCustomValid(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // ── Closet Studio designs (VITE_FEATURE_CLOSET_STUDIO) ──
      // users/{uid}/closetDesigns/d0..d23 (24-slot cap). Owner reads all;
      // anyone may get a shared (moderated) design. Owner-only writes.
      match /closetDesigns/{designId} {
        allow get: if isOwner(uid) || resource.data.shared == true;
        allow list: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && designId.matches('^d([0-9]|1[0-9]|2[0-3])$')
          && closetDesignValid(request.resource.data, uid, designId);
        allow delete: if isOwner(uid);
      }

      match /wallet/{walletId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /ledger/{txId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // ── Admin audit log ──
    // Append-only record of admin console actions. Admin claim only, stamped
    // with the acting uid and server time; never edited or deleted.
    // Admin announcements (VITE_FEATURE_ADMIN_INSIGHTS). Any signed-in player
    // reads them for the in-app banner; only the admin claim posts or ends
    // one. Pros get nothing here. Push fan-out runs server-side
    // (announcementOnCreate), which also writes pushStatus/pushCount.
    match /announcements/{annId} {
      allow read: if request.auth != null;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'body', 'audience', 'push', 'active', 'createdBy', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 240
        && request.resource.data.audience in ['all', 'testers', 'pros']
        && request.resource.data.push is bool
        && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        && request.resource.data.active == false;
      allow delete: if false;
    }

    match /adminAudit/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['adminUid', 'action', 'targetId', 'detail', 'at'])
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 40
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() <= 128
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 300
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // ── Bans (moderation tombstones) ──
    // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r16
    match /bans/{uid} {
      // The subject may read their OWN ban so the client can explain why
      // a write was rejected. `list` is admin-only: a public listing would
      // be a roster of banned accounts (harassment + doxxing surface).
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      // Admin-only, and never against yourself — same four-eyes shape as
      // the Verified-Pro grant: a single compromised admin token must not
      // be able to ban a rival moderator's subject and then quietly clear
      // its own record.
      allow create: if isAdmin()
        && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['bannedBy', 'bannedAt', 'reason'])
        && request.resource.data.bannedBy == request.auth.uid
        && request.resource.data.bannedAt == request.time
        && (
          !('reason' in request.resource.data)
          || (request.resource.data.reason is string
              && request.resource.data.reason.size() <= 500)
        );

      // Immutable: a ban is never edited in place, so the bannedBy /
      // bannedAt audit trail can't be rewritten onto another moderator or
      // back-dated. Re-banning is delete + create, which re-stamps both.
      allow update: if false;

      // Unban. Admin-only and never self — the subject of a ban can never
      // reach this verb, which is the whole point of the collection.
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    // ── Usernames (reservation docs for uniqueness) ──
    // Same constraints as users/{uid}.username above — keep in sync with
    // USERNAME_MIN/MAX/RE in src/services/users.ts.
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && username.size() >= 3  // USERNAME_MIN
        && username.size() <= 20 // USERNAME_MAX
        // Reservation key must be a valid username (lowercase alphanum + underscore)
        && username.matches('[a-z0-9_]+'); // USERNAME_RE body
      // Cannot be updated; only the owning user can delete (account deletion flow)
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ── Helper: determine the opponent of a player ──
    function opponentUid(game, uid) {
      return uid == game.player1Uid ? game.player2Uid : game.player1Uid;
    }

    // ── Match-resolution turn-order seize guard (P0) ──
    // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r17
    function matchResolutionPinsOk(cur, nxt) {
      return (
        nxt.status == 'active' && nxt.winner == null && (
          // Missed — setter keeps the role, turnNumber +1, currentTurn pinned
          // to the (unchanged) currentSetter. Letters change on this arm, so a
          // landed claim (letters unchanged, roles swapped) cannot use it.
          (nxt.phase == 'setting'
           && nxt.currentSetter == cur.currentSetter
           && nxt.turnNumber == cur.turnNumber + 1
           && nxt.currentTurn == cur.currentSetter)
          // Honor system + landed — BINDING-DISPUTE FREEZE.
          // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r18
          || (nxt.phase == 'pendingReview'
              && nxt.reviewFor == opponentUid(cur, cur.currentSetter)
              && nxt.currentSetter == cur.currentSetter
              && nxt.currentTurn == cur.currentTurn
              && nxt.turnNumber == cur.turnNumber
              && nxt.p1Letters == cur.p1Letters
              && nxt.p2Letters == cur.p2Letters
              && nxt.turnHistory == cur.turnHistory
              && aboutTurnLengthAhead(nxt.reviewDeadline)
              && !judgeActive(cur))
          // Judge-active landed→disputable OR Call BS→setReview — letters
          // unchanged, currentSetter + turnNumber UNCHANGED, currentTurn → judge.
          || ((nxt.phase == 'disputable' || nxt.phase == 'setReview')
              && nxt.currentTurn == cur.judgeId
              && nxt.currentSetter == cur.currentSetter
              && nxt.turnNumber == cur.turnNumber
              && nxt.p1Letters == cur.p1Letters
              && nxt.p2Letters == cur.p2Letters
              && judgeActive(cur))
        )
      )
      // Completion: winner pinned to the opponent of the player who hit 5
      // letters; currentSetter + turnNumber UNCHANGED. currentTurn is NOT
      // pinned — no further game update is permitted once complete.
      || (nxt.status == 'complete'
          && nxt.winner != null
          && nxt.currentSetter == cur.currentSetter
          && nxt.turnNumber == cur.turnNumber
          && (
            (nxt.p1Letters >= 5 && nxt.winner == cur.player2Uid)
            || (nxt.p2Letters >= 5 && nxt.winner == cur.player1Uid)
          ));
    }

    // ── Expired-dispute auto-accept role/turn pins (audit HIGH: turn seize) ──
    // Auto-accept means the matcher's "landed" call stands and roles swap —
    // currentSetter rotates to the matcher (the setter's opponent), currentTurn
    // follows, turnNumber +1 (verified against turnForfeit.shared.ts's
    // disputeAccept branch and the honor-system-landed arm of
    // matchResolutionPinsOk). Without these pins either participant could seize
    // the setter role out of rotation in this same write.
    function autoAcceptRolePinsOk(cur, nxt) {
      return nxt.currentSetter == opponentUid(cur, cur.currentSetter)
        && nxt.currentTurn == nxt.currentSetter
        && nxt.turnNumber == cur.turnNumber + 1;
    }

    // ── statsApplied is server-only (stats fan-out lockdown) ──
    // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r19
    function statsAppliedUnchanged() {
      return (!('statsApplied' in resource.data) && !('statsApplied' in request.resource.data))
        || ('statsApplied' in resource.data && 'statsApplied' in request.resource.data
            && request.resource.data.statsApplied == resource.data.statsApplied);
    }

    // createdAt is request.time at create. Later writes leave it alone so a
    // client cannot backdate a profile, a game, or a report.
    function createdAtUnchanged() {
      return ('createdAt' in resource.data && 'createdAt' in request.resource.data
              && request.resource.data.createdAt == resource.data.createdAt)
        || (!('createdAt' in resource.data) && !('createdAt' in request.resource.data));
    }

    // ── Cron notification tombstones are server-only ──
    // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r20
    function cronNotifyTombstonesUnchanged() {
      return (
        (!('challengeNotifiedAt' in resource.data) && !('challengeNotifiedAt' in request.resource.data))
        || ('challengeNotifiedAt' in resource.data && 'challengeNotifiedAt' in request.resource.data
            && request.resource.data.challengeNotifiedAt == resource.data.challengeNotifiedAt)
      ) && (
        (!('turnReminderSentFor' in resource.data) && !('turnReminderSentFor' in request.resource.data))
        || ('turnReminderSentFor' in resource.data && 'turnReminderSentFor' in request.resource.data
            && request.resource.data.turnReminderSentFor == resource.data.turnReminderSentFor)
      );
    }

    // ── judgeUsername is bound at create, immutable on every update ──
    // The create rule binds judgeUsername to the judge's authoritative
    // users/{judgeId}.username (username-impersonation guard). Judge
    // assignment only ever happens at create — no update path legitimately
    // rewrites it (accept/decline flips only judgeStatus) — so every /games
    // update branch pins it to its stored value here. Presence-tolerant
    // (mirrors the judgeId pins) so honor-system games (judgeUsername null)
    // and any legacy doc that predates the field both pass. Reads no
    // documents — plain field comparison — so it adds negligible node cost.
    function judgeUsernameUnchanged() {
      return (!('judgeUsername' in resource.data) && !('judgeUsername' in request.resource.data))
        || ('judgeUsername' in resource.data && 'judgeUsername' in request.resource.data
            && request.resource.data.judgeUsername == resource.data.judgeUsername);
    }

    // ── player{1,2}IsVerifiedPro are bound at create, immutable on every update ──
    // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r21
    function verifiedProBadgesUnchanged() {
      return (
        (!('player1IsVerifiedPro' in resource.data) && !('player1IsVerifiedPro' in request.resource.data))
        || ('player1IsVerifiedPro' in resource.data && 'player1IsVerifiedPro' in request.resource.data
            && request.resource.data.player1IsVerifiedPro == resource.data.player1IsVerifiedPro)
      ) && (
        (!('player2IsVerifiedPro' in resource.data) && !('player2IsVerifiedPro' in request.resource.data))
        || ('player2IsVerifiedPro' in resource.data && 'player2IsVerifiedPro' in request.resource.data
            && request.resource.data.player2IsVerifiedPro == resource.data.player2IsVerifiedPro)
      );
    }

    // ── Trick picker fields (optional; absent on free-text and legacy docs) ──
    // Shape only. The catalog lives in src/constants/tricks.ts — listing every
    // id here would blow the 256KB rules cap. A slug that is not in the catalog
    // is still rejected by the client; rules reject the wrong types.
    function trickFieldsCleared() {
      return (!('currentTrickId' in request.resource.data) || request.resource.data.currentTrickId == null)
        && (!('currentTrickStance' in request.resource.data) || request.resource.data.currentTrickStance == null)
        && (!('currentTrickObstacle' in request.resource.data) || request.resource.data.currentTrickObstacle == null)
        && (!('currentTrickNameCustom' in request.resource.data) || request.resource.data.currentTrickNameCustom == null);
    }
    function trickFieldsShapeOk() {
      return trickFieldsCleared() || (
        request.resource.data.currentTrickId is string
        && request.resource.data.currentTrickId.size() > 0
        && request.resource.data.currentTrickId.size() <= 40
        && request.resource.data.currentTrickId.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && request.resource.data.currentTrickStance in ['regular', 'fakie', 'nollie', 'switch']
        && (
          !('currentTrickObstacle' in request.resource.data)
          || request.resource.data.currentTrickObstacle == null
          || request.resource.data.currentTrickObstacle in ['flat', 'ledge', 'rail', 'stairs', 'gap', 'bank', 'transition', 'manual-pad']
        )
        && (
          (request.resource.data.currentTrickId != 'other'
            && (!('currentTrickNameCustom' in request.resource.data) || request.resource.data.currentTrickNameCustom == null))
          || (request.resource.data.currentTrickId == 'other'
            && request.resource.data.currentTrickNameCustom is string
            && request.resource.data.currentTrickNameCustom.size() > 0
            && request.resource.data.currentTrickNameCustom.size() <= 64)
        )
      );
    }
    // Later update branches do not re-pin these four fields. A presence-pair
    // per field on every branch blows the 1000-expression budget on the
    // setReview auto-clear and expired-dispute auto-accept rules, which are
    // already at the ceiling. The setting write is what introduces them.
    // Client may raise the flag when a catalog turn resolves. Only the cron
    // (admin SDK) may clear it. Absent on legacy writes.
    function trainingLabelPendingOk() {
      return (!('trainingLabelPending' in resource.data) && !('trainingLabelPending' in request.resource.data))
        || ('trainingLabelPending' in request.resource.data && request.resource.data.trainingLabelPending == true)
        || ('trainingLabelPending' in resource.data && 'trainingLabelPending' in request.resource.data
            && request.resource.data.trainingLabelPending == resource.data.trainingLabelPending);
    }

    // One call for the pins every /games update shares. Inlined at each
    // branch they were re-evaluated once per allow-rule, and the late
    // auto-accept / setReview rules crossed the 1000-expression cap.
    function gameAuditTailOk() {
      return judgeUsernameUnchanged()
        && statsAppliedUnchanged()
        && createdAtUnchanged()
        && cronNotifyTombstonesUnchanged()
        && verifiedProBadgesUnchanged()
        && trainingLabelPendingOk()
        && turnLengthUnchanged();
    }

    // Turn length (src/services/turnDuration.ts): 24, 72 or 168 hours, chosen
    // at creation. Absent on legacy games and whenever VITE_FEATURE_TURN_LENGTH
    // is off, which reads as 24. Immutable: no update may add, change or drop it.
    function turnLengthUnchanged() {
      return request.resource.data.get('turnLengthHours', null) == resource.data.get('turnLengthHours', null);
    }

    // The game's turn length in hours. Read from the NEW doc: create sets it
    // and turnLengthUnchanged() pins it on every update, so it equals the
    // stored value on updates.
    function gameTurnHours() {
      return request.resource.data.get('turnLengthHours', 24);
    }

    // A turn clock (or the setter's accept/dispute window) is request.time +
    // the game's turn length, ±1h for client clock skew. Same reasoning as
    // aboutOneDayAhead: a shorter clock is an instant forfeit, a longer one
    // locks the opponent out of the forfeit path.
    function aboutTurnLengthAhead(ts) {
      return ts is timestamp
        && ts > request.time + duration.value(gameTurnHours() - 1, 'h')
        && ts < request.time + duration.value(gameTurnHours() + 1, 'h');
    }

    // Product window is 24h (TURN_DURATION_MS). ±1h absorbs client clock skew.
    // Used as-is for the community vote window, which stays 24h whatever the
    // game's turn length (voters are strangers, not the two players). Turn
    // clocks use aboutTurnLengthAhead above.
    // A shorter clock is an instant forfeit or an instant auto-accept; a longer
    // one locks the opponent out of the forfeit path.
    function aboutOneDayAhead(ts) {
      return ts is timestamp
        && ts > request.time + duration.value(23, 'h')
        && ts < request.time + duration.value(25, 'h');
    }

    // ── Spot presence ──
    // spotPresence/{spotId}/here/{uid} { uid, spotId, username, expiresAt,
    // updatedAt }. Written only by the mapPresence callable after a verified
    // check-in; it never holds a location, only "at this spot until".
    function presentAtSpot(spotId, uid) {
      return exists(/databases/$(database)/documents/spotPresence/$(spotId)/here/$(uid))
        && get(/databases/$(database)/documents/spotPresence/$(spotId)/here/$(uid)).data.expiresAt > request.time;
    }
    match /spotPresence/{spotId}/here/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── Online status ──
    // onlineStatus/{uid} { lastSeen, hidden }. Owner-written heartbeat; the
    // clock is the server's. Hidden means no lastSeen is stored at all.
    match /onlineStatus/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastSeen', 'hidden'])
        && request.resource.data.hidden is bool
        && ((request.resource.data.hidden == true && request.resource.data.lastSeen == null)
            || (request.resource.data.hidden == false && request.resource.data.lastSeen == request.time));
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Who's skating ──
    // skaterActivity/{uid} { uid, username, spotId, spotName, lastAt,
    // hereUntil, visible }. Written by the mapPresence callable; never holds
    // a location. Others can only read visible docs, so a skater who hid
    // their online status never shows up (the list query must ask for
    // visible == true). The owner may flip only `visible`, or delete it.
    match /skaterActivity/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || resource.data.visible == true);
      allow list: if isSignedIn() && resource.data.visible == true && request.query.limit <= 50;
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visible'])
        && request.resource.data.visible is bool;
      allow create: if false;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Games ──
    match /games/{gameId} {
      // Players AND the nominated judge can read the game document.
      allow read: if isSignedIn() && isParticipant(resource.data);

      // Any signed-in user with a verified email can create a game (as player1).
      // Email verification is enforced server-side here so it can't be bypassed
      // by calling the Firestore API directly (e.g. from the browser console).
      // Rate limit: user profile must have been updated > 30s ago (prevents spam creation).
      allow create: if isSignedIn()
        && request.auth.token.email_verified == true
        && request.resource.data.player1Uid == request.auth.uid
        // Prevent self-challenge: player2 must be a different account
        && request.resource.data.player2Uid != request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.p1Letters == 0
        && request.resource.data.p2Letters == 0
        && request.resource.data.turnNumber == 1
        && request.resource.data.winner == null
        // Challenger always has the first turn and sets first trick
        && request.resource.data.currentTurn == request.auth.uid
        && request.resource.data.phase == 'setting'
        && request.resource.data.currentSetter == request.auth.uid
        // Play clock is request.time + the turn length (24h default, ±1h). A one-second deadline lets
        // either player forfeit the opponent immediately; a year-9999 deadline
        // never expires. Forfeit still requires request.time past the stored clock.
        && aboutTurnLengthAhead(request.resource.data.turnDeadline)
        && request.resource.data.createdAt == request.time
        // Trick/video fields must start empty
        && request.resource.data.currentTrickName == null
        && request.resource.data.currentTrickVideoUrl == null
        && request.resource.data.matchVideoUrl == null
        && trickFieldsCleared()
        && (!('trainingLabelPending' in request.resource.data) || request.resource.data.trainingLabelPending == false)
        // Optional spotId must be a string if present (location context for
        // the challenge — clients validate UUID shape, rules enforce the
        // coarser type invariant).
        && (
          !('spotId' in request.resource.data)
          || (request.resource.data.spotId is string
              && request.resource.data.spotId.size() <= 64)
        )
        // Spot challenge (trainer-battle style): when the game says it was
        // made at a spot (spotPresence == true), both players must be
        // present there right now, per spotPresence/{spotId}/here/{uid},
        // which only the mapPresence callable writes.
        && (
          !('spotPresence' in request.resource.data)
          || request.resource.data.spotPresence == false
          || (request.resource.data.spotPresence == true
              && 'spotId' in request.resource.data
              && presentAtSpot(request.resource.data.spotId, request.auth.uid)
              && presentAtSpot(request.resource.data.spotId, request.resource.data.player2Uid))
        )
        // Optional trickCategory (game-level trick filter): absent, or exactly
        // one of the known values. Mirrors spotId — set once and immutable
        // thereafter (legacy clients omit it, so presence stays optional).
        // Optional turnLengthHours: absent (24h) or one of the three choices.
        && (
          !('turnLengthHours' in request.resource.data)
          || request.resource.data.turnLengthHours in [24, 72, 168]
        )
        && (
          !('trickCategory' in request.resource.data)
          || request.resource.data.trickCategory in ['any', 'flip', 'grind', 'gap', 'air', 'manual', 'oldschool',
                                                      'flatground', 'switch', 'flatbar', 'transition', 'team2v2', 'custom']
        )
        // Optional customRules (challenger free-text, only meaningful when
        // trickCategory == 'custom'): absent, null, or a bounded string. The
        // client sanitizes/caps at 120 chars; the rule enforces the coarser
        // type + length invariant. Immutable after creation like trickCategory.
        && (
          !('customRules' in request.resource.data)
          || request.resource.data.customRules == null
          || (request.resource.data.customRules is string
              && request.resource.data.customRules.size() <= 120)
        )
        // Judge fields must be present with correct shape. judgeId can be
        // null (honor system) or a non-player string UID. When judgeId is
        // set, judgeStatus must start as 'pending'. When null, judgeStatus
        // must also be null. This keeps invariants enforceable for updates.
        && (
          !('judgeId' in request.resource.data)
          || request.resource.data.judgeId == null
          || (request.resource.data.judgeId is string
              && request.resource.data.judgeId != request.auth.uid
              && request.resource.data.judgeId != request.resource.data.player2Uid)
        )
        && (
          !('judgeStatus' in request.resource.data)
          || (request.resource.data.judgeId == null && request.resource.data.judgeStatus == null)
          || (request.resource.data.judgeId != null && request.resource.data.judgeStatus == 'pending')
        )
        // ── Username impersonation guard (audit MEDIUM) ──
        // The denormalized username fields fan out into turnHistory, clips,
        // and disputes, so a create that stamps an arbitrary/victim handle
        // would let that handle masquerade across the app. Bind each to the
        // authoritative users/{uid}.username. player1Uid == auth.uid (pinned
        // above) so this get() reuses the already-fetched users/{auth.uid}
        // (+0 reads); player2 is one read; the judge one more when present —
        // well under the 10-document access ceiling for this rule.
        && request.resource.data.player1Username ==
             fsGet('users', request.auth.uid).data.username
        && request.resource.data.player2Username ==
             fsGet('users', request.resource.data.player2Uid).data.username
        // judgeUsername binds only when a judge is nominated; honor-system
        // games carry judgeId == null and store judgeUsername null (no get).
        && (
          !('judgeId' in request.resource.data)
          || request.resource.data.judgeId == null
          || request.resource.data.judgeUsername ==
               fsGet('users', request.resource.data.judgeId).data.username
        )
        // ── Verified Pro badge forgery guard ──
        // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r22
        && (
          !('player1IsVerifiedPro' in request.resource.data)
          || request.resource.data.player1IsVerifiedPro ==
               fsGet('users', request.auth.uid).data.get('isVerifiedPro', false)
        )
        && (
          !('player2IsVerifiedPro' in request.resource.data)
          || request.resource.data.player2IsVerifiedPro ==
               fsGet('users', request.resource.data.player2Uid).data.get('isVerifiedPro', false)
        )
        // Rate limit: at most one game creation per 30 seconds per user.
        // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r23
        && fsGetAfter('users', request.auth.uid).data.get('lastGameCreatedAt', null) == request.time
        && (
          !('lastGameCreatedAt' in fsGet('users', request.auth.uid).data)
          || request.time > fsGet('users', request.auth.uid).data.lastGameCreatedAt + duration.value(30, 's')
        )
        // Block check: neither player may have blocked the other.
        // Uses exists() against both directions of the blocked_users subcollection.
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked_users/$(request.resource.data.player2Uid))
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.player2Uid)/blocked_users/$(request.auth.uid))
        // statsApplied is server-only — a client that pre-seeds it at
        // creation would make applyGameStats skip crediting this game.
        && !('statsApplied' in request.resource.data)
        // Same posture for the cron's notification tombstones: seeding
        // challengeNotifiedAt here disarms the challenge backstop for a game
        // the opponent was never told about. See cronNotifyTombstonesUnchanged.
        && !('challengeNotifiedAt' in request.resource.data)
        && !('turnReminderSentFor' in request.resource.data);

      // Expired-window rules are first in this OR-chain. Their success
      // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r24
      allow update: if resource.data.phase == 'disputable'
        && resource.data.status == 'active'
        && request.time > resource.data.turnDeadline
        && request.resource.data.phase == 'setting'
        && request.resource.data.status == 'active'
        && request.resource.data.winner == null
        && isSignedIn()
        && isParticipant(resource.data)
        // Letters must not change (auto-accept = landed)
        && request.resource.data.p1Letters == resource.data.p1Letters
        && request.resource.data.p2Letters == resource.data.p2Letters
        // Cannot change player UIDs or usernames
        && request.resource.data.player1Uid == resource.data.player1Uid
        && request.resource.data.player2Uid == resource.data.player2Uid
        && request.resource.data.player1Username == resource.data.player1Username
        && request.resource.data.player2Username == resource.data.player2Username
        // spotId + judge immutable
        && (
          (!('spotId' in resource.data) && !('spotId' in request.resource.data))
          || ('spotId' in resource.data && 'spotId' in request.resource.data
              && request.resource.data.spotId == resource.data.spotId)
        )
        // trickCategory immutable (mirrors spotId)
        && (
          (!('trickCategory' in resource.data) && !('trickCategory' in request.resource.data))
          || ('trickCategory' in resource.data && 'trickCategory' in request.resource.data
              && request.resource.data.trickCategory == resource.data.trickCategory)
        )
        // customRules pairs with trickCategory: set at creation, immutable
        // thereafter (a mid-game rewrite of the agreed rules is not allowed).
        && (
          (!('customRules' in resource.data) && !('customRules' in request.resource.data))
          || ('customRules' in resource.data && 'customRules' in request.resource.data
              && request.resource.data.customRules == resource.data.customRules)
        )
        && request.resource.data.judgeId == resource.data.judgeId
        && request.resource.data.judgeStatus == resource.data.judgeStatus
        // Turn-order pins (audit HIGH: turn seize) — see autoAcceptRolePinsOk.
        // Without these either participant could seize the setter role out of
        // rotation in this same write.
        && autoAcceptRolePinsOk(resource.data, request.resource.data)
        // The next turn's clock is a fresh 24h, not whatever the client picks.
        && aboutTurnLengthAhead(request.resource.data.turnDeadline)
        // ── matchVideoUrl bucket pin (audit P2) ──
        // Auto-accept finalises the matcher's "landed" call without judge
        // intervention. The matcher's stored matchVideoUrl is now the canonical
        // record of the trick — without a bucket pin a participant could
        // overwrite it on this transition with an attacker-hosted payload
        // that the clip feed and dispute UI would render verbatim. Same
        // shape as the match-resolution + dispute branches above.
        && matchVideoUrlOk(request.resource.data.matchVideoUrl, resource.data.matchVideoUrl)
        // turnHistory growth bound — auto-accept writes a TurnRecord for
        // the expired dispute. Same 1-per-write + ≤200 ceiling.
        && turnHistoryGrowthOk()
        // Auto-accept stands the landed claim: no letter, matcher is the
        // setter's opponent. A miss entry here would invent a letter.
        && (
          turnHistoryUnchanged()
          || lastTurnAgrees(true, null, opponentUid(resource.data, resource.data.currentSetter))
        )
        && gameAuditTailOk();

      // ── Expired setReview auto-clear ──
      // When the judge doesn't rule on a "Call BS" within 24h, the set
      // stands (benefit of the doubt) and matcher is prompted to attempt.
      // Same early-out as auto-accept: phase, expiry, then the post-write
      // phase. A Call BS ruling that is not an expired clear fails here,
      // before the history compare.
      allow update: if resource.data.phase == 'setReview'
        && resource.data.status == 'active'
        && request.time > resource.data.turnDeadline
        && request.resource.data.phase == 'matching'
        && request.resource.data.status == 'active'
        && request.resource.data.winner == null
        && isSignedIn()
        && isParticipant(resource.data)
        && request.resource.data.p1Letters == resource.data.p1Letters
        && request.resource.data.p2Letters == resource.data.p2Letters
        && request.resource.data.player1Uid == resource.data.player1Uid
        && request.resource.data.player2Uid == resource.data.player2Uid
        && request.resource.data.player1Username == resource.data.player1Username
        && request.resource.data.player2Username == resource.data.player2Username
        && (
          (!('spotId' in resource.data) && !('spotId' in request.resource.data))
          || ('spotId' in resource.data && 'spotId' in request.resource.data
              && request.resource.data.spotId == resource.data.spotId)
        )
        && (
          (!('trickCategory' in resource.data) && !('trickCategory' in request.resource.data))
          || ('trickCategory' in resource.data && 'trickCategory' in request.resource.data
              && request.resource.data.trickCategory == resource.data.trickCategory)
        )
        // customRules pairs with trickCategory: set at creation, immutable
        // thereafter (a mid-game rewrite of the agreed rules is not allowed).
        && (
          (!('customRules' in resource.data) && !('customRules' in request.resource.data))
          || ('customRules' in resource.data && 'customRules' in request.resource.data
              && request.resource.data.customRules == resource.data.customRules)
        )
        && request.resource.data.judgeId == resource.data.judgeId
        && request.resource.data.judgeStatus == resource.data.judgeStatus
        && request.resource.data.currentSetter == resource.data.currentSetter
        && request.resource.data.currentTurn == opponentUid(resource.data, resource.data.currentSetter)
        && aboutTurnLengthAhead(request.resource.data.turnDeadline)
        // No append and no content rewrite. This path does not finish a turn.
        && turnHistoryFrozenOk()
        && gameAuditTailOk();

      // Current-turn player can make normal game updates.
      // Phase and the post-write status fail every other games update in
      // two compares, before isPlayer() and the field pins. A forfeit, an
      // auto-accept, and a match resolution used to walk this body on the
      // way to their own rule and cross the 1000-expression cap.
      allow update: if resource.data.phase == 'setting'
        && resource.data.status == 'active'
        && request.resource.data.status == 'active'
        && isSignedIn()
        && isPlayer(resource.data)
        && request.auth.uid == resource.data.currentTurn
        // Rate limit: at most one turn action per 2 seconds (prevents write flooding).
        // The cooldown below compares against the STORED updatedAt; without
        // also pinning the NEW updatedAt to request.time, a client could write
        // a stale value (e.g. epoch 0) and permanently satisfy the check.
        // Mirrors the same hardening on notification_limits / nudge_limits.
        && 'updatedAt' in request.resource.data
        && request.resource.data.updatedAt == request.time
        && (
          !('updatedAt' in resource.data)
          || resource.data.updatedAt == null
          || request.time > resource.data.updatedAt + duration.value(2, 's')
        )
        // Cannot change player UIDs or usernames
        && request.resource.data.player1Uid == resource.data.player1Uid
        && request.resource.data.player2Uid == resource.data.player2Uid
        && request.resource.data.player1Username == resource.data.player1Username
        && request.resource.data.player2Username == resource.data.player2Username
        // spotId is set at creation and immutable thereafter. Explicit `in`
        // checks here rather than .get(field, null) because the latter
        // throws "Null value error" in current Firestore rules engines.
        && (
          (!('spotId' in resource.data) && !('spotId' in request.resource.data))
          || ('spotId' in resource.data && 'spotId' in request.resource.data
              && request.resource.data.spotId == resource.data.spotId)
        )
        // trickCategory is set at creation and immutable thereafter (mirrors
        // spotId's presence-tolerant pin above).
        && (
          (!('trickCategory' in resource.data) && !('trickCategory' in request.resource.data))
          || ('trickCategory' in resource.data && 'trickCategory' in request.resource.data
              && request.resource.data.trickCategory == resource.data.trickCategory)
        )
        // customRules pairs with trickCategory: set at creation, immutable
        // thereafter (a mid-game rewrite of the agreed rules is not allowed).
        && (
          (!('customRules' in resource.data) && !('customRules' in request.resource.data))
          || ('customRules' in resource.data && 'customRules' in request.resource.data
              && request.resource.data.customRules == resource.data.customRules)
        )
        // Judge identity is immutable after creation. judgeStatus may only
        // change via dedicated accept/decline rules below.
        && (
          (!('judgeId' in resource.data) && !('judgeId' in request.resource.data))
          || ('judgeId' in resource.data && 'judgeId' in request.resource.data
              && request.resource.data.judgeId == resource.data.judgeId)
        )
        && (
          (!('judgeStatus' in resource.data) && !('judgeStatus' in request.resource.data))
          || ('judgeStatus' in resource.data && 'judgeStatus' in request.resource.data
              && request.resource.data.judgeStatus == resource.data.judgeStatus)
        )
        // currentTurn must always be one of the two players after the update
        && (
          request.resource.data.currentTurn == resource.data.player1Uid ||
          request.resource.data.currentTurn == resource.data.player2Uid
        )
        // New play clock on every setting-phase transition (set trick or fail-set).
        && aboutTurnLengthAhead(request.resource.data.turnDeadline)
        // Scores must not change during setting-phase updates.
        // Letters are only awarded via the match resolution rule below.
        && request.resource.data.p1Letters == resource.data.p1Letters
        && request.resource.data.p2Letters == resource.data.p2Letters
        // No winner on a setting update (completion is match resolution or forfeit).
        // status stays 'active' — already required above.
        && request.resource.data.winner == null
        // matchVideoUrl is only written by the matching-phase rule — setting
        // phase updates must not touch it. Without this pin, a setter whose
        // currentTurn == uid could stash a match video and then forge a
        // subsequent matching→setting forfeit/resolution against it.
        && request.resource.data.matchVideoUrl == resource.data.matchVideoUrl
        // Valid phase transitions only (prevents skipping phases). Each
        // branch pins the exact fields that MUST change and the ones that
        // MUST NOT — without these pins, the setter could rewrite
        // currentSetter / turnNumber / trick fields to forge a state where
        // the opponent's turnDeadline has already expired, and then invoke
        // the forfeit branch below to win unilaterally.
        && (
          // setting → matching (setter sets a trick)
          //   • currentSetter stays put (role doesn't change until the match resolves)
          //   • turn swaps to the matcher (opponent of the setter)
          //   • turnNumber is unchanged (phase change within the same turn)
          //   • currentTrickName / currentTrickVideoUrl are populated with the set trick
          (resource.data.phase == 'setting'
           && request.resource.data.phase == 'matching'
           && request.resource.data.currentSetter == resource.data.currentSetter
           && request.resource.data.currentTurn == opponentUid(resource.data, resource.data.currentSetter)
           && request.resource.data.turnNumber == resource.data.turnNumber
           && request.resource.data.currentTrickName is string
           && request.resource.data.currentTrickName.size() > 0
           && request.resource.data.currentTrickName.size() <= 64
           // Pin trick-video URL to THIS project's Firebase Storage bucket
           // only. The legacy regex accepted any `*.firebasestorage.app`
           // subdomain — which matches ATTACKER-PROJECT.firebasestorage.app
           // and lets a setter point currentTrickVideoUrl at another
           // project's storage (referrer/exfil, NSFW/malicious media in
           // the matcher recorder UI, content-spoof in the clip feed).
           // videoUrlBucketPinned() accepts both forms (getDownloadURL() and
           // the bucket-as-host CDN form). Mirrors the matchVideoUrl +
           // clips.videoUrl pins below.
           && videoUrlBucketPinned(request.resource.data.currentTrickVideoUrl)
           && trickFieldsShapeOk())
          // setting → setting (setter failed to land, turn passes to opponent)
          //   • currentSetter MUST flip to the other player (the whole point of
          //     failSetTrick is the role passes) — this is the invariant the
          //     exploit targets: without it, the setter could keep the role and
          //     merely reassign currentTurn to the opponent
          //   • currentTurn follows currentSetter (new setter sets first)
          //   • turnNumber strictly increments (fresh turn)
          //   • trick fields reset to null (no trick set yet this turn)
          || (resource.data.phase == 'setting'
              && request.resource.data.phase == 'setting'
              && request.resource.data.currentSetter == opponentUid(resource.data, resource.data.currentSetter)
              && request.resource.data.currentTurn == request.resource.data.currentSetter
              && request.resource.data.turnNumber == resource.data.turnNumber + 1
              && request.resource.data.currentTrickName == null
              && request.resource.data.currentTrickVideoUrl == null
              && trickFieldsCleared())
        )
        // turnHistory must not change during setting-phase updates
        && (
          (!('turnHistory' in resource.data) && !('turnHistory' in request.resource.data))
          || request.resource.data.turnHistory == resource.data.turnHistory
        )
        && gameAuditTailOk();

      // ── Match resolution (matcher submits an attempt) ──
      // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r25
      allow update: if resource.data.phase == 'matching'
        && resource.data.status == 'active'
        // Forfeit is not a match resolution. Fail it before the field pins
        // and the video-url check; the forfeit rule is later in this OR-chain
        // and the cumulative cost otherwise hits the 1000-expression cap.
        && (request.resource.data.status == 'active' || request.resource.data.status == 'complete')
        && isSignedIn()
        && isPlayer(resource.data)
        && request.auth.uid == resource.data.currentTurn
        // Rate limit. New updatedAt must equal request.time — prevents the
        // stored-value spoof where a client writes epoch 0 to keep the 2s
        // cooldown permanently satisfied. Same pattern as notification_limits.
        && 'updatedAt' in request.resource.data
        && request.resource.data.updatedAt == request.time
        && (
          !('updatedAt' in resource.data)
          || resource.data.updatedAt == null
          || request.time > resource.data.updatedAt + duration.value(2, 's')
        )
        // Cannot change player UIDs or usernames
        && request.resource.data.player1Uid == resource.data.player1Uid
        && request.resource.data.player2Uid == resource.data.player2Uid
        && request.resource.data.player1Username == resource.data.player1Username
        && request.resource.data.player2Username == resource.data.player2Username
        // spotId immutable
        && (
          (!('spotId' in resource.data) && !('spotId' in request.resource.data))
          || ('spotId' in resource.data && 'spotId' in request.resource.data
              && request.resource.data.spotId == resource.data.spotId)
        )
        // trickCategory immutable (mirrors spotId)
        && (
          (!('trickCategory' in resource.data) && !('trickCategory' in request.resource.data))
          || ('trickCategory' in resource.data && 'trickCategory' in request.resource.data
              && request.resource.data.trickCategory == resource.data.trickCategory)
        )
        // customRules pairs with trickCategory: set at creation, immutable
        // thereafter (a mid-game rewrite of the agreed rules is not allowed).
        && (
          (!('customRules' in resource.data) && !('customRules' in request.resource.data))
          || ('customRules' in resource.data && 'customRules' in request.resource.data
              && request.resource.data.customRules == resource.data.customRules)
        )
        // Judge identity + status immutable during match resolution
        && (
          (!('judgeId' in resource.data) && !('judgeId' in request.resource.data))
          || ('judgeId' in resource.data && 'judgeId' in request.resource.data
              && request.resource.data.judgeId == resource.data.judgeId)
        )
        && (
          (!('judgeStatus' in resource.data) && !('judgeStatus' in request.resource.data))
          || ('judgeStatus' in resource.data && 'judgeStatus' in request.resource.data
              && request.resource.data.judgeStatus == resource.data.judgeStatus)
        )
        // A continuing turn (miss, judge review) writes a fresh 24h clock.
        // Game over and nothing else may leave the stored clock alone — there
        // is no next turn to time. A one-second clock is denied on both arms.
        && (
          aboutTurnLengthAhead(request.resource.data.turnDeadline)
          || (request.resource.data.status == 'complete'
              && request.resource.data.turnDeadline == resource.data.turnDeadline)
        )
        // Letters: at most one player gains exactly one letter (missed) or none change (landed)
        && (
          // No letter change (landed path, both honor + judge)
          (request.resource.data.p1Letters == resource.data.p1Letters
           && request.resource.data.p2Letters == resource.data.p2Letters)
          // Missed — the MATCHER (== resource.data.currentTurn) takes exactly
          // one letter; the opponent's letters stay unchanged. The +1 is bound
          // to the current-turn player so a losing matcher cannot assign their
          // missed letter to the opponent and forge a win via the completion
          // branch below (audit CRITICAL: win forgery).
          || (resource.data.currentTurn == resource.data.player1Uid
              && request.resource.data.p1Letters == resource.data.p1Letters + 1
              && request.resource.data.p2Letters == resource.data.p2Letters)
          || (resource.data.currentTurn == resource.data.player2Uid
              && request.resource.data.p2Letters == resource.data.p2Letters + 1
              && request.resource.data.p1Letters == resource.data.p1Letters)
        )
        // ── matchVideoUrl bucket pin (audit P2) ──
        // The matcher writes their attempt video here. Without this pin a
        // matcher could stash an arbitrary HTTPS URL (or another project's
        // bucket) into matchVideoUrl, which then flows verbatim into the
        // dispute UI and the cross-game clip feed — referrer/exfil vector
        // and content-spoof surface. Accepted shapes mirror the
        // profileImageUrl pin above: unchanged, explicit null, or a string
        // matching the project bucket regex.
        && matchVideoUrlOk(request.resource.data.matchVideoUrl, resource.data.matchVideoUrl)
        // turnHistory growth bound — cap appends to 1 per write and total
        // size to 200 entries. Prevents a 1 MB TurnRecord balloon attack
        // against the Firestore doc-size ceiling. Evaluated BEFORE the seize
        // guard so its cheap size-based fast path runs while node budget is
        // plentiful (the O(n) full-list compare is gated behind a size check
        // and skipped on the append path — see turnHistoryGrowthOk).
        && turnHistoryGrowthOk()
        // A new entry on this branch is a miss: the matcher (currentTurn)
        // failed, so landed is false and the letter names that same uid.
        // No-letter writes (freeze, judge routing) may not append.
        && (
          turnHistoryUnchanged()
          || (
            (
              (resource.data.currentTurn == resource.data.player1Uid
               && request.resource.data.p1Letters == resource.data.p1Letters + 1)
              || (resource.data.currentTurn == resource.data.player2Uid
                  && request.resource.data.p2Letters == resource.data.p2Letters + 1)
            )
            && lastTurnAgrees(false, resource.data.currentTurn, resource.data.currentTurn)
          )
        )
        // ── Turn-order seize guard (P0) ──
        // Extracted to matchResolutionPinsOk() so this rule stays under
        // Firestore's per-evaluation node ceiling once main's #373 guard and
        // this PR's matchVideoUrl `.matches()` pin are both present. Accepted
        // set is unchanged — see the helper for the per-outcome rationale.
        && matchResolutionPinsOk(resource.data, request.resource.data)
        && gameAuditTailOk();

      // ── Pending-review resolution (honor-system binding dispute, Phase 2) ──
      // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r26
      allow update: if resource.data.phase == 'pendingReview'
        && resource.data.status == 'active'
        && isSignedIn()
        && isPlayer(resource.data)
        // Only the setter of the frozen turn may accept or dispute.
        && request.auth.uid == resource.data.currentSetter
        // Rate limit — new updatedAt pinned to request.time so a stale value
        // can't keep the 2s cooldown permanently satisfied (same pattern as
        // every other game-update branch).
        && 'updatedAt' in request.resource.data
        && request.resource.data.updatedAt == request.time
        && (
          !('updatedAt' in resource.data)
          || resource.data.updatedAt == null
          || request.time > resource.data.updatedAt + duration.value(2, 's')
        )
        // Identity immutable
        && request.resource.data.player1Uid == resource.data.player1Uid
        && request.resource.data.player2Uid == resource.data.player2Uid
        && request.resource.data.player1Username == resource.data.player1Username
        && request.resource.data.player2Username == resource.data.player2Username
        // spotId immutable
        && (
          (!('spotId' in resource.data) && !('spotId' in request.resource.data))
          || ('spotId' in resource.data && 'spotId' in request.resource.data
              && request.resource.data.spotId == resource.data.spotId)
        )
        // trickCategory immutable (mirrors spotId)
        && (
          (!('trickCategory' in resource.data) && !('trickCategory' in request.resource.data))
          || ('trickCategory' in resource.data && 'trickCategory' in request.resource.data
              && request.resource.data.trickCategory == resource.data.trickCategory)
        )
        // customRules immutable (pairs with trickCategory)
        && (
          (!('customRules' in resource.data) && !('customRules' in request.resource.data))
          || ('customRules' in resource.data && 'customRules' in request.resource.data
              && request.resource.data.customRules == resource.data.customRules)
        )
        // Judge identity/status immutable (honor-system games carry nulls)
        && (
          (!('judgeId' in resource.data) && !('judgeId' in request.resource.data))
          || ('judgeId' in resource.data && 'judgeId' in request.resource.data
              && request.resource.data.judgeId == resource.data.judgeId)
        )
        && (
          (!('judgeStatus' in resource.data) && !('judgeStatus' in request.resource.data))
          || ('judgeStatus' in resource.data && 'judgeStatus' in request.resource.data
              && request.resource.data.judgeStatus == resource.data.judgeStatus)
        )
        // The frozen claim's clip is canonical — matchVideoUrl stays bucket-
        // pinned (unchanged/null/project-bucket) across both moves.
        && matchVideoUrlOk(request.resource.data.matchVideoUrl, resource.data.matchVideoUrl)
        && request.resource.data.status == 'active'
        && request.resource.data.winner == null
        && (
          // (a) ACCEPT → setting: the deferred honor swap. Roles rotate to the
          // matcher (opponent of the current setter), currentTurn follows,
          // turnNumber +1, letters unchanged, review fields cleared, and a
          // fresh bounded turnDeadline governs the resumed turn. The single
          // appended landed TurnRecord is bounded by turnHistoryGrowthOk below.
          (request.resource.data.phase == 'setting'
            && request.resource.data.p1Letters == resource.data.p1Letters
            && request.resource.data.p2Letters == resource.data.p2Letters
            && request.resource.data.currentSetter == opponentUid(resource.data, resource.data.currentSetter)
            && request.resource.data.currentTurn == request.resource.data.currentSetter
            && request.resource.data.turnNumber == resource.data.turnNumber + 1
            && (!('reviewFor' in request.resource.data) || request.resource.data.reviewFor == null)
            && (!('reviewDeadline' in request.resource.data) || request.resource.data.reviewDeadline == null)
            && aboutTurnLengthAhead(request.resource.data.turnDeadline))
          ||
          // (b) DISPUTE → communityReview: the game STAYS frozen. Roles,
          // turnNumber, letters and turnHistory are all pinned unchanged;
          // reviewFor keeps naming the matcher; reviewDeadline is reset to a
          // fresh future vote window. turnDeadline is pinned unchanged (it is
          // NOT a play deadline while frozen — the phase gate, not the
          // deadline, keeps the forfeit sweep off this game).
          (request.resource.data.phase == 'communityReview'
            && request.resource.data.p1Letters == resource.data.p1Letters
            && request.resource.data.p2Letters == resource.data.p2Letters
            && request.resource.data.currentSetter == resource.data.currentSetter
            && request.resource.data.currentTurn == resource.data.currentTurn
            && request.resource.data.turnNumber == resource.data.turnNumber
            && request.resource.data.reviewFor == resource.data.reviewFor
            && request.resource.data.turnHistory == resource.data.turnHistory
            && request.resource.data.turnDeadline == resource.data.turnDeadline
            && aboutOneDayAhead(request.resource.data.reviewDeadline))
        )
        // turnHistory growth bound — accept appends exactly one landed record;
        // dispute leaves it unchanged (pinned above). Same +1 / ≤200 ceiling.
        && turnHistoryGrowthOk()
        // Accept may append one landed record for the matcher. A dispute
        // leaves history unchanged. A miss record on accept would forge a letter.
        && (
          turnHistoryUnchanged()
          || (request.resource.data.phase == 'setting'
              && lastTurnAgrees(true, null, opponentUid(resource.data, resource.data.currentSetter)))
        )
        && gameAuditTailOk();

      // ── Dispute resolution (judge rules on the matcher's "landed" claim) ──
      // Judge-only. The setter never self-judges — disputes only exist in
      // games with an active judge. Judge accepts (no letters, roles swap)
      // or overrules (matcher +1 letter, setter keeps setting).
      allow update: if resource.data.phase == 'disputable'
        && resource.data.status == 'active'
        && isSignedIn()
        && isJudge(resource.data)
        && request.auth.uid == resource.data.currentTurn
        && judgeActive(resource.data)
        // Rate limit. Pinning updatedAt to request.time closes the
        // stale-value bypass (see setting-phase rule above for rationale).
        && 'updatedAt' in request.resource.data
        && request.resource.data.updatedAt == request.time
        && (
          !('updatedAt' in resource.data)
          || resource.data.updatedAt == null
          || request.time > resource.data.updatedAt + duration.value(2, 's')
        )
        // Cannot change player UIDs or usernames
        && request.resource.data.player1Uid == resource.data.player1Uid
        && request.resource.data.player2Uid == resource.data.player2Uid
        && request.resource.data.player1Username == resource.data.player1Username
        && request.resource.data.player2Username == resource.data.player2Username
        // spotId immutable
        && (
          (!('spotId' in resource.data) && !('spotId' in request.resource.data))
          || ('spotId' in resource.data && 'spotId' in request.resource.data
              && request.resource.data.spotId == resource.data.spotId)
        )
        // trickCategory immutable (mirrors spotId)
        && (
          (!('trickCategory' in resource.data) && !('trickCategory' in request.resource.data))
          || ('trickCategory' in resource.data && 'trickCategory' in request.resource.data
              && request.resource.data.trickCategory == resource.data.trickCategory)
        )
        // customRules pairs with trickCategory: set at creation, immutable
        // thereafter (a mid-game rewrite of the agreed rules is not allowed).
        && (
          (!('customRules' in resource.data) && !('customRules' in request.resource.data))
          || ('customRules' in resource.data && 'customRules' in request.resource.data
              && request.resource.data.customRules == resource.data.customRules)
        )
        // Judge identity and status immutable during ruling
        && request.resource.data.judgeId == resource.data.judgeId
        && request.resource.data.judgeStatus == resource.data.judgeStatus
        // currentTurn must be one of the two players after the ruling
        && (
          request.resource.data.currentTurn == resource.data.player1Uid ||
          request.resource.data.currentTurn == resource.data.player2Uid
        )
        // Continuing play gets a fresh 24h clock. A ruling that ends the game
        // may leave the stored clock unchanged.
        && (
          aboutTurnLengthAhead(request.resource.data.turnDeadline)
          || (request.resource.data.status == 'complete'
              && request.resource.data.turnDeadline == resource.data.turnDeadline)
        )
        // Letters: accept (no change) or overrule (the disputed turn's MATCHER
        // takes exactly one letter). The matcher is always the setter's
        // opponent — pin the +1 to opponentUid(currentSetter) so a colluding
        // judge cannot pile letters onto a targeted player (audit HIGH).
        && (
          (request.resource.data.p1Letters == resource.data.p1Letters
           && request.resource.data.p2Letters == resource.data.p2Letters)
          || (opponentUid(resource.data, resource.data.currentSetter) == resource.data.player1Uid
              && request.resource.data.p1Letters == resource.data.p1Letters + 1
              && request.resource.data.p2Letters == resource.data.p2Letters)
          || (opponentUid(resource.data, resource.data.currentSetter) == resource.data.player2Uid
              && request.resource.data.p2Letters == resource.data.p2Letters + 1
              && request.resource.data.p1Letters == resource.data.p1Letters)
        )
        // ── matchVideoUrl bucket pin (audit P2) ──
        // Mirrors the match-resolution branch: dispute resolution can flip
        // matchVideoUrl to a freshly recorded clip, but only when the value
        // is pinned to this project's bucket. Without this, a judge ruling
        // could overwrite the matcher's stored URL with an attacker-hosted
        // payload (or the matcher's pre-rule write could survive into the
        // judge's flow). Accepted shapes: unchanged, null, or bucket regex.
        && matchVideoUrlOk(request.resource.data.matchVideoUrl, resource.data.matchVideoUrl)
        // Must resolve to setting (continue) or complete (game over).
        // Completion path pins winner direction (see match-resolution rule
        // for rationale) — judge-overruled dispute that pushes a player to
        // their 5th letter must record the OTHER player as winner.
        && (
          (request.resource.data.status == 'active'
           && request.resource.data.phase == 'setting'
           && request.resource.data.winner == null)
          || (request.resource.data.status == 'complete'
              && request.resource.data.winner != null
              && (
                (request.resource.data.p1Letters >= 5
                 && request.resource.data.winner == resource.data.player2Uid)
                || (request.resource.data.p2Letters >= 5
                    && request.resource.data.winner == resource.data.player1Uid)
              ))
        )
        // turnHistory growth bound — judge rulings append a single
        // TurnRecord with judgedBy set. Same 1-per-write + ≤200 ceiling
        // the match-resolution branch enforces.
        && turnHistoryGrowthOk()
        // Accept (no letter) appends a land. Overrule appends a miss naming
        // the matcher, and only when that matcher actually took the letter.
        && (
          turnHistoryUnchanged()
          || (
            request.resource.data.p1Letters == resource.data.p1Letters
            && request.resource.data.p2Letters == resource.data.p2Letters
            && lastTurnAgrees(true, null, opponentUid(resource.data, resource.data.currentSetter))
          )
          || (
            lastTurnAgrees(false, opponentUid(resource.data, resource.data.currentSetter), opponentUid(resource.data, resource.data.currentSetter))
            && (
              (opponentUid(resource.data, resource.data.currentSetter) == resource.data.player1Uid
               && request.resource.data.p1Letters == resource.data.p1Letters + 1)
              || (opponentUid(resource.data, resource.data.currentSetter) == resource.data.player2Uid
                  && request.resource.data.p2Letters == resource.data.p2Letters + 1)
            )
          )
        )
        && gameAuditTailOk();

      // ── Call BS resolution (judge rules on set trick in setReview phase) ──
      // Judge-only. Clean → back to matching (matcher must attempt).
      // Sketchy → back to setting (same setter re-sets, trick fields cleared).
      // No letter changes, no game completion.
      allow update: if resource.data.phase == 'setReview'
        && resource.data.status == 'active'
        && isSignedIn()
        && isJudge(resource.data)
        && request.auth.uid == resource.data.currentTurn
        && judgeActive(resource.data)
        // Rate limit. New updatedAt must equal request.time so the 2s
        // cooldown can't be defeated by writing a stale value on each turn.
        && 'updatedAt' in request.resource.data
        && request.resource.data.updatedAt == request.time
        && (
          !('updatedAt' in resource.data)
          || resource.data.updatedAt == null
          || request.time > resource.data.updatedAt + duration.value(2, 's')
        )
        && request.resource.data.player1Uid == resource.data.player1Uid
        && request.resource.data.player2Uid == resource.data.player2Uid
        && request.resource.data.player1Username == resource.data.player1Username
        && request.resource.data.player2Username == resource.data.player2Username
        && (
          (!('spotId' in resource.data) && !('spotId' in request.resource.data))
          || ('spotId' in resource.data && 'spotId' in request.resource.data
              && request.resource.data.spotId == resource.data.spotId)
        )
        && (
          (!('trickCategory' in resource.data) && !('trickCategory' in request.resource.data))
          || ('trickCategory' in resource.data && 'trickCategory' in request.resource.data
              && request.resource.data.trickCategory == resource.data.trickCategory)
        )
        // customRules pairs with trickCategory: set at creation, immutable
        // thereafter (a mid-game rewrite of the agreed rules is not allowed).
        && (
          (!('customRules' in resource.data) && !('customRules' in request.resource.data))
          || ('customRules' in resource.data && 'customRules' in request.resource.data
              && request.resource.data.customRules == resource.data.customRules)
        )
        && request.resource.data.judgeId == resource.data.judgeId
        && request.resource.data.judgeStatus == resource.data.judgeStatus
        && request.resource.data.status == 'active'
        && request.resource.data.winner == null
        && aboutTurnLengthAhead(request.resource.data.turnDeadline)
        && request.resource.data.p1Letters == resource.data.p1Letters
        && request.resource.data.p2Letters == resource.data.p2Letters
        && request.resource.data.currentSetter == resource.data.currentSetter
        // Clean: back to matching with matcher's turn.
        // Sketchy: back to setting with same setter re-setting.
        && (
          (request.resource.data.phase == 'matching'
           && request.resource.data.currentTurn == opponentUid(resource.data, resource.data.currentSetter))
          || (request.resource.data.phase == 'setting'
              && request.resource.data.currentTurn == resource.data.currentSetter
              && request.resource.data.currentTrickName == null
              && request.resource.data.currentTrickVideoUrl == null
              && trickFieldsCleared())
        )
        // No append and no content rewrite. Call BS does not finish a turn,
        // so the growth helper's +1 arm is not a legal outcome here.
        && turnHistoryFrozenOk()
        && gameAuditTailOk();

      // ── Judge invite accept / decline ──
      // Only the nominated judge can flip their status from pending. No
      // other field may change on the same write.
      allow update: if 'judgeStatus' in resource.data
        && resource.data.judgeStatus == 'pending'
        && resource.data.status == 'active'
        && isSignedIn()
        && isJudge(resource.data)
        && request.resource.data.judgeId == resource.data.judgeId
        // Re-verify judge isn't either player — defence-in-depth in case the
        // create-time check was bypassed (e.g. older docs written before the
        // check was added). Without this an account that is somehow set as
        // both player and judge could accept their own dispute.
        && resource.data.judgeId != resource.data.player1Uid
        && resource.data.judgeId != resource.data.player2Uid
        && (request.resource.data.judgeStatus == 'accepted'
            || request.resource.data.judgeStatus == 'declined')
        // Everything else must stay identical.
        && request.resource.data.player1Uid == resource.data.player1Uid
        && request.resource.data.player2Uid == resource.data.player2Uid
        && request.resource.data.player1Username == resource.data.player1Username
        && request.resource.data.player2Username == resource.data.player2Username
        && request.resource.data.status == resource.data.status
        && request.resource.data.phase == resource.data.phase
        && request.resource.data.currentTurn == resource.data.currentTurn
        && request.resource.data.currentSetter == resource.data.currentSetter
        && request.resource.data.p1Letters == resource.data.p1Letters
        && request.resource.data.p2Letters == resource.data.p2Letters
        && request.resource.data.winner == resource.data.winner
        && request.resource.data.turnNumber == resource.data.turnNumber
        && request.resource.data.turnDeadline == resource.data.turnDeadline
        && (
          (!('turnHistory' in resource.data) && !('turnHistory' in request.resource.data))
          || request.resource.data.turnHistory == resource.data.turnHistory
        )
        // trickCategory is immutable after creation — accepting/declining an
        // invite must not let the judge rewrite the game's trick filter.
        && (
          (!('trickCategory' in resource.data) && !('trickCategory' in request.resource.data))
          || ('trickCategory' in resource.data && 'trickCategory' in request.resource.data
              && request.resource.data.trickCategory == resource.data.trickCategory)
        )
        // customRules pairs with trickCategory: set at creation, immutable
        // thereafter (a mid-game rewrite of the agreed rules is not allowed).
        && (
          (!('customRules' in resource.data) && !('customRules' in request.resource.data))
          || ('customRules' in resource.data && 'customRules' in request.resource.data
              && request.resource.data.customRules == resource.data.customRules)
        )
        && gameAuditTailOk();

      // Either player can forfeit the current-turn player's expired turn
      // Winner must be the opponent of the player whose turn it is
      allow update: if request.resource.data.status == 'forfeit'
        && resource.data.status == 'active'
        // Only forfeit from setting or matching (disputable auto-accepts,
        // setReview auto-clears to matching — neither is a forfeit path).
        && (resource.data.phase == 'setting' || resource.data.phase == 'matching')
        && isSignedIn()
        && isPlayer(resource.data)
        // The stored clock must have actually expired. Writes pin that clock to
        // ~24h, so this cannot fire a second after a phase change. The forfeit
        // itself must not rewrite the clock it is claiming has expired.
        && request.time > resource.data.turnDeadline
        && request.resource.data.turnDeadline == resource.data.turnDeadline
        // Cannot change player UIDs, usernames, or letters
        && request.resource.data.player1Uid == resource.data.player1Uid
        && request.resource.data.player2Uid == resource.data.player2Uid
        && request.resource.data.player1Username == resource.data.player1Username
        && request.resource.data.player2Username == resource.data.player2Username
        && request.resource.data.p1Letters == resource.data.p1Letters
        && request.resource.data.p2Letters == resource.data.p2Letters
        // spotId is immutable after creation — a forfeit must not change it.
        && (
          (!('spotId' in resource.data) && !('spotId' in request.resource.data))
          || ('spotId' in resource.data && 'spotId' in request.resource.data
              && request.resource.data.spotId == resource.data.spotId)
        )
        // trickCategory is immutable after creation — a forfeit must not change it.
        && (
          (!('trickCategory' in resource.data) && !('trickCategory' in request.resource.data))
          || ('trickCategory' in resource.data && 'trickCategory' in request.resource.data
              && request.resource.data.trickCategory == resource.data.trickCategory)
        )
        // customRules pairs with trickCategory: set at creation, immutable
        // thereafter (a mid-game rewrite of the agreed rules is not allowed).
        && (
          (!('customRules' in resource.data) && !('customRules' in request.resource.data))
          || ('customRules' in resource.data && 'customRules' in request.resource.data
              && request.resource.data.customRules == resource.data.customRules)
        )
        // Winner must be the opponent of the current-turn player (who timed out)
        && request.resource.data.winner == opponentUid(resource.data, resource.data.currentTurn)
        // turnHistory may append exactly ONE closing TurnRecord so consumers
        // walking history can render the "how it ended" frame on a forfeit.
        // Same +1 / ≤200 ceiling every other growth-capable branch uses; the
        // helper also accepts the "unchanged" shape for callers that don't
        // append (forward-compat).
        && turnHistoryGrowthOk()
        // The closing entry records the timed-out player taking the letter.
        // matcherUid stays the setter's opponent, matching the forfeit writer.
        && (
          turnHistoryUnchanged()
          || lastTurnAgrees(false, resource.data.currentTurn, opponentUid(resource.data, resource.data.currentSetter))
        )
        && gameAuditTailOk();


      // A finished game stays until close-out has set statsApplied. Deleting
      // it first drops the loss. Account deletion uses the Admin SDK, which
      // bypasses this rule.
      allow delete: if isSignedIn() && isPlayer(resource.data)
        && resource.data.status != "active"
        && resource.data.statsApplied == true;
    }

    // ── Spots ──
    // User-contributed skate spots. The map feature lives entirely on
    // Firestore per charter 2.2 ("no custom backend — Firebase rules are
    // the authorization layer"). Spots are world-readable for any signed-
    // in user; only email-verified users can create them; creators can
    // only update their own spots and cannot change immutable fields
    // (coordinates, createdBy, isVerified, isActive) after creation.
    match /spots/{spotId} {
      // Active spots: signed-in, or anyone when config/mapFlags.publicBrowse is on.
      // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r27
      allow read: if resource.data.isActive == true && (isSignedIn() || mapPublicBrowse());

      // Create: signed-in + email-verified, owner-stamped, with full
      // field validation mirroring the shared Spot type. Rate-limited
      // via users/{uid}.lastSpotCreatedAt (30s cooldown), same pattern
      // as game creation above.
      allow create: if isSignedIn()
        && notBanned()
        && request.auth.token.email_verified == true
        && request.resource.data.createdBy == request.auth.uid
        // name: 1–80 chars
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        // description: optional, ≤500 chars
        && (
          request.resource.data.description == null
          || (request.resource.data.description is string
              && request.resource.data.description.size() <= 500)
        )
        // latitude/longitude: finite numbers in WGS84 range
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        // ratings: integer 1–5
        && request.resource.data.gnarRating is int
        && request.resource.data.gnarRating >= 1
        && request.resource.data.gnarRating <= 5
        && request.resource.data.bustRisk is int
        && request.resource.data.bustRisk >= 1
        && request.resource.data.bustRisk <= 5
        // obstacles: list, ≤14 items (one per obstacle type)
        && request.resource.data.obstacles is list
        && request.resource.data.obstacles.size() <= 14
        // photoUrls: list, max 5
        && request.resource.data.photoUrls is list
        && request.resource.data.photoUrls.size() <= 5
        // Verified and active flags: clients cannot self-verify; active
        // must start true (soft-delete is an update, not a create).
        && request.resource.data.isVerified == false
        && request.resource.data.isActive == true
        // Map fields (legendary, check-in counts, OSM source) are server-only.
        && !request.resource.data.keys().hasAny(spotServerKeys())
        // Rate limit: at most one spot creation per 30 seconds per user.
        // Same idiom as clipRateLimitOk(): the batch MUST advance
        // users/{uid}.lastSpotCreatedAt to request.time (getAfter), so a
        // client that omits the anchor write can no longer skip the cooldown.
        && spotRateLimitOk();

      // Update: owner-only, and coordinates + ownership + verification +
      // active flag are immutable after creation (soft-delete goes through
      // a separate admin flow, not covered here).
      allow update: if isSignedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.latitude == resource.data.latitude
        && request.resource.data.longitude == resource.data.longitude
        && request.resource.data.isVerified == resource.data.isVerified
        && request.resource.data.isActive == resource.data.isActive
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(spotServerKeys())
        // Mutable fields still get type-checked.
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && (
          request.resource.data.description == null
          || (request.resource.data.description is string
              && request.resource.data.description.size() <= 500)
        )
        // Re-apply the same validation block that `create` uses for the
        // remaining mutable fields. Without this, an owner could submit
        // out-of-range ratings, oversized obstacle/photo lists, or wrong
        // types via a direct API call and bypass the create-time guards.
        && request.resource.data.gnarRating is int
        && request.resource.data.gnarRating >= 1
        && request.resource.data.gnarRating <= 5
        && request.resource.data.bustRisk is int
        && request.resource.data.bustRisk >= 1
        && request.resource.data.bustRisk <= 5
        && request.resource.data.obstacles is list
        && request.resource.data.obstacles.size() <= 14
        && request.resource.data.photoUrls is list
        && request.resource.data.photoUrls.size() <= 5;

      // Delete: owner only. (Prefer soft-delete via admin in practice.)
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      // ── Spot comments (subcollection) ──
      match /comments/{commentId} {
        allow read: if isSignedIn();

        allow create: if isSignedIn()
          && notBanned()
          && request.auth.token.email_verified == true
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.content is string
          && request.resource.data.content.size() >= 1
          && request.resource.data.content.size() <= 300
          // Optional display handle (older comments have none). When sent it
          // must be the author's real username, same as clip comments (H1).
          && (
            !('username' in request.resource.data)
            || request.resource.data.username == fsGet('users', request.auth.uid).data.username
          );

        // Comments are immutable once posted. The author may delete their
        // own; an admin may delete any, which is the moderation takedown for
        // a reported spot comment (App Review 1.2).
        allow update: if false;
        allow delete: if isSignedIn()
          && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // ── Nudges ──
    // A nudge is a push-notification poke sent to an idle opponent.
    match /nudges/{nudgeId} {
      allow create: if isSignedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.gameId is string
        && request.resource.data.senderUsername is string
        // Sender must be a player in the game, recipient must be the other player
        && (
          (request.auth.uid == fsGet('games', request.resource.data.gameId).data.player1Uid
           && request.resource.data.recipientUid == fsGet('games', request.resource.data.gameId).data.player2Uid)
          ||
          (request.auth.uid == fsGet('games', request.resource.data.gameId).data.player2Uid
           && request.resource.data.recipientUid == fsGet('games', request.resource.data.gameId).data.player1Uid)
        )
        // Only nudge active games
        && fsGet('games', request.resource.data.gameId).data.status == 'active'
        // Companion-write requirement (May 2026 H1 hardening): in the same
        // batch the sender MUST also write nudge_limits/{senderUid_gameId}
        // with lastNudgedAt pinned to request.time. Without this, the client
        // could write /nudges and skip the rate-limit doc — defeating the
        // 1-hour cooldown server-side. getAfter() reflects the post-batch
        // state, so a missing limit write means the doc isn't there and
        // the rule rejects. Mirrors the /reports pattern (H-R2).
        && fsGetAfter('nudge_limits', request.auth.uid + '_' + request.resource.data.gameId).data.lastNudgedAt == request.time;

      // Immutable. (The old `delivered` flag was vestigial — it was to be
      // flipped by an onNudgeCreated Cloud Function that no longer exists.
      // The client no longer writes it and creates no longer require it;
      // there is no key allowlist here, so old clients still sending
      // `delivered` continue to pass.) Nudge delivery is observable via the
      // recipient's /nudges listener and the /push_dispatch queue instead.
      allow update: if false;

      // Sender or recipient can read nudges
      allow read: if isSignedIn()
        && (resource.data.senderUid == request.auth.uid
            || resource.data.recipientUid == request.auth.uid);

      allow delete: if false;
    }

    // ── Billing alerts (server-only) ──
    // Historically written by the onBillingAlert Cloud Function (removed).
    // No client access; retained so any future external consumer writing
    // here (via Admin SDK) stays locked down to clients.
    match /billingAlerts/{alertId} {
      allow read, write: if false;
    }

    // ── Notifications (in-app alerts for game events) ──
    // Written by the client when a game action occurs (e.g. your turn, challenge).
    // Only the recipient can read their own notifications.
    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        // 'nudge' (Aug 2026): nudges previously toasted only and left no bell
        // entry. The sender now also writes a persistent notification doc via
        // the standard Path A companion-write below.
        && request.resource.data.type in ['your_turn', 'new_challenge', 'game_won', 'game_lost', 'judge_invite', 'nudge']
        // Key allowlist scoped to the newest type only. The legacy types have
        // shipped for months without one and old clients may still carry extra
        // fields; tightening them retroactively would break live writes. New
        // types start closed.
        && (
          request.resource.data.type != 'nudge'
          || request.resource.data.keys().hasOnly(
            ['senderUid', 'recipientUid', 'gameId', 'type', 'title', 'body', 'read', 'createdAt']
          )
        )
        && request.resource.data.title is string
        // Hard cap on user-visible strings — prevents a malicious sender from
        // wedging multi-megabyte notification docs into the recipient's feed.
        && request.resource.data.title.size() <= 80
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 200
        && request.resource.data.gameId is string
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        // Sender must be a participant (player OR judge) of the referenced game.
        && isParticipant(fsGet('games', request.resource.data.gameId).data)
        // Recipient must be a participant (player OR judge) of the same game.
        // Allows: player→player (existing), player→judge (judge_invite),
        // judge→player (your_turn after ruling).
        && (
          request.resource.data.recipientUid == fsGet('games', request.resource.data.gameId).data.player1Uid
          || request.resource.data.recipientUid == fsGet('games', request.resource.data.gameId).data.player2Uid
          || (
            'judgeId' in fsGet('games', request.resource.data.gameId).data
            && fsGet('games', request.resource.data.gameId).data.judgeId != null
            && request.resource.data.recipientUid == fsGet('games', request.resource.data.gameId).data.judgeId
          )
        )
        // Rate limit: at most 1 notification per game per action type per 5 seconds
        && (
          !fsExists('notification_limits', request.auth.uid + '_' + request.resource.data.gameId + '_' + request.resource.data.type)
          || request.time > fsGet('notification_limits', request.auth.uid + '_' + request.resource.data.gameId + '_' + request.resource.data.type).data.lastSentAt + duration.value(5, 's')
        )
        // Companion-write requirement (May 2026 H2 hardening): a /notifications
        // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r28
        && (
          fsGetAfter('notification_limits', request.auth.uid + '_' + request.resource.data.gameId + '_' + request.resource.data.type).data.lastSentAt == request.time
          || fsGetAfter('games', request.resource.data.gameId).data.updatedAt == request.time
        );

      // Only the recipient can mark a notification as read
      allow update: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.read == true
        // Cannot change other fields
        && request.resource.data.recipientUid == resource.data.recipientUid
        && request.resource.data.senderUid == resource.data.senderUid
        && request.resource.data.type == resource.data.type
        && request.resource.data.title == resource.data.title
        && request.resource.data.body == resource.data.body
        && request.resource.data.gameId == resource.data.gameId
        && request.resource.data.createdAt == resource.data.createdAt;

      // Only the recipient can delete their own notifications.
      allow delete: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid;
    }

    // ── Notification rate limits ──
    // One doc per sender+game+type combo, enforces 5-second cooldown server-side.
    match /notification_limits/{limitId} {
      // NOTE: Clients only write to this collection (setDoc). If a future
      // read path is added, handle the non-existent-doc case (resource == null).
      allow read: if isSignedIn()
        && resource.data.senderUid == request.auth.uid;

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.senderUid
        && limitId == (request.auth.uid + '_' + request.resource.data.gameId + '_' + request.resource.data.type)
        && request.resource.data.type in ['your_turn', 'new_challenge', 'game_won', 'game_lost', 'judge_invite', 'nudge']
        // lastSentAt must equal the server's current time. Without this, a
        // client could seed the doc with a stale timestamp (e.g. epoch 0)
        // and every subsequent update would instantly satisfy the 5s cooldown
        // below, defeating server-side notification rate limiting.
        && request.resource.data.lastSentAt == request.time;

      allow update: if isSignedIn()
        && request.auth.uid == resource.data.senderUid
        && request.time > resource.data.lastSentAt + duration.value(5, 's')
        // New lastSentAt must equal the server's current time — i.e. the
        // client wrote serverTimestamp(). The previous rule accepted any
        // new value, so a malicious client could back-date lastSentAt on
        // each write and keep the 5s cooldown permanently satisfied.
        && request.resource.data.lastSentAt == request.time
        // Immutable identity fields: the doc id is derived from
        // senderUid + gameId + type, so mutating any of them would desync
        // the cooldown key from its bucket and let a sender silently
        // rewrite another bucket's cooldown state.
        && request.resource.data.senderUid == resource.data.senderUid
        && request.resource.data.gameId == resource.data.gameId
        && request.resource.data.type == resource.data.type;

      // Rate-limit docs are server-managed cooldown state with no user-facing
      // lifecycle. Clients must never delete them — a successful delete would
      // reset the 5-second cooldown and let a sender spam notifications.
      // (The previous rule checked resource.data.recipientUid, which doesn't
      // exist on these docs — so it was a copy-paste from /notifications that
      // always denied. Making the intent explicit matches /nudge_limits.)
      allow delete: if false;
    }

    // ── Push targets (cross-readable token mirror) ──
    // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r29
    match /pushTargets/{uid} {
      // get only: a sender looks up one recipient it already knows. No list,
      // so nobody can dump every user's device tokens in one query.
      allow get: if isSignedIn();
      allow list: if false;

      // Allowlist of accepted keys. setDoc(..., merge:true) is the only
      // legitimate writer (src/services/fcm.ts + pushNotifications.ts +
      // pushPreferences.ts), and every write touches tokens and updatedAt
      // together — keep this in lockstep with the writers if you add a field.
      // `platforms` (optional) tags each token with ios/android/web so the
      // server can keep Roll Dice pushes off iPhones while dice is off in the
      // iOS build (functions/src/push/platforms.ts). Keyed by token. Not tied
      // to the token list so an older build's arrayRemove that leaves a stale
      // tag behind is still accepted; new builds prune stale tags when they
      // register (src/services/pushPlatform.ts tagToken). No size cap: the
      // token list is already <=10, and a size cap on platforms would lock
      // the owner out of every push write once stale tags piled past it.
      function pushTargetsKeysOk() {
        return request.resource.data.keys().hasOnly(['tokens', 'updatedAt', 'platforms']);
      }

      function pushTargetsPlatformsOk() {
        return !('platforms' in request.resource.data)
          || (request.resource.data.platforms is map
            && request.resource.data.platforms.values().hasOnly(['ios', 'android', 'web']));
      }

      function pushTargetsShapeOk() {
        return request.resource.data.tokens is list
          && request.resource.data.tokens.size() <= 10
          && pushTargetsPlatformsOk()
          // updatedAt MUST equal server time — without this, a client could
          // backfill an old timestamp and we'd lose stale-token-cleanup
          // semantics elsewhere (the Extension uses updatedAt to skip
          // long-revoked mirrors when a delivery attempt 404s).
          && request.resource.data.updatedAt == request.time;
      }

      allow create: if isOwner(uid)
        && pushTargetsKeysOk()
        && pushTargetsShapeOk();
      allow update: if isOwner(uid)
        && pushTargetsKeysOk()
        && pushTargetsShapeOk();
      // Owner may wipe their mirror (e.g. on account deletion).
      allow delete: if isOwner(uid);
    }

    // ── Push dispatch (Firebase Extension trigger collection) ──
    // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r30
    match /push_dispatch/{dispatchId} {
      // Read: only sender and recipient. The Extension reads via Admin SDK
      // so it ignores these rules. Recipient access lets a debug UI show
      // "delivery pending" state without exposing dispatch payloads
      // cross-user.
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.senderUid
            || request.auth.uid == resource.data.recipientUid);

      allow create: if isSignedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.gameId is string
        // 'nudge' is push-only — it has NO /notifications feed entry (nudges
        // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r31
        && request.resource.data.type in ['your_turn', 'new_challenge', 'game_won', 'game_lost', 'judge_invite', 'nudge']
        // ── Dispatch payload shape ──
        && request.resource.data.notification is map
        && request.resource.data.notification.title is string
        && request.resource.data.notification.title.size() <= 80
        && request.resource.data.notification.body is string
        && request.resource.data.notification.body.size() <= 200
        && request.resource.data.data is map
        && request.resource.data.data.gameId == request.resource.data.gameId
        // ── Tokens ──
        && request.resource.data.tokens is list
        && request.resource.data.tokens.size() >= 1
        && request.resource.data.tokens.size() <= 10
        && request.resource.data.createdAt == request.time
        // ── Participation ──
        // Sender must be a participant (player OR judge) of the referenced game.
        && isParticipant(fsGet('games', request.resource.data.gameId).data)
        // Recipient must be a participant of the same game. Mirrors the
        // /notifications create rule — player→player (your_turn / game_*),
        // player→judge (judge_invite, ruling needed), judge→player (rulings).
        && (
          request.resource.data.recipientUid == fsGet('games', request.resource.data.gameId).data.player1Uid
          || request.resource.data.recipientUid == fsGet('games', request.resource.data.gameId).data.player2Uid
          || (
            'judgeId' in fsGet('games', request.resource.data.gameId).data
            && fsGet('games', request.resource.data.gameId).data.judgeId != null
            && request.resource.data.recipientUid == fsGet('games', request.resource.data.gameId).data.judgeId
          )
        )
        // ── Token integrity ──
        // Every token MUST appear in the recipient's /pushTargets mirror.
        // Without this, a malicious sender could embed arbitrary tokens
        // (their own device, a token scraped from another collection, …)
        // and have the Extension deliver pushes to wrong devices.
        // hasOnly is the inverse of hasAll: it checks subset, which is
        // what we want — sender's tokens ⊆ recipient's mirror.
        && request.resource.data.tokens.hasOnly(
          fsGet('pushTargets', request.resource.data.recipientUid).data.tokens
        )
        // ── Companion-write rate limit (Codex P1 hardening) ──
        // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r32
        && fsGetAfter('push_dispatch_limits', request.auth.uid + '_' + request.resource.data.recipientUid + '_' + request.resource.data.gameId + '_' + request.resource.data.type).data.lastSentAt == request.time;

      // Dispatch docs are immutable once created — the Extension writes its
      // delivery results to a sibling collection (configured by the
      // Extension), so clients never need to update or delete here. The
      // Extension's worker runs as Admin SDK and ignores these rules for
      // its own bookkeeping writes.
      allow update: if false;
      allow delete: if false;
    }

    // ── Push dispatch rate limits ──
    // One doc per (sender, recipient, game, type) tuple, enforces the 5s
    // cooldown server-side that the /push_dispatch create rule's
    // companion-write check anchors against. Mirrors the
    // /notification_limits / /nudge_limits / /reports_limits pattern:
    // every legit dispatch write commits this doc in the SAME writeBatch,
    // and the create/update rules pin lastSentAt to serverTimestamp() so
    // a malicious client can't backdate the cooldown anchor and keep the
    // 5s gate permanently satisfied.
    match /push_dispatch_limits/{limitId} {
      // NOTE: Clients only write to this collection. If a future read
      // path is added, handle the non-existent-doc case (resource == null).
      allow read: if isSignedIn() && resource.data.senderUid == request.auth.uid;

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.senderUid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.gameId is string
        // Doc id MUST be deterministic so the /push_dispatch create rule
        // can look it up by shape (request.auth.uid + '_' + recipientUid
        // + '_' + gameId + '_' + type).
        && limitId == (request.auth.uid + '_' + request.resource.data.recipientUid + '_' + request.resource.data.gameId + '_' + request.resource.data.type)
        // Keep in lockstep with the /push_dispatch create allowlist above — a
        // type accepted there but rejected here could never satisfy that rule's
        // companion-write check, silently killing that push type.
        && request.resource.data.type in ['your_turn', 'new_challenge', 'game_won', 'game_lost', 'judge_invite', 'nudge']
        // lastSentAt server-pinned: a client-supplied timestamp would let
        // them seed a stale anchor and immediately satisfy the cooldown
        // on the very next update. Same back-date defence as
        // notification_limits.
        && request.resource.data.lastSentAt == request.time;

      allow update: if isSignedIn()
        && request.auth.uid == resource.data.senderUid
        // 5s cooldown vs the stored anchor. Matches /notifications.
        && request.time > resource.data.lastSentAt + duration.value(5, 's')
        // New lastSentAt MUST be server time — closes the same back-date
        // bypass as create above.
        && request.resource.data.lastSentAt == request.time
        // Immutable identity fields: doc id is derived from the tuple, so
        // mutating any component would desync the cooldown bucket.
        && request.resource.data.senderUid == resource.data.senderUid
        && request.resource.data.recipientUid == resource.data.recipientUid
        && request.resource.data.gameId == resource.data.gameId
        && request.resource.data.type == resource.data.type;

      // Cooldown anchors must never be deleted — a successful delete
      // would reset the 5s gate and re-enable burst spam.
      allow delete: if false;
    }

    // ── Reports (content/player flagging for Google Play UGC policy) ──
    // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r33
    match /reports/{reportId} {
      // The reporter reads their own reports (duplicate check in the UI); an
      // admin reads every report — that IS the moderation queue. The reported
      // user must never read it (retaliation vector).
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.reporterUid == request.auth.uid);

      allow create: if isSignedIn()
        && notBanned()
        && request.auth.token.email_verified == true
        && request.resource.data.reporterUid == request.auth.uid
        // Cannot report yourself
        && request.resource.data.reportedUid != request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUsername is string
        // Denormalized handle, same bound as the authoritative username field
        // (USERNAME_MAX) — without a cap, a client could wedge a
        // multi-megabyte string into the moderation queue.
        && request.resource.data.reportedUsername.size() <= 20
        // gameId is the game a reported player was encountered in. It stays
        // a mandatory string for game-sourced reports, but a user-uploaded
        // clip has no backing game — those reports carry gameId: null and
        // MUST identify the target clip instead, so a null can never be
        // used to file an unattributable report.
        && (
          request.resource.data.gameId is string
          || (request.resource.data.gameId == null
              && request.resource.data.clipId is string
              && request.resource.data.clipId.size() > 0)
          || (request.resource.data.gameId == null
              && request.resource.data.spotId is string
              && request.resource.data.spotId.size() > 0)
        )
        && request.resource.data.reason is string
        && request.resource.data.reason in ['inappropriate_video', 'inappropriate', 'abusive_behavior', 'cheating', 'spam', 'non_skate_content', 'not_skating', 'illegal_content', 'other']
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        // DSA Art. 16: an illegal-content notice has to say what is illegal.
        // Other reasons may leave the explanation blank.
        && (
          request.resource.data.reason != 'illegal_content'
          || request.resource.data.description.size() >= 20
        )
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        // Optional clipId: when a report targets a clip from the feed rather
        // than an in-game video, it carries the clip's deterministic id
        // (`${gameId}_${turnNumber}_${role}`). Shape-only check here —
        // moderators dedupe and action via Admin SDK.
        && (
          !('clipId' in request.resource.data)
          || (request.resource.data.clipId is string
              && request.resource.data.clipId.size() > 0
              && request.resource.data.clipId.size() <= 128)
        )
        // Optional spotId: a report about something posted on a spot page.
        && (
          !('spotId' in request.resource.data)
          || (request.resource.data.spotId is string
              && request.resource.data.spotId.size() > 0
              && request.resource.data.spotId.size() <= 128)
        )
        // Optional single comment (under clipId or spotId) plus the text
        // as it read when reported, so a moderator still sees it if the
        // author deletes it first. Bounded like a comment body.
        && (
          !('commentId' in request.resource.data)
          || (request.resource.data.commentId is string
              && request.resource.data.commentId.size() > 0
              && request.resource.data.commentId.size() <= 128
              && ('clipId' in request.resource.data || 'spotId' in request.resource.data))
        )
        && (
          !('commentText' in request.resource.data)
          || (request.resource.data.commentText is string
              && request.resource.data.commentText.size() <= 300
              && 'commentId' in request.resource.data)
        )
        // Optional disputeId. A community-call report names the dispute so
        // an admin can hide it. Shape only — auto-hide does not run for it.
        && (
          !('disputeId' in request.resource.data)
          || (request.resource.data.disputeId is string
              && request.resource.data.disputeId.size() > 0
              && request.resource.data.disputeId.size() <= 128)
        )
        // Rate-limit gate: EITHER the reporter has never reported this
        // target before (no limits doc exists) OR the previous report was
        // more than 1 hour ago. Checked against the PRE-batch state via
        // get(); getAfter() below covers the companion-write freshness.
        && (
          !fsExists('reports_limits', request.auth.uid + '_' + request.resource.data.reportedUid)
          || request.time > fsGet('reports_limits', request.auth.uid + '_' + request.resource.data.reportedUid).data.lastSentAt + duration.value(1, 'h')
        )
        // Companion-write requirement: in the same batch, the reporter MUST
        // also write the matching reports_limits/{reporter_reported} doc
        // with lastSentAt pinned to request.time. Without this, the
        // cooldown would never advance. getAfter() reflects the batch's
        // post-commit state — if the client didn't include the limit
        // write, the doc won't exist there and the rule rejects.
        && fsGetAfter('reports_limits', request.auth.uid + '_' + request.resource.data.reportedUid).data.lastSentAt == request.time;

      // ── Moderation close-out (admin custom claim) ──
      // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r34
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'resolvedBy', 'resolvedAt'])
        && request.resource.data.status in ['resolved', 'dismissed']
        && request.resource.data.resolvedBy == request.auth.uid
        && request.resource.data.resolvedAt == request.time
        // Dismissing takes no action, so there is nothing to explain.
        // Resolving restricts content: the same batch must leave a
        // statement of reasons the subject can read (they cannot read
        // this report). getAfter sees that companion write.
        && (
          request.resource.data.status == 'dismissed'
          || (
            fsExistsAfter('moderationStatements', reportId)
            && fsGetAfter('moderationStatements', reportId).data.subjectUid == resource.data.reportedUid
            && fsGetAfter('moderationStatements', reportId).data.createdBy == request.auth.uid
            && fsGetAfter('moderationStatements', reportId).data.createdAt == request.time
            && fsGetAfter('moderationStatements', reportId).data.action == 'content_restricted'
          )
        );
      // Reports are the moderation audit trail — nobody deletes them.
      allow delete: if false;
    }

    // ── Report rate limits ──
    // One doc per (reporter, reported) pair, enforces 1-hour cooldown
    // server-side. Companion write to every /reports create (see above).
    // Mirrors nudge_limits / notification_limits: lastSentAt is pinned to
    // request.time on every create/update to close the back-date bypass
    // where a client seeds epoch 0 and permanently satisfies the gate.
    match /reports_limits/{limitId} {
      // NOTE: Clients only write to this collection. If a future read path
      // is added, handle the non-existent-doc case (resource == null).
      allow read: if isSignedIn()
        && resource.data.reporterUid == request.auth.uid;

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.reporterUid
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid != request.auth.uid
        // Doc id MUST be the deterministic `${reporterUid}_${reportedUid}`
        // so the /reports create rule can look it up by shape.
        && limitId == (request.auth.uid + '_' + request.resource.data.reportedUid)
        // lastSentAt pinned to server time. Any other value lets a client
        // back-date the cooldown anchor and keep the 1h gate permanently
        // satisfied. Same pattern as nudge_limits.lastNudgedAt.
        && request.resource.data.lastSentAt == request.time;

      allow update: if isSignedIn()
        && request.auth.uid == resource.data.reporterUid
        // 1-hour cooldown vs the stored anchor.
        && request.time > resource.data.lastSentAt + duration.value(1, 'h')
        // New lastSentAt must be server time — closes the same back-date
        // bypass on updates as the create rule above.
        && request.resource.data.lastSentAt == request.time
        // Immutable identity fields: the doc id is derived from
        // reporterUid + reportedUid, so mutating either would desync the
        // cooldown key from its bucket and let a reporter silently rewrite
        // another pair's cooldown state.
        && request.resource.data.reporterUid == resource.data.reporterUid
        && request.resource.data.reportedUid == resource.data.reportedUid;

      // Rate-limit docs are server-managed cooldown state with no user-
      // facing lifecycle. Clients must never delete them — a successful
      // delete would reset the 1h cooldown and re-enable spam.
      allow delete: if false;
    }

    // ── Statements of reasons (DSA Art. 17) ──
    // The reported user must never read /reports (the reporter's identity
    // is in there). When an admin resolves a report they write one of
    // these in the same batch. The subject reads this doc; strangers do
    // not. Doc id is the report id, so a report has one statement.
    // Clip rejection and removal write the same shape through the Admin
    // SDK (doc id clip_{clipId}), which bypasses this client create rule.
    match /moderationStatements/{statementId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.subjectUid == request.auth.uid);

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'subjectUid', 'reportId', 'action', 'reason', 'explanation',
          'contentRef', 'createdBy', 'createdAt'
        ])
        && request.resource.data.subjectUid is string
        && request.resource.data.subjectUid.size() > 0
        && request.resource.data.subjectUid != request.auth.uid
        && statementId == request.resource.data.reportId
        && request.resource.data.reportId is string
        && request.resource.data.reportId.size() > 0
        && request.resource.data.reportId.size() <= 128
        && request.resource.data.action == 'content_restricted'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 64
        && request.resource.data.explanation is string
        && request.resource.data.explanation.size() > 0
        && request.resource.data.explanation.size() <= 1000
        && request.resource.data.contentRef is string
        && request.resource.data.contentRef.size() > 0
        && request.resource.data.contentRef.size() <= 128
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && fsGetAfter('reports', statementId).data.status == 'resolved'
        && fsGetAfter('reports', statementId).data.resolvedBy == request.auth.uid
        && fsGetAfter('reports', statementId).data.resolvedAt == request.time
        && fsGetAfter('reports', statementId).data.reportedUid == request.resource.data.subjectUid;

      // The statement is the notice. Editing it would rewrite the reason
      // the subject was given. A new action is a new report close-out.
      allow update: if false;
      allow delete: if false;
    }

    // ── Appeals (DSA Art. 20) ──
    // One appeal per target. Doc id is `${targetKind}_${targetId}`:
    // `statement_{reportId}` or `ban_{uid}`. Email verification is NOT
    // required, and notBanned() does not apply — a restricted user has
    // to be able to ask for a review. The reported user still cannot
    // read the original report.
    match /appeals/{appealId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.appellantUid == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'appellantUid', 'targetKind', 'targetId', 'explanation', 'status', 'createdAt'
        ])
        && request.resource.data.appellantUid == request.auth.uid
        && request.resource.data.targetKind in ['statement', 'ban']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId.size() <= 128
        && appealId == request.resource.data.targetKind + '_' + request.resource.data.targetId
        && request.resource.data.explanation is string
        && request.resource.data.explanation.size() > 0
        && request.resource.data.explanation.size() <= 1000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && (
          (
            request.resource.data.targetKind == 'statement'
            && fsExists('moderationStatements', request.resource.data.targetId)
            && fsGet('moderationStatements', request.resource.data.targetId).data.subjectUid == request.auth.uid
          )
          || (
            request.resource.data.targetKind == 'ban'
            && request.resource.data.targetId == request.auth.uid
            && fsExists('bans', request.auth.uid)
          )
        );

      // The appellant cannot edit a filed appeal. An admin moves it
      // once, from pending to a terminal outcome, with an audit stamp.
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status in ['upheld', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;

      allow delete: if false;
    }

    // ── Nudge rate limits ──
    // One doc per sender+game pair, enforces 1-hour cooldown server-side.
    match /nudge_limits/{limitId} {
      // The client reads its own cooldown doc before showing Nudge, and that
      // doc usually doesn't exist yet. A rule that reads resource.data on a
      // missing doc errors (resource == null), so gate on the id
      // (senderUid_gameId) and only check senderUid when the doc exists.
      allow read: if isSignedIn()
        && limitId.matches(request.auth.uid + '_.+')
        && (resource == null || resource.data.senderUid == request.auth.uid);

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.senderUid
        && limitId == (request.auth.uid + '_' + request.resource.data.gameId)
        // lastNudgedAt must equal the server's current time. Otherwise a
        // client could seed the doc with an ancient timestamp, bypassing
        // the 1-hour cooldown on every subsequent update forever.
        && request.resource.data.lastNudgedAt == request.time;

      allow update: if isSignedIn()
        && request.auth.uid == resource.data.senderUid
        && request.time > resource.data.lastNudgedAt + duration.value(1, 'h')
        // New lastNudgedAt must equal the server's current time — prevents
        // the same back-dating bypass on updates (see create rule above).
        && request.resource.data.lastNudgedAt == request.time
        // Immutable identity fields: the doc id is senderUid + gameId, so
        // mutating either would cross-pollute cooldowns across buckets.
        && request.resource.data.senderUid == resource.data.senderUid
        && request.resource.data.gameId == resource.data.gameId;

      allow delete: if false;
    }

    // ── Clips (landed-trick feed) ──
    // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r35
    match /clips/{clipId} {
      allow read: if isSignedIn()
        && (
          isAdmin()
          || resource.data.playerUid == request.auth.uid
          || resource.data.moderationStatus == 'active'
        );

      // ── Game-sourced clips ──
      // Legacy clips written before the `source` field existed stay
      // READABLE (no source check on read; the service mapper defaults
      // them to 'game'), but every NEW game clip must self-declare, so the
      // two create branches below are mutually exclusive and neither can
      // be used to smuggle the other's shape.
      allow create: if isSignedIn()
        && request.resource.data.source == 'game'
        // Deterministic id must match the clip's self-described coordinates.
        && clipId == (request.resource.data.gameId + '_'
                      + string(request.resource.data.turnNumber) + '_'
                      + request.resource.data.role)
        && request.resource.data.gameId is string
        && request.resource.data.turnNumber is int
        && request.resource.data.turnNumber > 0
        && request.resource.data.role in ['set', 'match']
        && request.resource.data.playerUid is string
        && request.resource.data.playerUsername is string
        && request.resource.data.playerUsername.size() > 0
        && request.resource.data.playerUsername.size() <= 20
        && request.resource.data.trickName is string
        && request.resource.data.trickName.size() > 0
        && request.resource.data.trickName.size() <= 100
        && request.resource.data.videoUrl is string
        && request.resource.data.videoUrl.size() > 0
        && request.resource.data.videoUrl.size() <= 2048
        // ── videoUrl bucket pin (audit P2) ──
        // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r36
        && videoUrlBucketPinned(request.resource.data.videoUrl)
        && gameClipVideoUrlOk(request.resource.data)
        && (request.resource.data.spotId == null
            || (request.resource.data.spotId is string
                && request.resource.data.spotId.size() <= 64))
        && request.resource.data.createdAt == request.time
        // Moderation status must start as 'active'. Transitions to 'hidden'
        // are server-side only (Admin SDK), keeping the App Store takedown
        // path out of client reach.
        && request.resource.data.moderationStatus == 'active'
        && !('moderation' in request.resource.data)
        // upvoteCount aggregate must seed at 0; client-side ranking reads
        // this field directly so it has to start at the empty state.
        && request.resource.data.upvoteCount == 0
        // downvoteCount is newer than the game-clip writer, so it is
        // optional here — but if present it must seed empty too.
        && request.resource.data.get('downvoteCount', 0) == 0
        // Writer must be a game participant (player OR nominated judge).
        && isParticipant(fsGet('games', request.resource.data.gameId).data)
        // playerUid must be one of the game's two players — never the judge,
        // never an arbitrary UID.
        && (
          (request.resource.data.playerUid == fsGet('games', request.resource.data.gameId).data.player1Uid
            && request.resource.data.playerUsername == fsGet('games', request.resource.data.gameId).data.player1Username)
          || (request.resource.data.playerUid == fsGet('games', request.resource.data.gameId).data.player2Uid
            && request.resource.data.playerUsername == fsGet('games', request.resource.data.gameId).data.player2Username)
        );

      // ── User-uploaded clips (no backing game) ──
      // Random doc id (there are no game coordinates to derive one from),
      // authored by and attributed to the caller, video pinned to the
      // caller's own `userClips/{uid}/` storage prefix, and rate-limited to
      // one every 30 seconds via the mandatory users/{uid} companion write.
      // The game-only coordinate fields are pinned NULL so a user clip can
      // never masquerade as game history in the feed mapper.
      allow create: if isSignedIn()
        && request.auth.token.email_verified == true
        && notBanned()
        && request.resource.data.source == 'user'
        && request.resource.data.gameId == null
        && request.resource.data.turnNumber == null
        && request.resource.data.role == null
        && request.resource.data.playerUid == request.auth.uid
        && request.resource.data.playerUsername is string
        && request.resource.data.playerUsername.size() > 0
        && request.resource.data.playerUsername.size() <= 20
        // Display name is the caller's real handle (audit H1). users/{uid}
        // is already read by clipRateLimitOk, so this costs no extra read.
        && request.resource.data.playerUsername == fsGet('users', request.auth.uid).data.username
        && request.resource.data.trickName is string
        && request.resource.data.trickName.size() >= 1
        && request.resource.data.trickName.size() <= 80
        && (request.resource.data.spotId == null
            || (request.resource.data.spotId is string
                && request.resource.data.spotId.size() <= 64))
        && (
          (request.resource.data.moderationStatus == 'active'
            && !moderationOn()
            && !('moderation' in request.resource.data)
            && (userClipVideoUrlOk(request.resource.data.videoUrl, request.auth.uid)
                || userClipPublicUrlOk(request.resource.data.videoUrl, request.auth.uid)))
          || (request.resource.data.moderationStatus == 'pending'
            && request.resource.data.moderation == 'pending'
            && userClipVideoUrlOk(request.resource.data.videoUrl, request.auth.uid))
        )
        && !('moderationScores' in request.resource.data)
        && !('moderationNotice' in request.resource.data)
        && !('badgeCounted' in request.resource.data)
        && request.resource.data.upvoteCount == 0
        && request.resource.data.downvoteCount == 0
        && request.resource.data.createdAt == request.time
        && clipRateLimitOk();

      // Clips are otherwise immutable once written — content edits and
      // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r37
      allow update: if isSignedIn()
        && request.auth.token.email_verified == true
        // Only the two aggregates may change — every other field stays put.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvoteCount', 'downvoteCount'])
        // Legacy clips that pre-date an aggregate lack the field on disk;
        // get(field, default) treats them as 0 on both sides so a
        // first-time vote on a pre-backfill clip isn't rejected as a
        // permission-denied — the service mapper defaults the same way.
        && request.resource.data.get('upvoteCount', 0) is int
        && request.resource.data.get('upvoteCount', 0) >= 0
        && request.resource.data.get('downvoteCount', 0) is int
        && request.resource.data.get('downvoteCount', 0) >= 0
        && clipVoteDeltaOk(clipId);

      // The owning player (the one who actually landed the trick) can delete
      // their own clip, to scrub a clip they no longer want in the feed.
      // Account deletion runs server-side with the Admin SDK and doesn't
      // need this rule. Strangers, the opponent, and even the judge cannot
      // delete — only the clip's author.
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.playerUid;

      // ── Clip comments (subcollection) ──
      // Mirrors the spot-comments block: signed-in read, email-verified
      // author-stamped create, immutable, author delete. Two deliberate
      // deltas from spots: banned accounts cannot post (the clip feed is
      // the app's public surface — a ban has to actually silence someone),
      // and an admin may delete any comment, which is the moderation
      // takedown path required for user-generated text.
      match /comments/{commentId} {
        allow read: if isSignedIn();

        allow create: if isSignedIn()
          && request.auth.token.email_verified == true
          && notBanned()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.username is string
          && request.resource.data.username.size() > 0
          && request.resource.data.username.size() <= 20
          // Display name is the caller's real handle (audit H1).
          && request.resource.data.username == fsGet('users', request.auth.uid).data.username
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 300
          && request.resource.data.createdAt == request.time;

        allow update: if false;
        allow delete: if isSignedIn()
          && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // ── Clip upvotes ──
    // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r38
    match /clipVotes/{voteId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        // Email verification mirrors every other content-producing rule
        // (games, spots, comments) — without it, throwaway accounts can
        // inflate vote counts on the public clips feed.
        && request.auth.token.email_verified == true
        && notBanned()
        && voteId == (request.auth.uid + '_' + request.resource.data.clipId)
        && request.resource.data.uid == request.auth.uid
        // Direction is part of the vote doc, and the clips aggregate rule
        // reads it back via getAfter() to decide which counter may move.
        // Anything outside {1, -1} would leave the counters unprovable.
        && request.resource.data.value in [1, -1]
        && request.resource.data.clipId is string
        && request.resource.data.clipId.size() > 0
        && request.resource.data.clipId.size() <= 128
        && request.resource.data.createdAt == request.time
        // Vote target must exist — prevents orphaned votes on clips that
        // were deleted between client-side discovery and the write.
        && fsExists('clips', request.resource.data.clipId)
        // Server-enforced no self-vote (audit MEDIUM): a clip's owner cannot
        // create a vote doc for their own clip. The check is independent of
        // `value`, so it blocks BOTH directions — no ranking self-inflation
        // via upvote, and no self-downvote to fake humility/engagement. The
        // service-layer SelfUpvoteError is UX only.
        && fsGet('clips', request.resource.data.clipId).data.playerUid != request.auth.uid
        && clipVoteCreateTallyOk();

      // ── Vote flip (up ⇄ down) ──
      // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r39
      allow update: if isSignedIn()
        && request.auth.token.email_verified == true
        && notBanned()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['value', 'createdAt'])
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.clipId == resource.data.clipId
        && request.resource.data.value in [1, -1]
        && request.resource.data.value != resource.data.get('value', 1)
        && request.resource.data.createdAt == request.time;

      // Owner-only delete, and — crucially — the delete must CARRY ITS OWN
      // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r40
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.uid
        && (
          // Legacy/malformed vote carrying no clipId: no counter to target,
          // so there is nothing to keep consistent (the server erasure
          // cascade drops these bare).
          !('clipId' in resource.data)
          // Orphan: the clip is already gone, and its aggregates with it.
          || !fsExists('clips', resource.data.clipId)
          // Nothing to subtract: the counter this vote fed is already at its
          // floor (drifted aggregate, Admin-SDK edit, or a legacy clip that
          // pre-dates the aggregates). Blocking the delete here would strand
          // the vote doc forever. Not a stuffing vector — re-voting from a
          // zeroed base still only ever contributes a single +1.
          // Direction default matches voteValueBefore: legacy votes pre-date
          // `value` and were all upvotes → 1.
          || (resource.data.get('value', 1) == 1
              && fsGet('clips', resource.data.clipId).data.get('upvoteCount', 0) <= 0)
          || (resource.data.get('value', 1) == -1
              && fsGet('clips', resource.data.clipId).data.get('downvoteCount', 0) <= 0)
          // The normal path: the SAME atomic write must decrement the counter
          // this vote incremented. A downvote can only ever pull downvoteCount
          // down — never upvoteCount.
          || (resource.data.get('value', 1) == 1
              && fsGetAfter('clips', resource.data.clipId).data.get('upvoteCount', 0)
                 == fsGet('clips', resource.data.clipId).data.get('upvoteCount', 0) - 1)
          || (resource.data.get('value', 1) == -1
              && fsGetAfter('clips', resource.data.clipId).data.get('downvoteCount', 0)
                 == fsGet('clips', resource.data.clipId).data.get('downvoteCount', 0) - 1)
        );
    }

    // ── Disputes (community-judged trick calls) ──
    // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r41
    match /disputes/{disputeId} {
      // Hidden disputes are a takedown. Participants and anyone who already
      // voted can still read them; everyone else only sees open + active.
      allow read: if isSignedIn()
        && (
          resource == null
          || isAdmin()
          || request.auth.uid == resource.data.setterUid
          || request.auth.uid == resource.data.matcherUid
          || fsExists('disputeVotes', request.auth.uid + '_' + disputeId)
          || (resource.data.status == 'open' && resource.data.moderationStatus == 'active')
        );

      allow create: if isSignedIn()
        && request.auth.token.email_verified == true
        // Deterministic id must match the dispute's self-described coordinates.
        && disputeId == (request.resource.data.gameId + '_'
                         + string(request.resource.data.turnNumber))
        && request.resource.data.gameId is string
        && request.resource.data.turnNumber is int
        && request.resource.data.turnNumber > 0
        // Only the setter of the disputed turn may raise it — never the
        // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r42
        && request.resource.data.setterUid == request.auth.uid
        && fsGet('games', request.resource.data.gameId).data.phase == 'pendingReview'
        && request.resource.data.setterUid == fsGet('games', request.resource.data.gameId).data.currentSetter
        && request.resource.data.turnNumber == fsGet('games', request.resource.data.gameId).data.turnNumber
        && request.resource.data.matcherUid is string
        && request.resource.data.matcherUid != request.resource.data.setterUid
        && request.resource.data.setterUsername is string
        && request.resource.data.setterUsername.size() > 0
        && request.resource.data.setterUsername.size() <= 20
        && request.resource.data.matcherUsername is string
        && request.resource.data.matcherUsername.size() > 0
        && request.resource.data.matcherUsername.size() <= 20
        && request.resource.data.trickName is string
        && request.resource.data.trickName.size() > 0
        && request.resource.data.trickName.size() <= 100
        // ── matchVideoUrl bucket pin (audit P2) ──
        // REQUIRED: this is the clip the feed plays. Without a host pin any
        // setter could stamp an attacker-hosted URL into an app-wide feed.
        && request.resource.data.matchVideoUrl is string
        && request.resource.data.matchVideoUrl.size() <= 2048
        && videoUrlBucketPinned(request.resource.data.matchVideoUrl)
        // setVideoUrl is optional (turns that pre-date set recording have
        // none) but must clear the same pin whenever it is present.
        && (request.resource.data.setVideoUrl == null
            || (request.resource.data.setVideoUrl.size() <= 2048
                && videoUrlBucketPinned(request.resource.data.setVideoUrl)))
        && (request.resource.data.spotId == null
            || (request.resource.data.spotId is string
                && request.resource.data.spotId.size() <= 64))
        && request.resource.data.createdAt == request.time
        // A dispute always opens accepting verdicts. The close-out
        // (open → 'closed', plus the referee's verdict/resolutionApplied
        // fields) is an Admin-SDK-only transition — a client can only ever seed
        // 'open' here, and the update rule below denies any status/verdict
        // write, so clients can never resolve a dispute.
        && request.resource.data.status == 'open'
        && request.resource.data.moderationStatus == 'active'
        // Tallies are read directly for the meter, so they must start empty.
        && request.resource.data.landVotes == 0
        && request.resource.data.bailVotes == 0
        // Writer must be a participant of the referenced game.
        && isParticipant(fsGet('games', request.resource.data.gameId).data)
        // Both named uids must be the game's actual players — never the
        // judge, never an arbitrary UID stamped in to fake a matchup.
        && (
          request.resource.data.setterUid == fsGet('games', request.resource.data.gameId).data.player1Uid
          || request.resource.data.setterUid == fsGet('games', request.resource.data.gameId).data.player2Uid
        )
        && (
          request.resource.data.matcherUid == fsGet('games', request.resource.data.gameId).data.player1Uid
          || request.resource.data.matcherUid == fsGet('games', request.resource.data.gameId).data.player2Uid
        );

      // The ONLY client-writable change is a vote tally delta, bound to the
      // paired disputeVotes create/delete in the same atomic write — the same
      // shape as the clips.upvoteCount ±1 branches. Status close-out and
      // content stay Admin SDK only.
      //
      // An admin may hide the dispute from the reports queue. That write
      // changes moderationStatus from active to hidden and nothing else, so
      // it cannot move a tally or rewrite the video.
      allow update: if isAdmin()
        && resource.data.moderationStatus == 'active'
        && request.resource.data.moderationStatus == 'hidden'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['moderationStatus']);

      // Disputes queue final ruling (admin claim only, never pros). Stamps
      // the call once on an open dispute; the referee cron applies it in
      // place of the crowd tally at close-out. Tallies/content untouched.
      allow update: if isAdmin()
        && resource.data.status == 'open'
        && !('adminRuling' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['adminRuling', 'adminRuledBy', 'adminRuledAt'])
        && request.resource.data.adminRuling in ['land', 'bail']
        && request.resource.data.adminRuledBy == request.auth.uid
        && request.resource.data.adminRuledAt == request.time;

      // Vote tallies.
      // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r43
      allow update: if isSignedIn()
        && request.auth.token.email_verified == true
        && (
          // ── +1: the verdict doc was created in THIS write ──
          // Absent before AND present after ⇒ genuinely new. Without
          // !exists() a user who already voted could keep incrementing;
          // without existsAfter() they could inflate the meter without
          // recording any verdict at all.
          (
            !fsExists('disputeVotes', request.auth.uid + '_' + disputeId)
            && fsExistsAfter('disputeVotes', request.auth.uid + '_' + disputeId)
            // New verdicts are only accepted while the dispute is open. (The
            // -1 branch is deliberately NOT status-gated — erasure has to
            // work on closed disputes too.)
            && resource.data.status == 'open'
            && (
              // LAND: landVotes is the only field that may differ, and only
              // to exactly +1 of its stored value.
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['landVotes'])
                && request.resource.data.landVotes is int
                && request.resource.data.landVotes == resource.data.get('landVotes', 0) + 1
                // The paired verdict must actually say 'land' — otherwise a
                // voter files a BAIL verdict while inflating the LAND meter.
                && fsGetAfter('disputeVotes', request.auth.uid + '_' + disputeId).data.verdict == 'land')
              ||
              // BAIL: mirror image.
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bailVotes'])
                && request.resource.data.bailVotes is int
                && request.resource.data.bailVotes == resource.data.get('bailVotes', 0) + 1
                && fsGetAfter('disputeVotes', request.auth.uid + '_' + disputeId).data.verdict == 'bail')
            )
          )
          ||
          // ── -1: the verdict doc was deleted in THIS write ──
          // Present before AND absent after. The verdict is read from the
          // PRE-state (get, not getAfter — the doc is gone afterwards), so a
          // deleted BAIL vote can only ever decrement bailVotes.
          (
            fsExists('disputeVotes', request.auth.uid + '_' + disputeId)
            && !fsExistsAfter('disputeVotes', request.auth.uid + '_' + disputeId)
            && (
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['landVotes'])
                && request.resource.data.landVotes is int
                && request.resource.data.landVotes >= 0
                && request.resource.data.landVotes == resource.data.get('landVotes', 0) - 1
                && fsGet('disputeVotes', request.auth.uid + '_' + disputeId).data.verdict == 'land')
              ||
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bailVotes'])
                && request.resource.data.bailVotes is int
                && request.resource.data.bailVotes >= 0
                && request.resource.data.bailVotes == resource.data.get('bailVotes', 0) - 1
                && fsGet('disputeVotes', request.auth.uid + '_' + disputeId).data.verdict == 'bail')
            )
          )
        );

      // ── Gap B (delete + re-raise wipes an unfavourable tally) — CLOSED ──
      // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r44
      allow delete: if false;
    }

    // ── Dispute verdicts ──
    //
    // One verdict per (uid, disputeId), enforced by the deterministic
    // `${uid}_${disputeId}` doc id, verified at create time so a client
    // cannot file a verdict under someone else's name. Verdicts are
    // immutable — update is forbidden outright, so a call cannot be changed
    // after the fact — and delete is owner-only for the deletion cascade.
    match /disputeVotes/{voteId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && notBanned()
        // Email verification mirrors clipVotes — without it, throwaway
        // accounts could brigade a public verdict.
        && request.auth.token.email_verified == true
        && voteId == (request.auth.uid + '_' + request.resource.data.disputeId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.disputeId is string
        && request.resource.data.disputeId.size() > 0
        && request.resource.data.disputeId.size() <= 128
        && request.resource.data.verdict in ['land', 'bail']
        && request.resource.data.createdAt == request.time
        // Target must exist — no orphaned verdicts on deleted disputes.
        && fsExists('disputes', request.resource.data.disputeId)
        && fsGet('disputes', request.resource.data.disputeId).data.status == 'open'
        // You never judge your own trick. This is the AUTHORITATIVE check —
        // the client's canVote flag is a UI affordance, not authorization.
        && fsGet('disputes', request.resource.data.disputeId).data.setterUid != request.auth.uid
        && fsGet('disputes', request.resource.data.disputeId).data.matcherUid != request.auth.uid
        && disputeVoteCreateTallyOk();

      allow update: if false;

      // Owner-only delete, and — crucially — the delete must CARRY ITS OWN
      // … full rationale: docs/FIRESTORE_RULES_NOTES.md#r45
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.uid
        && (
          // Orphan: the dispute is already gone, so there is no tally left to
          // keep consistent — just drop the vote.
          !fsExists('disputes', resource.data.disputeId)
          // Nothing to subtract: the counter this verdict fed is already at
          // zero (Admin-SDK close-out, or a dispute that was deleted and
          // re-raised from a zeroed tally). Blocking the delete here would
          // strand the vote doc forever. Not a stuffing vector — re-voting
          // from a zeroed base still only ever contributes a single +1.
          || (resource.data.verdict == 'land'
              && fsGet('disputes', resource.data.disputeId).data.get('landVotes', 0) <= 0)
          || (resource.data.verdict == 'bail'
              && fsGet('disputes', resource.data.disputeId).data.get('bailVotes', 0) <= 0)
          // The normal path: the SAME write must decrement the counter this
          // verdict incremented. A 'bail' vote can only ever pull bailVotes
          // down — never landVotes.
          || (resource.data.verdict == 'land'
              && fsGetAfter('disputes', resource.data.disputeId).data.landVotes
                 == fsGet('disputes', resource.data.disputeId).data.get('landVotes', 0) - 1)
          || (resource.data.verdict == 'bail'
              && fsGetAfter('disputes', resource.data.disputeId).data.bailVotes
                 == fsGet('disputes', resource.data.disputeId).data.get('bailVotes', 0) - 1)
        );
    }

    // ── Roll Dice (server-written) ──
    // The diceAction callable and the account-deletion cascade are the only
    // writers. Both use the Admin SDK, which bypasses these rules. Clients
    // may read a match they are in, and any signed-in user may read a single
    // diceStats doc (the hub shows wins and losses). Nothing here is a
    // S.K.A.T.E. game: onGameCompleted never sees this collection.
    match /diceGames/{gameId} {
      allow get, list: if isSignedIn() && request.auth.uid in resource.data.playerUids;
      allow create, update, delete: if false;
    }

    match /diceStats/{uid} {
      allow get: if isSignedIn();
      allow list: if false;
      allow write: if false;
    }

    // Create-cooldown anchor. Not readable by clients (it would leak the
    // last time someone started a match).
    match /diceCreateLimits/{uid} {
      allow read, write: if false;
    }

    // Trick-training labels. Written by the sweep cron (admin SDK). Admins
    // may read them for export. Clients cannot write or read.
    match /trainingLabels/{labelId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Owner-created withdrawal marker. The cron marks that skater's labels
    // excluded and deletes the doc. Doc id is the uid.
    match /trainingRevocations/{uid} {
      allow read: if false;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['revokedAt'])
        && request.resource.data.revokedAt == request.time;
      allow delete: if false;
    }

    // Pro blessing lineage. Written only by the proBlessing callable (Admin
    // SDK). A pro badge cannot be earned: no client can create, edit or
    // delete a blessing. Accepted and revoked records are public lineage;
    // pending and declined offers are visible only to the two skaters and
    // admins. Rationale: docs/PRO_BLESSING.md.
    match /proBlessings/{blessingId} {
      allow get, list: if resource.data.status in ['accepted', 'revoked']
        || (isSignedIn() && (request.auth.uid == resource.data.blesserUid
          || request.auth.uid == resource.data.targetUid
          || isAdmin()));
      allow create, update, delete: if false;
    }

    // ── Spot group messages (spots/{spotId}/messages/{messageId}) ──
    // Real-time group chat per spot. All signed-in users can read and post.
    // Word filter blocks known slurs/spam. Rate limit: 1 message per 3 seconds
    // per user. Admins can hide/unhide messages.
    match /spots/{spotId}/messages/{messageId} {
      allow read: if isSignedIn();

      // Simple word filter. Case-insensitive substring matching.
      function containsBlockedWord(text) {
        let lower = text.lower();
        return lower.matches('.*nigger.*')
          || lower.matches('.*nigga.*')
          || lower.matches('.*faggot.*')
          || lower.matches('.*retard.*')
          || lower.matches('.*tranny.*')
          || lower.matches('.*chink.*')
          || lower.matches('.*kike.*')
          || lower.matches('.*wetback.*')
          || lower.matches('.*bitcoin.*')
          || lower.matches('.*crypto.*')
          || lower.matches('.*buy now.*')
          || lower.matches('.*click here.*')
          || lower.matches('.*free money.*')
          || lower.matches('.*fuck you.*')
          || lower.matches('.*suck my.*')
          || lower.matches('.*eat shit.*')
          || lower.matches('.*kill yourself.*');
      }

      allow create: if isSignedIn()
        && notBanned()
        && request.resource.data.keys().hasOnly(['userId', 'content', 'createdAt', 'isHidden', 'hiddenReason'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.isHidden is bool
        // Rate limit: 3 seconds between messages per spot
        && (!fsExists('users', request.auth.uid) 
            || !('lastSpotMessageAt' in fsGet('users', request.auth.uid).data)
            || request.time > fsGet('users', request.auth.uid).data.lastSpotMessageAt + duration.value(3, 's'))
        // Word filter enforcement: if content has blocked words, isHidden must be true
        && (containsBlockedWord(request.resource.data.content) == request.resource.data.isHidden)
        // If hidden by word filter, reason must be 'word_filter'
        && (!request.resource.data.isHidden 
            || (request.resource.data.hiddenReason == 'word_filter'))
        // Rate limit anchor: user doc must be updated in same batch
        && fsGetAfter('users', request.auth.uid).data.lastSpotMessageAt == request.time;

      // Admin can hide/unhide messages
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isHidden', 'hiddenReason'])
        && request.resource.data.isHidden is bool
        && (!request.resource.data.isHidden 
            || request.resource.data.hiddenReason in ['word_filter', 'reported', 'user_blocked']);

      allow delete: if false;
    }

    // Spot message reports (top-level collection for admin review)
    match /spotMessageReports/{reportId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.reportedBy == request.auth.uid);

      allow create: if isSignedIn()
        && notBanned()
        && request.resource.data.keys().hasOnly(['messageId', 'spotId', 'reportedBy', 'reason', 'details', 'createdAt', 'status'])
        && request.resource.data.messageId is string
        && request.resource.data.spotId is string
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.reason in ['spam', 'harassment', 'inappropriate', 'other']
        && (!('details' in request.resource.data) || request.resource.data.details is string)
        && (!('details' in request.resource.data) || request.resource.data.details.size() <= 500)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'reviewed', 'dismissed'];

      allow delete: if false;
    }

    // ── Closet: catalog (item definitions) ──
    // Public read, server-only writes. The closet callables and admin tools
    // mint copies from catalog/{itemDefId} and keep serials/{id} consistent.
    // Plan: functions/src/closet/, ../uploads/closet-drops-plan.md §9.
    match /catalog/{itemDefId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── Closet: serial ledger (ownership source of truth) ──
    // Public provenance — every Limited/Grail copy shows who owned it and
    // when. Server-only writes: a client write here would desync the serial
    // from the user's locker/{copyId} or bypass the Bucks debit.
    match /serials/{serialId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── Closet: drops (weekly limited releases) ──
    // Drop docs are public; claims/{uid} and entries/{uid} subcollections
    // are private to the user. Only the closet callables write.
    match /drops/{dropId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /claims/{uid} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /entries/{uid} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // ── Closet: trades (item-for-item swaps) ──
    // Both parties can read the trade; only the closet callables write.
    // Public history would reveal who's trading what and leak inventory.
    // Party fields are the ones the callables write (functions/src/closet/
    // trading.ts): fromUid proposes, toUid receives. A client list query must
    // filter on one of them (where('fromUid','==',me) / where('toUid','==',me))
    // so the rule can prove every result is theirs.
    match /trades/{tradeId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.fromUid
          || request.auth.uid == resource.data.toUid);
      allow write: if false;
    }

    // ── Closet: audit log (admin actions) ──
    // Admin-only read. A mint, grant or trade reversal goes here so Jason
    // can audit custody. Not readable by regular users — item provenance
    // shows on the copy itself; this is the operator audit trail.
    match /closetAudit/{autoId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── What's That Trick (WTT) collections ──
    // wttItems: server-only write, public read when status=='open'
    // wttGold: admin/server-only (gold answers never client-readable)
    // wttVotes: client create-only, one per user per clip
    // users/{uid}/private/wtt: server-only write, owner read
    // proReviews: verified-pro create; admin read

    match /wttItems/{clipId} {
      // Verified pros also read the split-vote queue (Pro review queue).
      allow read: if isSignedIn()
        && (resource.data.status == 'open'
            || (resource.data.status == 'pro_queue' && isVerifiedPro()));
      allow write: if false;
    }

    match /wttGold/{clipId} {
      allow read, write: if false;
    }

    match /wttVotes/{voteId} {
      allow create: if isSignedIn()
        && notBanned()
        && emailVerified()
        && voteId == request.resource.data.clipId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['clipId','uid','choice','createdAt'])
        && request.resource.data.choice is string
        && request.resource.data.choice.size() > 0
        && request.resource.data.choice.size() <= 48
        && request.resource.data.createdAt == request.time
        && fsExists('clips', request.resource.data.clipId)
        && fsGet('clips', request.resource.data.clipId).data.playerUid != request.auth.uid;
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{uid}/private/wtt {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /proReviews/{reviewId} {
      allow create: if isSignedIn()
        && isVerifiedPro()
        && request.resource.data.uid == request.auth.uid
        // One call per pro per clip, on a real WTT item.
        && reviewId == request.resource.data.clipId + '_' + request.auth.uid
        && fsExists('wttItems', request.resource.data.clipId)
        && request.resource.data.keys().hasOnly(['clipId','uid','answerTrickId','note','createdAt'])
        && request.resource.data.clipId is string
        && request.resource.data.answerTrickId is string
        && request.resource.data.answerTrickId.size() > 0
        && request.resource.data.answerTrickId.size() <= 48
        && (!('note' in request.resource.data)
          || (request.resource.data.note is string && request.resource.data.note.size() <= 280))
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // proGold: a verified pro marks a WTT clip's known-correct trick (Gold
    // clip authoring). First call per clip wins; the proGoldOnCreate trigger
    // copies it into wttGold. Pro-scoped, never readable by clients.
    match /proGold/{clipId} {
      allow create: if isSignedIn()
        && isVerifiedPro()
        && request.resource.data.keys().hasOnly(['clipId','uid','answerTrickId','createdAt'])
        && request.resource.data.clipId == clipId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.answerTrickId is string
        && request.resource.data.answerTrickId.size() > 0
        && request.resource.data.answerTrickId.size() <= 48
        && request.resource.data.createdAt == request.time
        && fsExists('wttItems', clipId);
      allow read, update, delete: if false;
    }
  
    // ── Pro community (VITE_FEATURE_PRO_COMMUNITY) ──
    // Verified-pro scoped creates; never an admin power. Shout-outs and
    // props are not pro status (only a blessing is).
    match /proChallenges/{challengeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isVerifiedPro()
        && request.resource.data.keys().hasOnly(['proUid','proUsername','trickName','description','createdAt'])
        && request.resource.data.proUid == request.auth.uid
        && request.resource.data.proUsername is string
        && request.resource.data.proUsername.size() <= 20
        && request.resource.data.trickName is string
        && request.resource.data.trickName.size() > 0
        && request.resource.data.trickName.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 280
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.proUid == request.auth.uid;
    }

    match /proChallengeEntries/{entryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && notBanned()
        && emailVerified()
        && entryId == request.resource.data.challengeId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['challengeId','uid','username','clipId','featured','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 20
        && request.resource.data.clipId is string
        && request.resource.data.featured == false
        && request.resource.data.createdAt == request.time
        && fsExists('proChallenges', request.resource.data.challengeId)
        && fsGet('clips', request.resource.data.clipId).data.playerUid == request.auth.uid;
      // Only the challenge's pro flips `featured`, and nothing else.
      allow update: if isSignedIn()
        && fsGet('proChallenges', resource.data.challengeId).data.proUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['featured'])
        && request.resource.data.featured is bool;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /proProps/{propId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isVerifiedPro()
        && request.resource.data.keys().hasOnly(['fromUid','fromUsername','toUid','toUsername','sticker','note','createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && fsExists('users', request.resource.data.toUid)
        && request.resource.data.fromUsername is string
        && request.resource.data.fromUsername.size() <= 20
        && request.resource.data.toUsername is string
        && request.resource.data.toUsername.size() <= 20
        && request.resource.data.sticker in ['fire','steez','gnarly','clean','respect']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 140
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.fromUid == request.auth.uid;
    }

    match /proFeatured/{clipId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isVerifiedPro()
        && request.resource.data.keys().hasOnly(['clipId','proUid','proUsername','createdAt'])
        && request.resource.data.clipId == clipId
        && request.resource.data.proUid == request.auth.uid
        && request.resource.data.proUsername is string
        && request.resource.data.proUsername.size() <= 20
        && request.resource.data.createdAt == request.time
        && fsExists('clips', clipId);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.proUid == request.auth.uid;
    }
  }
}
