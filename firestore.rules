rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Project bucket name (audit S5+S12, PR-B) ──
    // Hardcoded production bucket, REGEX-ESCAPED. Used exclusively
    // inside `.matches(...)` predicates (avatar URL, video URL pins).
    // The literal bucket is `sk8hub-d7806.firebasestorage.app`; the
    // `.` characters are escaped to `\.` so that a similarly-named
    // attacker bucket (e.g. `sk8hub-d7806xfirebasestoragexapp`) cannot
    // satisfy the wildcard a raw dot would create. If the project is
    // ever migrated to a new bucket, update this constant in lockstep
    // with .firebaserc and VITE_FIREBASE_STORAGE_BUCKET — and remember
    // to escape every `.` in the new value.
    function FIREBASE_BUCKET() {
      return 'sk8hub-d7806\\.firebasestorage\\.app';
    }

    // Fully-assembled regex literals. The match-resolution `allow update`
    // rule sits right under Firestore's per-evaluation 1000-expression
    // ceiling once main's turn-order seize guard and this PR's video-URL
    // pins are stacked; assembling the pattern via runtime '+'
    // concatenation of FIREBASE_BUCKET() multiplied the expression count
    // at every call site and tipped it over. Returning the finished
    // literal (still REGEX-ESCAPED, still derived from the same bucket
    // value — update both in lockstep with FIREBASE_BUCKET above) keeps
    // each `.matches(...)` to a single string expression.
    //   • download-URL form only (getDownloadURL output) — used by
    //     matchVideoUrl / avatar pins.
    function BUCKET_DL_URL_RE() {
      return '^https://firebasestorage\\.googleapis\\.com/v0/b/sk8hub-d7806\\.firebasestorage\\.app/.+';
    }
    //   • both forms (download-URL + bucket-as-host CDN) — used by
    //     currentTrickVideoUrl / clips.videoUrl.
    function BUCKET_BOTH_FORMS_RE() {
      return '^https://(firebasestorage\\.googleapis\\.com/v0/b/sk8hub-d7806\\.firebasestorage\\.app|sk8hub-d7806\\.firebasestorage\\.app)/.+';
    }

    // ── Helper functions ──

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Admin custom claim ──
    // `admin: true` is minted on the ID token by the Admin SDK (out-of-band
    // console tooling) and can never be self-assigned by a client, so it is a
    // safe authorization signal for the privileged console surfaces:
    // Verified-Pro granting (users/{uid}), badge + gear awarding
    // (users/{uid}/achievements, users/{uid}/locker) and report moderation
    // (reports/{reportId}). The claim only widens WHO may write — every admin
    // path below stays field-scoped, so a stolen admin token still cannot
    // rewrite usernames, inflate stats, or edit a report's evidence.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // ── Ban gate (moderation) ──
    // `users/{uid}.banned` is admin-only (see the admin clause on
    // /users/{uid}); a banned account keeps read access but loses every
    // UGC-producing write: user-source clips, clipVotes and clip comments.
    // The `!exists(...)` branch keeps the gate open for accounts that have
    // no profile doc yet (rules-test contexts and the pre-onboarding
    // window) — absence of a profile is not evidence of a ban.
    //
    // DELIBERATELY NOT APPLIED TO GAME WRITES: /games rules already sit
    // near the 10-document-access / 1000-expression ceiling (see the note
    // above BUCKET_DL_URL_RE), and adding a users get() to every turn
    // action would tip them over. Accepted gap: a banned user can finish
    // an in-flight game. Moderation revokes their feed presence, which is
    // the public surface that matters.
    function notBanned() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) == false;
    }

    function isPlayer(game) {
      return isSignedIn() && (
        request.auth.uid == game.player1Uid ||
        request.auth.uid == game.player2Uid
      );
    }

    // A judge is a non-player third user nominated at game creation who
    // rules on disputes and "Call BS" claims. Judge fields may be null on
    // honor-system games — always guard with 'judgeId' in-check first.
    function isJudge(game) {
      return isSignedIn()
        && 'judgeId' in game
        && game.judgeId != null
        && request.auth.uid == game.judgeId;
    }

    // Game doc is readable by either player OR the nominated judge.
    function isParticipant(game) {
      return isPlayer(game) || isJudge(game);
    }

    // True when a judge is actively seated (accepted the invite). Honor-system
    // rules apply until this is true — no dispute/BS transitions permitted.
    function judgeActive(game) {
      return 'judgeId' in game && game.judgeId != null
        && 'judgeStatus' in game && game.judgeStatus == 'accepted';
    }

    // ── Video-URL bucket pins (audit P2) ──
    // Factored out of the games match-resolution / dispute / clips rules so
    // the bucket-pin predicate doesn't blow the per-rule 1000-expression
    // evaluation ceiling when layered on top of the turn-order seize guard.
    // Semantics are identical to the previous inline checks:
    //   • matchVideoUrlOk: accepts the unchanged value, explicit null, or a
    //     string pinned to FIREBASE_BUCKET() via the getDownloadURL() form.
    //   • videoUrlBucketPinned: the both-forms (download-URL + bucket-as-host
    //     CDN) check used by currentTrickVideoUrl and clips.videoUrl.
    function videoUrlBucketPinned(url) {
      return url is string && url.matches(BUCKET_BOTH_FORMS_RE());
    }

    function matchVideoUrlOk(newUrl, oldUrl) {
      return newUrl == oldUrl
        || newUrl == null
        || (newUrl is string && newUrl.matches(BUCKET_DL_URL_RE()));
    }

    // ── User-uploaded clip video pin ──
    // A user clip is filmed outside a game, so its bytes live under
    // `userClips/{uid}/` in this project's bucket (see storage.rules).
    // Pinning the URL to the CALLER's own prefix stops a user from
    // publishing a feed entry that renders another user's (or another
    // project's) object. Download-URL form only — `getDownloadURL()` is
    // the only way the client obtains this value; the bucket-as-host CDN
    // form is deliberately not accepted here (game clips need it because
    // they copy the games doc value verbatim; user clips do not).
    function userClipVideoUrlOk(url, uid) {
      return url is string
        && url.size() <= 2048
        && url.matches(
          '^https://firebasestorage\\.googleapis\\.com/v0/b/' + FIREBASE_BUCKET() +
          '/o/userClips%2F' + uid + '%2F[A-Za-z0-9_-]+\\.(webm|mp4)(\\?.*)?$'
        );
    }

    // ── User-clip creation rate limit (30s) ──
    // Same two-part idiom as /reports + reports_limits: a pre-state read
    // proves the cooldown elapsed, and a getAfter() on the SAME batch
    // proves the caller advanced the anchor. Unlike the best-effort
    // lastSpotCreatedAt gate, the getAfter() makes the companion write
    // MANDATORY — a client that simply omits it is denied instead of
    // silently skipping the cooldown forever. The anchor lives on
    // users/{uid}.lastClipCreatedAt, pinned to request.time by the owner-
    // update rule, so it cannot be back-dated.
    function clipRateLimitOk() {
      return (
        !('lastClipCreatedAt' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
        || request.time > get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastClipCreatedAt + duration.value(30, 's')
      )
      && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastClipCreatedAt == request.time;
    }

    // ── Clip vote aggregates ──
    // The two counters on /clips are driven exclusively by the caller's own
    // clipVotes/{uid}_{clipId} doc. Every accepted shape below is proven
    // against that doc's pre- and post-write state, so a client can never
    // move a counter without moving its vote in lockstep.
    function clipVoteRef(clipId) {
      return /databases/$(database)/documents/clipVotes/$(request.auth.uid + '_' + clipId);
    }
    // Legacy vote docs pre-date `value` and were all upvotes → default 1.
    function voteValueBefore(clipId) {
      return get(clipVoteRef(clipId)).data.get('value', 1);
    }
    function voteValueAfter(clipId) {
      return getAfter(clipVoteRef(clipId)).data.get('value', 1);
    }
    // Legacy clips pre-date both aggregates → default 0 on BOTH sides so an
    // untouched counter reads as a zero delta rather than an error.
    function clipUpDelta() {
      return request.resource.data.get('upvoteCount', 0) - resource.data.get('upvoteCount', 0);
    }
    function clipDownDelta() {
      return request.resource.data.get('downvoteCount', 0) - resource.data.get('downvoteCount', 0);
    }
    function clipVoteDeltaOk(clipId) {
      return (
        // Vote CAST: doc absent before, present after. The new doc's own
        // `value` decides which counter moves; the other must not budge.
        (!exists(clipVoteRef(clipId)) && existsAfter(clipVoteRef(clipId))
          && (
            (voteValueAfter(clipId) == 1 && clipUpDelta() == 1 && clipDownDelta() == 0)
            || (voteValueAfter(clipId) == -1 && clipDownDelta() == 1 && clipUpDelta() == 0)
          ))
        ||
        // Vote WITHDRAWN: doc present before, absent after. The stored
        // value decides which counter is decremented.
        (exists(clipVoteRef(clipId)) && !existsAfter(clipVoteRef(clipId))
          && (
            (voteValueBefore(clipId) == 1 && clipUpDelta() == -1 && clipDownDelta() == 0)
            || (voteValueBefore(clipId) == -1 && clipDownDelta() == -1 && clipUpDelta() == 0)
          ))
        ||
        // Vote FLIPPED: the same voteId is deleted and re-created inside one
        // transaction — which Firestore coalesces into a single mutation on
        // the vote doc (see the clipVotes flip clause). Both counters move
        // by exactly one, in OPPOSITE directions, and which is which is
        // proven by the stored vs. post-write `value`.
        (exists(clipVoteRef(clipId)) && existsAfter(clipVoteRef(clipId))
          && (
            (voteValueBefore(clipId) == 1 && voteValueAfter(clipId) == -1
              && clipUpDelta() == -1 && clipDownDelta() == 1)
            || (voteValueBefore(clipId) == -1 && voteValueAfter(clipId) == 1
              && clipDownDelta() == -1 && clipUpDelta() == 1)
          ))
      );
    }

    // ── Stats are server-only (client fan-out lockdown) ──
    // wins/losses/lastStatsGameId used to be closed out by client writes
    // (the catch-up loop in the former src/context/GameContext.tsx, gated
    // here by canPeerCloseStats / ownerCanCloseWins / ownerCanCloseLosses).
    // That fan-out corrupted production counters, so it has been removed.
    // Stats are now written EXCLUSIVELY server-side: the applyGameStats
    // Cloud Function (admin SDK, bypasses these rules) increments
    // users/{uid}.wins/.losses exactly once per terminal game, and a
    // one-time admin backfill recomputes counters + deletes the dead
    // lastStatsGameId field. The client stat helpers are therefore gone;
    // clients may never modify these fields (owner-update backstop below)
    // and may never forge the game-side statsApplied flag (games rules).

    // ── turnHistory growth bounds ──
    // Every write path that legitimately appends to `games.turnHistory`
    // (match resolution, dispute resolution, Call BS resolution, expired
    // dispute auto-accept, expired setReview auto-clear) must satisfy BOTH:
    //
    //   (1) size grows by at most ONE entry per write — otherwise a player
    //       could `arrayUnion` a giant batch of fabricated TurnRecords.
    //   (2) absolute size stays ≤ 200 — a SKATE game tops out at roughly
    //       5 letters × 2 players × ~10 attempts per letter, so 200 is a
    //       generous ceiling that still protects against the 1 MB
    //       Firestore doc limit when an attacker inflates TurnRecord blobs.
    //
    // Accepts the same "absent on both sides" and "unchanged" shapes that
    // the non-growth branches use, so write paths that DON'T append
    // (e.g. a judge ruling that doesn't add a turn) still pass cleanly.
    function turnHistoryGrowthOk() {
      return (
        (!('turnHistory' in resource.data) && !('turnHistory' in request.resource.data))
        || (
          'turnHistory' in request.resource.data
          && request.resource.data.turnHistory is list
          && request.resource.data.turnHistory.size() <= 200
          && (
            // Cheap size-based checks FIRST so a growing/unchanged history
            // never reaches the O(n) full-list equality below — that compare
            // over a ~200-element array is the dominant node cost and, summed
            // across the OR-chain of game-update rules, can blow Firestore's
            // 1000-node per-evaluation budget (silent deny). Semantics are
            // unchanged: these clauses are OR'd, so order doesn't affect the
            // accepted set, only evaluation cost.
            //
            // Appended exactly one entry to an existing history array.
            ('turnHistory' in resource.data
              && request.resource.data.turnHistory.size() == resource.data.turnHistory.size() + 1)
            // Unchanged size against an existing history — same size is the
            // common no-append case (judge accept, setReview auto-clear, etc.).
            || ('turnHistory' in resource.data
                && request.resource.data.turnHistory.size() == resource.data.turnHistory.size()
                && request.resource.data.turnHistory == resource.data.turnHistory)
            // First-ever append: resource has no turnHistory yet, request
            // introduces a single-entry list.
            || (!('turnHistory' in resource.data)
                && request.resource.data.turnHistory.size() <= 1)
          )
        )
      );
    }

    // ── Users ──
    // The `users/{uid}` document holds ONLY fields that are safe to expose
    // cross-user (username, stance, wins/losses, isVerifiedPro, …). Any
    // sensitive field — email, emailVerified, dob, parentalConsent, and
    // the `fcmTokens` push-registration list — lives in the private
    // subcollection `users/{uid}/private/*` and is readable only by the
    // owning user. Firestore rules cannot filter fields on reads, so the
    // split at the document boundary is the enforcement mechanism.
    //
    // Historical note: between the April 2026 public/private split rollout
    // and the May 2026 backfill completion, the update rule ran in a
    // transitional form that accepted each sensitive field IFF its value
    // was unchanged from `resource.data` — necessary because legacy docs
    // still carried those fields inline and `request.resource.data` is the
    // merged post-write state. `scripts/migrate-users-private.mjs`
    // completed in production in May 2026, removing every legacy inline
    // occurrence, so the strict `!('X' in request.resource.data)` form has
    // been restored on `update` (matching the long-standing `create` form).
    //
    // Username constraints MUST match `USERNAME_MIN`, `USERNAME_MAX`, and
    // `USERNAME_RE` in src/services/users.ts. Rules are the source of truth
    // at the security boundary; the TS constants exist so the UI can reject
    // invalid input before a round-trip. Update BOTH when changing limits.
    match /users/{uid} {
      // Split read into get/list deliberately. `get` is public so a shared
      // `/player/{uid}` link resolves for a signed-OUT visitor — the link
      // already carries the uid, and this doc holds only fields that are
      // safe to expose (see the public/private split note above). `list`
      // stays signed-in: a public `read` would cover BOTH verbs and let an
      // anonymous client enumerate every account in the app. The only
      // production list queries are getPlayerDirectory / getLeaderboard in
      // src/services/users.ts, both of which run signed-in.
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isOwner(uid)
        // One profile per UID — prevent a race condition from overwriting an existing profile
        && !exists(/databases/$(database)/documents/users/$(uid))
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3  // USERNAME_MIN
        && request.resource.data.username.size() <= 20 // USERNAME_MAX
        // Enforce lowercase alphanumeric + underscore only (matches client-side normalisation)
        && request.resource.data.username.matches('[a-z0-9_]+') // USERNAME_RE body
        // wins/losses must start at zero if present (prevents leaderboard inflation
        // by injecting arbitrary stats at profile creation time)
        && (!('wins' in request.resource.data) || request.resource.data.wins == 0)
        && (!('losses' in request.resource.data) || request.resource.data.losses == 0)
        // Tier-1 stat counters (server-written by applyGameStats) get the same
        // zero-seed treatment: a signup must not mint a streak or games-played
        // history for itself.
        && (!('gamesPlayed' in request.resource.data) || request.resource.data.gamesPlayed == 0)
        && (!('currentWinStreak' in request.resource.data) || request.resource.data.currentWinStreak == 0)
        && (!('bestWinStreak' in request.resource.data) || request.resource.data.bestWinStreak == 0)
        && (!('lettersGiven' in request.resource.data) || request.resource.data.lettersGiven == 0)
        && (!('lettersTaken' in request.resource.data) || request.resource.data.lettersTaken == 0)
        // Binding-dispute stat counters (server-written by the dispute referee)
        // get the same zero-seed treatment — a signup must not mint a dispute
        // history for itself. Written exclusively server-side; see the update
        // backstop below.
        && (!('tricksDisputed' in request.resource.data) || request.resource.data.tricksDisputed == 0)
        && (!('disputesRaised' in request.resource.data) || request.resource.data.disputesRaised == 0)
        && (!('disputesRight' in request.resource.data) || request.resource.data.disputesRight == 0)
        && (!('disputesWrong' in request.resource.data) || request.resource.data.disputesWrong == 0)
        // Pro fields are admin-only — clients cannot set them at creation
        && !('banned' in request.resource.data)
        && !('isVerifiedPro' in request.resource.data)
        && !('verifiedBy' in request.resource.data)
        && !('verifiedAt' in request.resource.data)
        // Sensitive fields MUST live in users/{uid}/private/* instead of
        // the public profile doc. Strict on CREATE — no new doc may
        // introduce them. (Legacy docs are handled by the update rule below.)
        && !('email' in request.resource.data)
        && !('emailVerified' in request.resource.data)
        && !('dob' in request.resource.data)
        && !('parentalConsent' in request.resource.data)
        && !('fcmTokens' in request.resource.data)
        // Rate-limit cooldown anchors are server-managed: the only legitimate
        // writer is the best-effort `setDoc(…, { merge: true })` that fires
        // AFTER a successful game / spot create (see
        // src/services/games.ts and src/services/spots.ts). Seeding them at
        // profile-create time is pure attack surface — a stale value would
        // instantly satisfy the 30s cooldown the first time the user creates
        // a game or spot. Require the fields to be absent on create; the
        // update rule then pins any future write to serverTimestamp().
        && !('lastGameCreatedAt' in request.resource.data)
        && !('lastSpotCreatedAt' in request.resource.data)
        && !('lastClipCreatedAt' in request.resource.data)
        // ── profileImageUrl bucket + UID pinning on CREATE (Codex P1) ──
        // Same anti-phishing predicate as the update rule below: an avatar
        // URL set during initial profile creation MUST match the project
        // bucket + this user's UID, or be null/absent. Without this, a
        // malicious signup could persist an arbitrary external URL on the
        // first write and bypass the update-side guard entirely.
        && (
          !('profileImageUrl' in request.resource.data.keys())
          || request.resource.data.profileImageUrl == null
          || (
            request.resource.data.profileImageUrl is string
            && request.resource.data.profileImageUrl.matches(
              '^https://firebasestorage\\.googleapis\\.com/v0/b/' + FIREBASE_BUCKET() +
              '/o/users%2F' + uid + '%2Favatar\\.(webp|jpeg|png)(\\?.*)?$'
            )
          )
        );
      allow update: if isOwner(uid)
        // ── Privileged-field self-modify guard (F2 — defense in depth) ──
        // `affectedKeys()` is the set of fields whose VALUE actually
        // changed between resource.data and request.resource.data. By
        // gating on `.hasAny([...])` (not `.hasOnly`) we deny any owner
        // update that mutates one of the immutable / admin-only fields
        // below, regardless of which other fields the same write touches.
        //
        // Critically, this works alongside the transitional legacy-field
        // relaxation a few lines down: a legacy doc carrying e.g. `email`
        // inline contributes that field to request.resource.data on every
        // partial update, but it is NOT in affectedKeys() so this guard
        // ignores it. The per-field guards below remain the canonical
        // value-equality check; this clause is the comprehensive backstop
        // that closes self-modify attempts on fields the owner must never
        // touch (createdAt rewrite, isVerifiedPro grant, wins/losses
        // inflation, etc.).
        //
        // Field rationale:
        //   uid, username, createdAt — identity, immutable post-create.
        //   isVerifiedPro, verifiedBy, verifiedAt — admin/console only.
        //   email, emailVerified, dob, parentalConsent, fcmTokens —
        //     legacy sensitive fields; once moved to /private they must
        //     never reappear or be re-written on the public doc.
        //   wins, losses, lastStatsGameId, gamesPlayed, currentWinStreak,
        //     bestWinStreak, lettersGiven, lettersTaken,
        //     tricksDisputed, disputesRaised, disputesRight,
        //     disputesWrong — stats are written exclusively server-side
        //     (applyGameStats Cloud Function + the one-time admin backfill for
        //     win/streak counters; the dispute referee for the four dispute
        //     counters); clients may never modify them. affectedKeys() only contains
        //     fields whose VALUE changes, so legacy docs still carrying
        //     lastStatsGameId keep working for benign profile edits
        //     (stance/avatar) that don't touch it.
        && !(request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['uid', 'username', 'createdAt',
                     'banned',
                     'isVerifiedPro', 'verifiedBy', 'verifiedAt',
                     'email', 'emailVerified', 'dob', 'parentalConsent',
                     'fcmTokens',
                     'wins', 'losses', 'lastStatsGameId',
                     'gamesPlayed', 'currentWinStreak', 'bestWinStreak',
                     'lettersGiven', 'lettersTaken',
                     'tricksDisputed', 'disputesRaised', 'disputesRight', 'disputesWrong']))
        // Cannot change username or uid after creation
        && request.resource.data.username == resource.data.username
        && request.resource.data.uid == resource.data.uid
        // Pro fields are admin-only — clients cannot modify them
        && (!('isVerifiedPro' in request.resource.data) || request.resource.data.isVerifiedPro == resource.data.isVerifiedPro)
        && (!('verifiedBy' in request.resource.data) || request.resource.data.verifiedBy == resource.data.verifiedBy)
        && (!('verifiedAt' in request.resource.data) || request.resource.data.verifiedAt == resource.data.verifiedAt)
        // Sensitive fields live in `users/{uid}/private/*` per the public/
        // private split and are forbidden on the public doc — strict on
        // update, mirroring the create rule above.
        && !('email' in request.resource.data)
        && !('emailVerified' in request.resource.data)
        && !('dob' in request.resource.data)
        && !('parentalConsent' in request.resource.data)
        && !('fcmTokens' in request.resource.data)
        // wins / losses / lastStatsGameId are NOT validated here — they are
        // covered by the affectedKeys().hasAny([...]) immutable backstop
        // above, which denies ANY owner write that changes their value.
        // Stats are server-only now (applyGameStats Cloud Function + admin
        // backfill); there is no client close-out path to gate.
        // lastGameCreatedAt is the server-side 30s game-creation cooldown
        // anchor (see /games create rule). Without this guard, a client
        // could write a stale Timestamp (e.g. epoch 0) to instantly satisfy
        // the `request.time > lastGameCreatedAt + 30s` check and spam games.
        // `request.resource.data` reflects the merged post-write state, so
        // a partial update that doesn't touch the field still carries the
        // stored value through — the three accepted branches are:
        //   (A) neither stored nor post-write have it (no cooldown state yet)
        //   (B) both have it and the value is unchanged (untouched update)
        //   (C) the new value equals request.time (client wrote
        //       serverTimestamp()), which is what the game-create flow does
        //       after addDoc().
        && (
          (!('lastGameCreatedAt' in request.resource.data)
            && !('lastGameCreatedAt' in resource.data))
          || ('lastGameCreatedAt' in resource.data
              && 'lastGameCreatedAt' in request.resource.data
              && request.resource.data.lastGameCreatedAt == resource.data.lastGameCreatedAt)
          || request.resource.data.lastGameCreatedAt == request.time
        )
        // lastSpotCreatedAt is the sibling 30s cooldown anchor for spot
        // creation (see /spots create rule). Exact same attack surface and
        // exact same three-branch guard — kept in lockstep with
        // lastGameCreatedAt above. The spot-create flow writes this via
        // `setDoc(…, { lastSpotCreatedAt: serverTimestamp() }, { merge: true })`
        // in src/services/spots.ts after addDoc().
        && (
          (!('lastSpotCreatedAt' in request.resource.data)
            && !('lastSpotCreatedAt' in resource.data))
          || ('lastSpotCreatedAt' in resource.data
              && 'lastSpotCreatedAt' in request.resource.data
              && request.resource.data.lastSpotCreatedAt == resource.data.lastSpotCreatedAt)
          || request.resource.data.lastSpotCreatedAt == request.time
        )
        // lastClipCreatedAt is the 30s cooldown anchor for user-uploaded
        // clip creation (see the /clips user-source create rule, which
        // getAfter()s this exact field). Identical three-branch guard to
        // the two anchors above: pinning the new value to request.time is
        // what stops a client from seeding epoch 0 and posting unlimited
        // clips.
        && (
          (!('lastClipCreatedAt' in request.resource.data)
            && !('lastClipCreatedAt' in resource.data))
          || ('lastClipCreatedAt' in resource.data
              && 'lastClipCreatedAt' in request.resource.data
              && request.resource.data.lastClipCreatedAt == resource.data.lastClipCreatedAt)
          || request.resource.data.lastClipCreatedAt == request.time
        )
        // ── profileImageUrl bucket + UID pinning (PR-B, audit S5+S12) ──
        // The avatar download URL stored on the profile MUST point at this
        // project's bucket (FIREBASE_BUCKET above) AND at the calling
        // user's own UID — otherwise user A could phish opponents by
        // pointing their public profile at a doppelgänger image hosted on
        // another user's storage path or another project entirely.
        //
        // Three accepted shapes (gated on 'in keys()' so writes that don't
        // touch the field pay nothing here):
        //   (A) field absent on the post-write state → unchanged
        //   (B) field explicitly null → fallback initial-circle / SVG path
        //   (C) field is a string that matches the bucket+uid+ext regex
        //
        // The `(\\?.*)?$` tail accepts the standard `?alt=media&token=…`
        // query the Firebase Storage CDN appends; without it, valid URLs
        // would be rejected the moment the SDK fetched a download URL.
        && (
          !('profileImageUrl' in request.resource.data.keys())
          || request.resource.data.profileImageUrl == null
          || (
            request.resource.data.profileImageUrl is string
            && request.resource.data.profileImageUrl.matches(
              '^https://firebasestorage\\.googleapis\\.com/v0/b/' + FIREBASE_BUCKET() +
              '/o/users%2F' + uid + '%2Favatar\\.(webp|jpeg|png)(\\?.*)?$'
            )
          )
        );
      // ── Verified-Pro grant / revoke (admin custom claim) ──
      // Deliberately a SEPARATE `allow update` clause: Firestore ORs allow
      // rules, so the owner clause above is untouched — its
      // affectedKeys().hasAny([...]) backstop still denies every client
      // self-grant, and a non-admin's accepted set is byte-for-byte what it
      // was before this clause existed. This is the ONLY client path that may
      // change the three pro fields, and it may change NOTHING else:
      // `hasOnly` pins the affected key set so an admin cannot ride a
      // username rewrite or a wins inflation along in the same write.
      // verifiedBy/verifiedAt are the audit trail — pinned to the acting
      // admin and to server time so a grant can never be forged onto another
      // moderator or back-dated.
      //
      // SELF-GRANT IS FORBIDDEN (`uid != request.auth.uid`): a single
      // compromised admin token must not be able to mint its own Verified-Pro
      // badge, and the four-eyes shape means every client-side grant is
      // attributable to a DIFFERENT operator than its subject. Founder / first
      // -admin self-verification is still possible out-of-band via
      // scripts/grant-pro.ts, which runs on the Admin SDK and bypasses these
      // rules entirely — that path is deliberately not client-reachable.
      allow update: if isAdmin()
        && uid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isVerifiedPro', 'verifiedBy', 'verifiedAt'])
        && request.resource.data.isVerifiedPro is bool
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.verifiedAt == request.time;
      // ── Ban / unban (admin custom claim) ──
      // Mirrors the Verified-Pro clause above field-for-field, and for the
      // same reasons: a separate `allow update` so the owner clause is
      // untouched (its affectedKeys().hasAny([...]) backstop now lists
      // 'banned', so an owner can neither ban anyone nor self-unban),
      // `hasOnly(['banned'])` so a ban cannot ride along with a username
      // rewrite, and `uid != request.auth.uid` so a single compromised
      // admin token cannot quietly unban itself.
      allow update: if isAdmin()
        && uid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned'])
        && request.resource.data.banned is bool;
      // NOTE: there is deliberately no peer-write branch. wins/losses were
      // once closed out by either participant (canPeerCloseStats); that
      // client fan-out corrupted counters and has been removed. Stats are
      // written exclusively by the applyGameStats Cloud Function (admin
      // SDK), so the only client `allow update` is the owner branch above,
      // and it can never touch wins/losses/lastStatsGameId.
      // Users may delete their own profile (account deletion flow)
      allow delete: if isOwner(uid);

      // ── Private profile (subcollection) ──
      // Owner-only read/write surface for sensitive fields that must
      // never leak cross-user: email, emailVerified, dob, parentalConsent,
      // and the fcmTokens push-registration list. The canonical doc is
      // `users/{uid}/private/profile`; {docId} is open in the matcher so
      // a future split (e.g. `users/{uid}/private/fcm`) doesn't require
      // a rules change, but every doc stays owner-only.
      //
      // The fcmTokens cap (≤10 entries, must be a list) moves with the
      // field — prevents a compromised client from stuffing an unbounded
      // blob into the push-token list, the same attack the previous
      // guard on the public user doc closed.
      match /private/{docId} {
        allow read: if isOwner(uid);

        // ── fcmTokens cap ──
        // Every push registration write goes here; cap at ≤10 entries
        // (one per device the user is currently signed into). String type
        // is not enforced individually because the FCM SDK opaquely wraps
        // them, but list shape is mandatory.
        function fcmTokensOk() {
          return !('fcmTokens' in request.resource.data)
            || (request.resource.data.fcmTokens is list
                && request.resource.data.fcmTokens.size() <= 10);
        }

        // ── Onboarding field shape validation ──
        // The onboarding service (src/services/onboarding.ts) writes three
        // fields here via setDoc(..., { merge: true }):
        //   - onboardingTutorialVersion: int >= 0  (TUTORIAL_VERSION bump
        //                                            is monotonic; null is
        //                                            valid only via the
        //                                            explicit reset path)
        //   - onboardingCompletedAt:    serverTimestamp() | null | timestamp ≤ now+5s
        //   - onboardingSkippedAt:      serverTimestamp() | null | timestamp ≤ now+5s
        //
        // Without these checks a malicious client can stuff arbitrary
        // shapes ("attack", { nested: true }, etc.) into the private doc
        // and wedge readers in src/services/onboarding.ts that do
        // `typeof === "number"` / Timestamp duck-typing. Each predicate is
        // gated on `field in request.resource.data` so unrelated writes
        // (fcmTokens, emailVerified, etc.) pay zero validation cost.
        //
        // The serverTimestamp() sentinel is detected via the same idiom
        // already in use elsewhere in this file (see lastGameCreatedAt /
        // lastSpotCreatedAt above): when the client uses the sentinel,
        // `request.resource.data.field == request.time`.
        function onboardingTutorialVersionOk() {
          return !('onboardingTutorialVersion' in request.resource.data)
            || request.resource.data.onboardingTutorialVersion == null
            || (request.resource.data.onboardingTutorialVersion is int
                && request.resource.data.onboardingTutorialVersion >= 0);
        }
        function onboardingCompletedAtOk() {
          return !('onboardingCompletedAt' in request.resource.data)
            || request.resource.data.onboardingCompletedAt == null
            || request.resource.data.onboardingCompletedAt == request.time
            || (request.resource.data.onboardingCompletedAt is timestamp
                && request.resource.data.onboardingCompletedAt <= request.time + duration.value(5, 's'));
        }
        function onboardingSkippedAtOk() {
          return !('onboardingSkippedAt' in request.resource.data)
            || request.resource.data.onboardingSkippedAt == null
            || request.resource.data.onboardingSkippedAt == request.time
            || (request.resource.data.onboardingSkippedAt is timestamp
                && request.resource.data.onboardingSkippedAt <= request.time + duration.value(5, 's'));
        }

        // ── Allowlist of accepted keys ──
        // Every key currently written to users/{uid}/private/profile by
        // the codebase. Keep in sync with UserPrivateProfile in
        // src/services/users.ts and the onboarding writers in
        // src/services/onboarding.ts. An unknown key here is a bug or an
        // attack — fail closed.
        function privateProfileKeysOk() {
          return request.resource.data.keys().hasOnly([
            'emailVerified',
            'dob',
            'parentalConsent',
            'fcmTokens',
            'onboardingTutorialVersion',
            'onboardingCompletedAt',
            'onboardingSkippedAt'
          ]);
        }

        allow create: if isOwner(uid)
          && privateProfileKeysOk()
          && fcmTokensOk()
          && onboardingTutorialVersionOk()
          && onboardingCompletedAtOk()
          && onboardingSkippedAtOk();
        allow update: if isOwner(uid)
          && privateProfileKeysOk()
          && fcmTokensOk()
          && onboardingTutorialVersionOk()
          && onboardingCompletedAtOk()
          && onboardingSkippedAtOk();
        allow delete: if isOwner(uid);
      }

      // ── Blocked Users (subcollection) ──
      // Each user maintains their own block list.  Only the owner can
      // create, read, or delete entries.  Blocking is bidirectional at
      // the application layer — game creation checks both directions.
      match /blocked_users/{blockedUid} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.blockedUid == blockedUid
          && request.resource.data.blockedUid is string
          // Cannot block yourself
          && blockedUid != uid;
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      // ── Achievements (subcollection) ──
      // Earned-achievement records. Grants are PRIVILEGED writes: either the
      // Admin SDK (server-side award pipeline, bypasses these rules) or an
      // operator holding the `admin: true` custom claim (console award).
      // Ordinary clients never mint or mutate them. The owner needs DELETE so
      // the account-deletion batch in src/services/users.ts (~345-353) can
      // wipe them atomically alongside /private + the parent user doc; under
      // default-deny that batch fails closed and breaks GDPR erasure.
      match /achievements/{achievementId} {
        // Badges are public reputation — any signed-in user renders them on
        // another skater's profile (/player/:uid).
        allow read: if isSignedIn();
        // Award shape is pinned exactly: no extra keys (a badge that carries
        // client-chosen fields becomes an unbounded write surface),
        // server-stamped earnedAt, bounded human-readable reason.
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['earnedAt', 'reason'])
          && request.resource.data.earnedAt == request.time
          && request.resource.data.reason is string
          && request.resource.data.reason.size() <= 200;
        // A badge is never edited — a wrong award is revoked and re-issued,
        // which keeps earnedAt honest.
        allow update: if false;
        // Owner: GDPR erasure batch. Admin: revoke a wrongly-awarded badge.
        allow delete: if isOwner(uid) || isAdmin();
      }

      // ── Locker (subcollection) ──
      // Owned economy items (gear/cosmetics). Same posture as /achievements:
      // minted by the Admin SDK award pipeline or by an `admin: true` console
      // operator, deletable by the owner so the account-deletion batch stays
      // atomic.
      match /locker/{itemId} {
        // Equipped gear is public reputation, shown on /player/:uid. Ordinary
        // client create/update is denied outright — a client that can mint
        // gear has no economy.
        allow read: if isSignedIn();
        // Exact item shape. Every listed key is required in practice: the
        // per-field checks below read each one, so a create that omits any of
        // them fails closed. Strings are length-capped (an award is metadata,
        // not a payload channel) and acquiredAt is server-stamped.
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(
               ['type', 'brand', 'name', 'imageUrl', 'rarity', 'acquiredAt', 'provenance'])
          && request.resource.data.type is string
          && request.resource.data.type.size() <= 100
          && request.resource.data.brand is string
          && request.resource.data.brand.size() <= 100
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.rarity is string
          && request.resource.data.rarity.size() <= 100
          && (request.resource.data.imageUrl == null || request.resource.data.imageUrl is string)
          && request.resource.data.acquiredAt == request.time
          // provenance is the award's audit note; only a bounded `reason`.
          && request.resource.data.provenance is map
          && request.resource.data.provenance.keys().hasOnly(['reason'])
          && request.resource.data.provenance.reason is string
          && request.resource.data.provenance.reason.size() <= 200;
        // Items are immutable once awarded — re-award instead of editing, so
        // acquiredAt and provenance stay truthful.
        allow update: if false;
        // Owner: GDPR erasure batch. Admin: revoke wrongly-awarded gear.
        allow delete: if isOwner(uid) || isAdmin();
      }
    }

    // ── Usernames (reservation docs for uniqueness) ──
    // Same constraints as users/{uid}.username above — keep in sync with
    // USERNAME_MIN/MAX/RE in src/services/users.ts.
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && username.size() >= 3  // USERNAME_MIN
        && username.size() <= 20 // USERNAME_MAX
        // Reservation key must be a valid username (lowercase alphanum + underscore)
        && username.matches('[a-z0-9_]+'); // USERNAME_RE body
      // Cannot be updated; only the owning user can delete (account deletion flow)
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ── Helper: determine the opponent of a player ──
    function opponentUid(game, uid) {
      return uid == game.player1Uid ? game.player2Uid : game.player1Uid;
    }

    // ── Match-resolution turn-order seize guard (P0) ──
    // Extracted from the matching-phase `allow update` rule (PR
    // claude/video-url-security) and flattened so the matching→* resolution
    // write stays under Firestore's per-evaluation node ceiling once main's
    // #373 seize guard and this PR's matchVideoUrl `.matches()` pin both apply.
    // Cheap phase/status discriminators are checked first in each branch so the
    // OR short-circuits before the costlier judgeActive()/opponentUid() calls.
    //
    // The accepted set is IDENTICAL to main's inline four-branch form — the
    // shared `status == 'active' && winner == null` invariant of every
    // non-completion outcome is hoisted once; completion (status == 'complete')
    // is the lone remaining alternative. No new states are admitted. `cur` is
    // resource.data, `nxt` is request.resource.data. Per-outcome pins:
    //   • missed-continues (games.match.ts 315-321):
    //       currentSetter UNCHANGED, turnNumber +1, currentTurn == currentSetter
    //   • completion (312-314): currentSetter + turnNumber UNCHANGED,
    //       winner = opponent of the player who hit 5 letters
    //   • honor+landed (222-233): currentSetter ROTATES to the matcher
    //       (opponentUid(currentSetter)), currentTurn follows, turnNumber +1
    //   • judge landed→disputable (169-176) / Call BS→setReview
    //       (games.judge.ts 45-51): currentSetter + turnNumber UNCHANGED,
    //       currentTurn routes to the judge
    function matchResolutionPinsOk(cur, nxt) {
      return (
        nxt.status == 'active' && nxt.winner == null && (
          // Missed — setter keeps the role, turnNumber +1, currentTurn pinned
          // to the (unchanged) currentSetter.
          (nxt.phase == 'setting'
           && nxt.currentSetter == cur.currentSetter
           && nxt.turnNumber == cur.turnNumber + 1
           && nxt.currentTurn == cur.currentSetter)
          // Honor system + landed — roles swap; currentSetter ROTATES to the
          // matcher, currentTurn follows, turnNumber +1, letters unchanged,
          // judge must NOT be active.
          //
          // ── BACKWARD-COMPAT: today's client still uses this instant-swap arm.
          // The binding-dispute rollout (Phase 2) ADDS the pendingReview freeze
          // arm below alongside it; this instant-swap arm is intentionally LEFT
          // UNCHANGED so the current production client (which resolves a landed
          // claim by swapping roles immediately) keeps working through the
          // rules auto-deploy. FUTURE follow-up — once the new freeze-first
          // client has fully rolled out — remove THIS arm to make the freeze
          // mandatory. Do NOT remove it now.
          || (nxt.phase == 'setting'
              && nxt.p1Letters == cur.p1Letters
              && nxt.p2Letters == cur.p2Letters
              && nxt.currentSetter == opponentUid(cur, cur.currentSetter)
              && nxt.currentTurn == nxt.currentSetter
              && nxt.turnNumber == cur.turnNumber + 1
              && !judgeActive(cur))
          // Honor system + landed, BINDING-DISPUTE FREEZE (Phase 2) — NEW arm.
          // Instead of the instant swap above, the matcher's landed submission
          // FREEZES the game in pendingReview so the setter gets a 24h
          // accept/dispute window (resolved by the pendingReview allow-update
          // branch below). NOTHING resolves on this write: currentSetter,
          // currentTurn, turnNumber, letters and turnHistory are ALL pinned
          // unchanged (no TurnRecord appended — the turn is not over).
          // reviewFor names the matcher (opponent of the current setter, which
          // in matching phase is cur.currentTurn); reviewDeadline is a fresh
          // future timestamp (the 24h accept window). Honor-only: judge must
          // NOT be active. matchVideoUrl is bucket-pinned by matchVideoUrlOk in
          // the enclosing rule; statsApplied by statsAppliedUnchanged().
          || (nxt.phase == 'pendingReview'
              && nxt.reviewFor == opponentUid(cur, cur.currentSetter)
              && nxt.currentSetter == cur.currentSetter
              && nxt.currentTurn == cur.currentTurn
              && nxt.turnNumber == cur.turnNumber
              && nxt.p1Letters == cur.p1Letters
              && nxt.p2Letters == cur.p2Letters
              && nxt.turnHistory == cur.turnHistory
              && nxt.reviewDeadline is timestamp
              && nxt.reviewDeadline > request.time
              && !judgeActive(cur))
          // Judge-active landed→disputable OR Call BS→setReview — letters
          // unchanged, currentSetter + turnNumber UNCHANGED, currentTurn → judge.
          || ((nxt.phase == 'disputable' || nxt.phase == 'setReview')
              && nxt.currentTurn == cur.judgeId
              && nxt.currentSetter == cur.currentSetter
              && nxt.turnNumber == cur.turnNumber
              && nxt.p1Letters == cur.p1Letters
              && nxt.p2Letters == cur.p2Letters
              && judgeActive(cur))
        )
      )
      // Completion: winner pinned to the opponent of the player who hit 5
      // letters; currentSetter + turnNumber UNCHANGED. currentTurn is NOT
      // pinned — no further game update is permitted once complete.
      || (nxt.status == 'complete'
          && nxt.winner != null
          && nxt.currentSetter == cur.currentSetter
          && nxt.turnNumber == cur.turnNumber
          && (
            (nxt.p1Letters >= 5 && nxt.winner == cur.player2Uid)
            || (nxt.p2Letters >= 5 && nxt.winner == cur.player1Uid)
          ));
    }

    // ── Expired-dispute auto-accept role/turn pins (audit HIGH: turn seize) ──
    // Auto-accept means the matcher's "landed" call stands and roles swap —
    // currentSetter rotates to the matcher (the setter's opponent), currentTurn
    // follows, turnNumber +1 (verified against turnForfeit.shared.ts's
    // disputeAccept branch and the honor-system-landed arm of
    // matchResolutionPinsOk). Without these pins either participant could seize
    // the setter role out of rotation in this same write.
    function autoAcceptRolePinsOk(cur, nxt) {
      return nxt.currentSetter == opponentUid(cur, cur.currentSetter)
        && nxt.currentTurn == nxt.currentSetter
        && nxt.turnNumber == cur.turnNumber + 1;
    }

    // ── statsApplied is server-only (stats fan-out lockdown) ──
    // `statsApplied` on a game doc is written EXCLUSIVELY by the
    // applyGameStats Cloud Function (admin SDK, bypasses these rules): it
    // flips to true inside the same transaction that credits wins/losses
    // for a terminal game, exactly once. A client must never introduce or
    // change it — pre-setting statsApplied:true would make the Cloud
    // Function treat the game as already-credited and skip the loser's loss
    // forever. Every /games update branch pins it to its stored value via
    // this helper, and the create rule forbids it outright.
    //
    // Presence-pair form (NOT request.resource.data.get('statsApplied',
    // false)) on purpose: the .get()-with-default idiom trips the "Null
    // value error" engine quirk documented on the spotId immutability pin
    // in the games match below. This helper reads no documents — plain
    // field comparison — so it adds negligible node cost to each branch
    // (and net expression budget improves now that the three get()-heavy
    // stat helpers are gone).
    function statsAppliedUnchanged() {
      return (!('statsApplied' in resource.data) && !('statsApplied' in request.resource.data))
        || ('statsApplied' in resource.data && 'statsApplied' in request.resource.data
            && request.resource.data.statsApplied == resource.data.statsApplied);
    }

    // ── judgeUsername is bound at create, immutable on every update ──
    // The create rule binds judgeUsername to the judge's authoritative
    // users/{judgeId}.username (username-impersonation guard). Judge
    // assignment only ever happens at create — no update path legitimately
    // rewrites it (accept/decline flips only judgeStatus) — so every /games
    // update branch pins it to its stored value here. Presence-tolerant
    // (mirrors the judgeId pins) so honor-system games (judgeUsername null)
    // and any legacy doc that predates the field both pass. Reads no
    // documents — plain field comparison — so it adds negligible node cost.
    function judgeUsernameUnchanged() {
      return (!('judgeUsername' in resource.data) && !('judgeUsername' in request.resource.data))
        || ('judgeUsername' in resource.data && 'judgeUsername' in request.resource.data
            && request.resource.data.judgeUsername == resource.data.judgeUsername);
    }

    // ── Games ──
    match /games/{gameId} {
      // Players AND the nominated judge can read the game document.
      allow read: if isSignedIn() && isParticipant(resource.data);

      // Any signed-in user with a verified email can create a game (as player1).
      // Email verification is enforced server-side here so it can't be bypassed
      // by calling the Firestore API directly (e.g. from the browser console).
      // Rate limit: user profile must have been updated > 30s ago (prevents spam creation).
      allow create: if isSignedIn()
        && request.auth.token.email_verified == true
        && request.resource.data.player1Uid == request.auth.uid
        // Prevent self-challenge: player2 must be a different account
        && request.resource.data.player2Uid != request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.p1Letters == 0
        && request.resource.data.p2Letters == 0
        && request.resource.data.turnNumber == 1
        && request.resource.data.winner == null
        // Challenger always has the first turn and sets first trick
        && request.resource.data.currentTurn == request.auth.uid
        && request.resource.data.phase == 'setting'
        && request.resource.data.currentSetter == request.auth.uid
        // turnDeadline must be a future timestamp (prevents instant-forfeit attack:
        // without this, a malicious client could set turnDeadline in the past,
        // currentTurn to the opponent, and immediately forfeit them).
        // Upper bound prevents the inverse attack: without a cap, a client
        // could set turnDeadline to Timestamp.fromMillis(Number.MAX_SAFE_INTEGER)
        // and permanently block the opponent's forfeit path (forfeit needs
        // request.time > resource.data.turnDeadline). 48h is 2× the production
        // TURN_DURATION_MS (24h) — tight enough to prevent abuse, loose enough
        // to tolerate clock skew and retry windows.
        && request.resource.data.turnDeadline is timestamp
        && request.resource.data.turnDeadline > request.time
        && request.resource.data.turnDeadline < request.time + duration.value(48, 'h')
        // Trick/video fields must start empty
        && request.resource.data.currentTrickName == null
        && request.resource.data.currentTrickVideoUrl == null
        && request.resource.data.matchVideoUrl == null
        // Optional spotId must be a string if present (location context for
        // the challenge — clients validate UUID shape, rules enforce the
        // coarser type invariant).
        && (
          !('spotId' in request.resource.data)
          || (request.resource.data.spotId is string
              && request.resource.data.spotId.size() <= 64)
        )
        // Optional trickCategory (game-level trick filter): absent, or exactly
        // one of the known values. Mirrors spotId — set once and immutable
        // thereafter (legacy clients omit it, so presence stays optional).
        && (
          !('trickCategory' in request.resource.data)
          || request.resource.data.trickCategory in ['any', 'flip', 'grind', 'gap', 'air', 'manual', 'oldschool',
                                                      'flatground', 'switch', 'flatbar', 'transition', 'team2v2', 'custom']
        )
        // Optional customRules (challenger free-text, only meaningful when
        // trickCategory == 'custom'): absent, null, or a bounded string. The
        // client sanitizes/caps at 120 chars; the rule enforces the coarser
        // type + length invariant. Immutable after creation like trickCategory.
        && (
          !('customRules' in request.resource.data)
          || request.resource.data.customRules == null
          || (request.resource.data.customRules is string
              && request.resource.data.customRules.size() <= 120)
        )
        // Judge fields must be present with correct shape. judgeId can be
        // null (honor system) or a non-player string UID. When judgeId is
        // set, judgeStatus must start as 'pending'. When null, judgeStatus
        // must also be null. This keeps invariants enforceable for updates.
        && (
          !('judgeId' in request.resource.data)
          || request.resource.data.judgeId == null
          || (request.resource.data.judgeId is string
              && request.resource.data.judgeId != request.auth.uid
              && request.resource.data.judgeId != request.resource.data.player2Uid)
        )
        && (
          !('judgeStatus' in request.resource.data)
          || (request.resource.data.judgeId == null && request.resource.data.judgeStatus == null)
          || (request.resource.data.judgeId != null && request.resource.data.judgeStatus == 'pending')
        )
        // ── Username impersonation guard (audit MEDIUM) ──
        // The denormalized username fields fan out into turnHistory, clips,
        // and disputes, so a create that stamps an arbitrary/victim handle
        // would let that handle masquerade across the app. Bind each to the
        // authoritative users/{uid}.username. player1Uid == auth.uid (pinned
        // above) so this get() reuses the already-fetched users/{auth.uid}
        // (+0 reads); player2 is one read; the judge one more when present —
        // well under the 10-document access ceiling for this rule.
        && request.resource.data.player1Username ==
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username
        && request.resource.data.player2Username ==
             get(/databases/$(database)/documents/users/$(request.resource.data.player2Uid)).data.username
        // judgeUsername binds only when a judge is nominated; honor-system
        // games carry judgeId == null and store judgeUsername null (no get).
        && (
          !('judgeId' in request.resource.data)
          || request.resource.data.judgeId == null
          || request.resource.data.judgeUsername ==
               get(/databases/$(database)/documents/users/$(request.resource.data.judgeId)).data.username
        )
        // Rate limit: at most one game creation per 30 seconds per user.
        // Checks the user's lastGameCreatedAt field — if it doesn't exist
        // (first game ever) the condition is satisfied automatically.
        && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || !('lastGameCreatedAt' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          || request.time > get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastGameCreatedAt + duration.value(30, 's')
        )
        // Block check: neither player may have blocked the other.
        // Uses exists() against both directions of the blocked_users subcollection.
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked_users/$(request.resource.data.player2Uid))
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.player2Uid)/blocked_users/$(request.auth.uid))
        // statsApplied is server-only — a client that pre-seeds it at
        // creation would make applyGameStats skip crediting this game.
        && !('statsApplied' in request.resource.data);

      // Current-turn player can make normal game updates
      allow update: if isSignedIn()
        && isPlayer(resource.data)
        && resource.data.status == 'active'
        // Early phase gate (PR claude/video-url-security): every branch of this
        // rule already requires resource.data.phase == 'setting'. Hoisting it
        // to the top fails matching-phase writes BEFORE they reach the
        // expensive currentTrickVideoUrl `.matches()` below — without this, a
        // matcher's resolution write burns this rule's regex node cost on its
        // way to the match-resolution rule, and the two `.matches()` calls
        // together blow Firestore's cumulative 1000-expression evaluation
        // budget for the request (silent PERMISSION_DENIED). Pure
        // optimization: the accepted set is unchanged.
        && resource.data.phase == 'setting'
        && request.auth.uid == resource.data.currentTurn
        // Rate limit: at most one turn action per 2 seconds (prevents write flooding).
        // The cooldown below compares against the STORED updatedAt; without
        // also pinning the NEW updatedAt to request.time, a client could write
        // a stale value (e.g. epoch 0) and permanently satisfy the check.
        // Mirrors the same hardening on notification_limits / nudge_limits.
        && 'updatedAt' in request.resource.data
        && request.resource.data.updatedAt == request.time
        && (
          !('updatedAt' in resource.data)
          || resource.data.updatedAt == null
          || request.time > resource.data.updatedAt + duration.value(2, 's')
        )
        // Cannot change player UIDs or usernames
        && request.resource.data.player1Uid == resource.data.player1Uid
        && request.resource.data.player2Uid == resource.data.player2Uid
        && request.resource.data.player1Username == resource.data.player1Username
        && request.resource.data.player2Username == resource.data.player2Username
        // spotId is set at creation and immutable thereafter. Explicit `in`
        // checks here rather than .get(field, null) because the latter
        // throws "Null value error" in current Firestore rules engines.
        && (
          (!('spotId' in resource.data) && !('spotId' in request.resource.data))
          || ('spotId' in resource.data && 'spotId' in request.resource.data
              && request.resource.data.spotId == resource.data.spotId)
        )
        // trickCategory is set at creation and immutable thereafter (mirrors
        // spotId's presence-tolerant pin above).
        && (
          (!('trickCategory' in resource.data) && !('trickCategory' in request.resource.data))
          || ('trickCategory' in resource.data && 'trickCategory' in request.resource.data
              && request.resource.data.trickCategory == resource.data.trickCategory)
        )
        // customRules pairs with trickCategory: set at creation, immutable
        // thereafter (a mid-game rewrite of the agreed rules is not allowed).
        && (
          (!('customRules' in resource.data) && !('customRules' in request.resource.data))
          || ('customRules' in resource.data && 'customRules' in request.resource.data
              && request.resource.data.customRules == resource.data.customRules)
        )
        // Judge identity is immutable after creation. judgeStatus may only
        // change via dedicated accept/decline rules below.
        && (
          (!('judgeId' in resource.data) && !('judgeId' in request.resource.data))
          || ('judgeId' in resource.data && 'judgeId' in request.resource.data
              && request.resource.data.judgeId == resource.data.judgeId)
        )
        && (
          (!('judgeStatus' in resource.data) && !('judgeStatus' in request.resource.data))
          || ('judgeStatus' in resource.data && 'judgeStatus' in request.resource.data
              && request.resource.data.judgeStatus == resource.data.judgeStatus)
        )
        // currentTurn must always be one of the two players after the update
        && (
          request.resource.data.currentTurn == resource.data.player1Uid ||
          request.resource.data.currentTurn == resource.data.player2Uid
        )
        // turnDeadline must be a timestamp bounded to a sane future window.
        // See the create rule above for the rationale on the 48h upper bound
        // (blocks opponent-lockout via Timestamp.fromMillis(MAX_SAFE_INTEGER)).
        && request.resource.data.turnDeadline is timestamp
        && request.resource.data.turnDeadline > request.time
        && request.resource.data.turnDeadline < request.time + duration.value(48, 'h')
        // Scores must not change during setting-phase updates.
        // Letters are only awarded via the match resolution rule below.
        && request.resource.data.p1Letters == resource.data.p1Letters
        && request.resource.data.p2Letters == resource.data.p2Letters
        // Game stays active, no winner (completion only via match resolution or forfeit)
        && request.resource.data.status == 'active'
        && request.resource.data.winner == null
        // matchVideoUrl is only written by the matching-phase rule — setting
        // phase updates must not touch it. Without this pin, a setter whose
        // currentTurn == uid could stash a match video and then forge a
        // subsequent matching→setting forfeit/resolution against it.
        && request.resource.data.matchVideoUrl == resource.data.matchVideoUrl
        // Valid phase transitions only (prevents skipping phases). Each
        // branch pins the exact fields that MUST change and the ones that
        // MUST NOT — without these pins, the setter could rewrite
        // currentSetter / turnNumber / trick fields to forge a state where
        // the opponent's turnDeadline has already expired, and then invoke
        // the forfeit branch below to win unilaterally.
        && (
          // setting → matching (setter sets a trick)
          //   • currentSetter stays put (role doesn't change until the match resolves)
          //   • turn swaps to the matcher (opponent of the setter)
          //   • turnNumber is unchanged (phase change within the same turn)
          //   • currentTrickName / currentTrickVideoUrl are populated with the set trick
          (resource.data.phase == 'setting'
           && request.resource.data.phase == 'matching'
           && request.resource.data.currentSetter == resource.data.currentSetter
           && request.resource.data.currentTurn == opponentUid(resource.data, resource.data.currentSetter)
           && request.resource.data.turnNumber == resource.data.turnNumber
           && request.resource.data.currentTrickName is string
           && request.resource.data.currentTrickName.size() > 0
           && request.resource.data.currentTrickName.size() <= 64
           // Pin trick-video URL to THIS project's Firebase Storage bucket
           // only. The legacy regex accepted any `*.firebasestorage.app`
           // subdomain — which matches ATTACKER-PROJECT.firebasestorage.app
           // and lets a setter point currentTrickVideoUrl at another
           // project's storage (referrer/exfil, NSFW/malicious media in
           // the matcher recorder UI, content-spoof in the clip feed).
           // videoUrlBucketPinned() accepts both forms (getDownloadURL() and
           // the bucket-as-host CDN form). Mirrors the matchVideoUrl +
           // clips.videoUrl pins below.
           && videoUrlBucketPinned(request.resource.data.currentTrickVideoUrl))
          // setting → setting (setter failed to land, turn passes to opponent)
          //   • currentSetter MUST flip to the other player (the whole point of
          //     failSetTrick is the role passes) — this is the invariant the
          //     exploit targets: without it, the setter could keep the role and
          //     merely reassign currentTurn to the opponent
          //   • currentTurn follows currentSetter (new setter sets first)
          //   • turnNumber strictly increments (fresh turn)
          //   • trick fields reset to null (no trick set yet this turn)
          || (resource.data.phase == 'setting'
              && request.resource.data.phase == 'setting'
              && request.resource.data.currentSetter == opponentUid(resource.data, resource.data.currentSetter)
              && request.resource.data.currentTurn == request.resource.data.currentSetter
              && request.resource.data.turnNumber == resource.data.turnNumber + 1
              && request.resource.data.currentTrickName == null
              && request.resource.data.currentTrickVideoUrl == null)
        )
        // turnHistory must not change during setting-phase updates
        && (
          (!('turnHistory' in resource.data) && !('turnHistory' in request.resource.data))
          || request.resource.data.turnHistory == resource.data.turnHistory
        )
        && judgeUsernameUnchanged()
        && statsAppliedUnchanged();

      // ── Match resolution (matcher submits an attempt) ──
      // Honor system (no active judge):
      //   • missed  → matcher +1 letter, phase=setting (or complete)
      //   • landed  → matcher's call stands; roles swap, phase=setting
      // With active judge:
      //   • missed  → matcher +1 letter (matcher admitting doesn't dispute)
      //   • landed  → phase=disputable, currentTurn routes to judge
      //
      // Call BS (judge only): matcher transitions matching → setReview with
      // currentTurn = judgeId. Split out as its own branch for clarity.
      allow update: if isSignedIn()
        && isPlayer(resource.data)
        && resource.data.status == 'active'
        && resource.data.phase == 'matching'
        && request.auth.uid == resource.data.currentTurn
        // Rate limit. New updatedAt must equal request.time — prevents the
        // stored-value spoof where a client writes epoch 0 to keep the 2s
        // cooldown permanently satisfied. Same pattern as notification_limits.
        && 'updatedAt' in request.resource.data
        && request.resource.data.updatedAt == request.time
        && (
          !('updatedAt' in resource.data)
          || resource.data.updatedAt == null
          || request.time > resource.data.updatedAt + duration.value(2, 's')
        )
        // Cannot change player UIDs or usernames
        && request.resource.data.player1Uid == resource.data.player1Uid
        && request.resource.data.player2Uid == resource.data.player2Uid
        && request.resource.data.player1Username == resource.data.player1Username
        && request.resource.data.player2Username == resource.data.player2Username
        // spotId immutable
        && (
          (!('spotId' in resource.data) && !('spotId' in request.resource.data))
          || ('spotId' in resource.data && 'spotId' in request.resource.data
              && request.resource.data.spotId == resource.data.spotId)
        )
        // trickCategory immutable (mirrors spotId)
        && (
          (!('trickCategory' in resource.data) && !('trickCategory' in request.resource.data))
          || ('trickCategory' in resource.data && 'trickCategory' in request.resource.data
              && request.resource.data.trickCategory == resource.data.trickCategory)
        )
        // customRules pairs with trickCategory: set at creation, immutable
        // thereafter (a mid-game rewrite of the agreed rules is not allowed).
        && (
          (!('customRules' in resource.data) && !('customRules' in request.resource.data))
          || ('customRules' in resource.data && 'customRules' in request.resource.data
              && request.resource.data.customRules == resource.data.customRules)
        )
        // Judge identity + status immutable during match resolution
        && (
          (!('judgeId' in resource.data) && !('judgeId' in request.resource.data))
          || ('judgeId' in resource.data && 'judgeId' in request.resource.data
              && request.resource.data.judgeId == resource.data.judgeId)
        )
        && (
          (!('judgeStatus' in resource.data) && !('judgeStatus' in request.resource.data))
          || ('judgeStatus' in resource.data && 'judgeStatus' in request.resource.data
              && request.resource.data.judgeStatus == resource.data.judgeStatus)
        )
        // turnDeadline must be a timestamp bounded to a sane future window
        // (see create rule for rationale on the 48h cap).
        && request.resource.data.turnDeadline is timestamp
        && request.resource.data.turnDeadline > request.time
        && request.resource.data.turnDeadline < request.time + duration.value(48, 'h')
        // Letters: at most one player gains exactly one letter (missed) or none change (landed)
        && (
          // No letter change (landed path, both honor + judge)
          (request.resource.data.p1Letters == resource.data.p1Letters
           && request.resource.data.p2Letters == resource.data.p2Letters)
          // Missed — the MATCHER (== resource.data.currentTurn) takes exactly
          // one letter; the opponent's letters stay unchanged. The +1 is bound
          // to the current-turn player so a losing matcher cannot assign their
          // missed letter to the opponent and forge a win via the completion
          // branch below (audit CRITICAL: win forgery).
          || (resource.data.currentTurn == resource.data.player1Uid
              && request.resource.data.p1Letters == resource.data.p1Letters + 1
              && request.resource.data.p2Letters == resource.data.p2Letters)
          || (resource.data.currentTurn == resource.data.player2Uid
              && request.resource.data.p2Letters == resource.data.p2Letters + 1
              && request.resource.data.p1Letters == resource.data.p1Letters)
        )
        // ── matchVideoUrl bucket pin (audit P2) ──
        // The matcher writes their attempt video here. Without this pin a
        // matcher could stash an arbitrary HTTPS URL (or another project's
        // bucket) into matchVideoUrl, which then flows verbatim into the
        // dispute UI and the cross-game clip feed — referrer/exfil vector
        // and content-spoof surface. Accepted shapes mirror the
        // profileImageUrl pin above: unchanged, explicit null, or a string
        // matching the project bucket regex.
        && matchVideoUrlOk(request.resource.data.matchVideoUrl, resource.data.matchVideoUrl)
        // turnHistory growth bound — cap appends to 1 per write and total
        // size to 200 entries. Prevents a 1 MB TurnRecord balloon attack
        // against the Firestore doc-size ceiling. Evaluated BEFORE the seize
        // guard so its cheap size-based fast path runs while node budget is
        // plentiful (the O(n) full-list compare is gated behind a size check
        // and skipped on the append path — see turnHistoryGrowthOk).
        && turnHistoryGrowthOk()
        // ── Turn-order seize guard (P0) ──
        // Extracted to matchResolutionPinsOk() so this rule stays under
        // Firestore's per-evaluation node ceiling once main's #373 guard and
        // this PR's matchVideoUrl `.matches()` pin are both present. Accepted
        // set is unchanged — see the helper for the per-outcome rationale.
        && matchResolutionPinsOk(resource.data, request.resource.data)
        && judgeUsernameUnchanged()
        && statsAppliedUnchanged();

      // ── Pending-review resolution (honor-system binding dispute, Phase 2) ──
      // A matcher's landed claim now freezes the game in `pendingReview` (see
      // the pendingReview arm of matchResolutionPinsOk above) instead of
      // instantly swapping roles. From the frozen state ONLY the SETTER — the
      // player whose trick was matched, i.e. resource.data.currentSetter — has
      // two legal moves, and this branch is the ONLY client write out of
      // pendingReview:
      //   (a) ACCEPT  → setting        : the deferred honor swap. Roles rotate
      //       to the matcher, currentTurn follows, turnNumber +1, ONE landed
      //       TurnRecord appended, review fields cleared. Identical net effect
      //       to today's instant honor-landed resolution, just deferred.
      //   (b) DISPUTE → communityReview: hand the call to the crowd. Roles,
      //       turnNumber, letters and turnHistory ALL stay frozen; reviewFor
      //       keeps naming the matcher; reviewDeadline is reset to a fresh vote
      //       window. The dispute doc (disputes/{gameId}_{turnNumber}) is
      //       created in the SAME transaction — its create rule binds to this
      //       still-pendingReview game state (Gap A closure, see /disputes).
      // The matcher is the CLAIMANT and can never self-resolve their own claim.
      //
      // FREEZE NOTE: `communityReview` has NO allow-update branch anywhere in
      // this file, so once a game reaches it NO client can move letters, turn,
      // roles, phase, winner or status — the game is frozen until the admin
      // referee (Admin SDK, bypasses these rules) resolves it. That absence IS
      // the enforcement; do not add a client communityReview branch.
      allow update: if isSignedIn()
        && isPlayer(resource.data)
        && resource.data.status == 'active'
        && resource.data.phase == 'pendingReview'
        // Only the setter of the frozen turn may accept or dispute.
        && request.auth.uid == resource.data.currentSetter
        // Rate limit — new updatedAt pinned to request.time so a stale value
        // can't keep the 2s cooldown permanently satisfied (same pattern as
        // every other game-update branch).
        && 'updatedAt' in request.resource.data
        && request.resource.data.updatedAt == request.time
        && (
          !('updatedAt' in resource.data)
          || resource.data.updatedAt == null
          || request.time > resource.data.updatedAt + duration.value(2, 's')
        )
        // Identity immutable
        && request.resource.data.player1Uid == resource.data.player1Uid
        && request.resource.data.player2Uid == resource.data.player2Uid
        && request.resource.data.player1Username == resource.data.player1Username
        && request.resource.data.player2Username == resource.data.player2Username
        // spotId immutable
        && (
          (!('spotId' in resource.data) && !('spotId' in request.resource.data))
          || ('spotId' in resource.data && 'spotId' in request.resource.data
              && request.resource.data.spotId == resource.data.spotId)
        )
        // trickCategory immutable (mirrors spotId)
        && (
          (!('trickCategory' in resource.data) && !('trickCategory' in request.resource.data))
          || ('trickCategory' in resource.data && 'trickCategory' in request.resource.data
              && request.resource.data.trickCategory == resource.data.trickCategory)
        )
        // customRules immutable (pairs with trickCategory)
        && (
          (!('customRules' in resource.data) && !('customRules' in request.resource.data))
          || ('customRules' in resource.data && 'customRules' in request.resource.data
              && request.resource.data.customRules == resource.data.customRules)
        )
        // Judge identity/status immutable (honor-system games carry nulls)
        && (
          (!('judgeId' in resource.data) && !('judgeId' in request.resource.data))
          || ('judgeId' in resource.data && 'judgeId' in request.resource.data
              && request.resource.data.judgeId == resource.data.judgeId)
        )
        && (
          (!('judgeStatus' in resource.data) && !('judgeStatus' in request.resource.data))
          || ('judgeStatus' in resource.data && 'judgeStatus' in request.resource.data
              && request.resource.data.judgeStatus == resource.data.judgeStatus)
        )
        // The frozen claim's clip is canonical — matchVideoUrl stays bucket-
        // pinned (unchanged/null/project-bucket) across both moves.
        && matchVideoUrlOk(request.resource.data.matchVideoUrl, resource.data.matchVideoUrl)
        && request.resource.data.status == 'active'
        && request.resource.data.winner == null
        && (
          // (a) ACCEPT → setting: the deferred honor swap. Roles rotate to the
          // matcher (opponent of the current setter), currentTurn follows,
          // turnNumber +1, letters unchanged, review fields cleared, and a
          // fresh bounded turnDeadline governs the resumed turn. The single
          // appended landed TurnRecord is bounded by turnHistoryGrowthOk below.
          (request.resource.data.phase == 'setting'
            && request.resource.data.p1Letters == resource.data.p1Letters
            && request.resource.data.p2Letters == resource.data.p2Letters
            && request.resource.data.currentSetter == opponentUid(resource.data, resource.data.currentSetter)
            && request.resource.data.currentTurn == request.resource.data.currentSetter
            && request.resource.data.turnNumber == resource.data.turnNumber + 1
            && (!('reviewFor' in request.resource.data) || request.resource.data.reviewFor == null)
            && (!('reviewDeadline' in request.resource.data) || request.resource.data.reviewDeadline == null)
            && request.resource.data.turnDeadline is timestamp
            && request.resource.data.turnDeadline > request.time
            && request.resource.data.turnDeadline < request.time + duration.value(48, 'h'))
          ||
          // (b) DISPUTE → communityReview: the game STAYS frozen. Roles,
          // turnNumber, letters and turnHistory are all pinned unchanged;
          // reviewFor keeps naming the matcher; reviewDeadline is reset to a
          // fresh future vote window. turnDeadline is pinned unchanged (it is
          // NOT a play deadline while frozen — the phase gate, not the
          // deadline, keeps the forfeit sweep off this game).
          (request.resource.data.phase == 'communityReview'
            && request.resource.data.p1Letters == resource.data.p1Letters
            && request.resource.data.p2Letters == resource.data.p2Letters
            && request.resource.data.currentSetter == resource.data.currentSetter
            && request.resource.data.currentTurn == resource.data.currentTurn
            && request.resource.data.turnNumber == resource.data.turnNumber
            && request.resource.data.reviewFor == resource.data.reviewFor
            && request.resource.data.turnHistory == resource.data.turnHistory
            && request.resource.data.turnDeadline == resource.data.turnDeadline
            && request.resource.data.reviewDeadline is timestamp
            && request.resource.data.reviewDeadline > request.time)
        )
        // turnHistory growth bound — accept appends exactly one landed record;
        // dispute leaves it unchanged (pinned above). Same +1 / ≤200 ceiling.
        && turnHistoryGrowthOk()
        && judgeUsernameUnchanged()
        && statsAppliedUnchanged();

      // ── Dispute resolution (judge rules on the matcher's "landed" claim) ──
      // Judge-only. The setter never self-judges — disputes only exist in
      // games with an active judge. Judge accepts (no letters, roles swap)
      // or overrules (matcher +1 letter, setter keeps setting).
      allow update: if isSignedIn()
        && isJudge(resource.data)
        && resource.data.status == 'active'
        && resource.data.phase == 'disputable'
        && request.auth.uid == resource.data.currentTurn
        && judgeActive(resource.data)
        // Rate limit. Pinning updatedAt to request.time closes the
        // stale-value bypass (see setting-phase rule above for rationale).
        && 'updatedAt' in request.resource.data
        && request.resource.data.updatedAt == request.time
        && (
          !('updatedAt' in resource.data)
          || resource.data.updatedAt == null
          || request.time > resource.data.updatedAt + duration.value(2, 's')
        )
        // Cannot change player UIDs or usernames
        && request.resource.data.player1Uid == resource.data.player1Uid
        && request.resource.data.player2Uid == resource.data.player2Uid
        && request.resource.data.player1Username == resource.data.player1Username
        && request.resource.data.player2Username == resource.data.player2Username
        // spotId immutable
        && (
          (!('spotId' in resource.data) && !('spotId' in request.resource.data))
          || ('spotId' in resource.data && 'spotId' in request.resource.data
              && request.resource.data.spotId == resource.data.spotId)
        )
        // trickCategory immutable (mirrors spotId)
        && (
          (!('trickCategory' in resource.data) && !('trickCategory' in request.resource.data))
          || ('trickCategory' in resource.data && 'trickCategory' in request.resource.data
              && request.resource.data.trickCategory == resource.data.trickCategory)
        )
        // customRules pairs with trickCategory: set at creation, immutable
        // thereafter (a mid-game rewrite of the agreed rules is not allowed).
        && (
          (!('customRules' in resource.data) && !('customRules' in request.resource.data))
          || ('customRules' in resource.data && 'customRules' in request.resource.data
              && request.resource.data.customRules == resource.data.customRules)
        )
        // Judge identity and status immutable during ruling
        && request.resource.data.judgeId == resource.data.judgeId
        && request.resource.data.judgeStatus == resource.data.judgeStatus
        // currentTurn must be one of the two players after the ruling
        && (
          request.resource.data.currentTurn == resource.data.player1Uid ||
          request.resource.data.currentTurn == resource.data.player2Uid
        )
        // turnDeadline must be a timestamp bounded to a sane future window
        // (see create rule for rationale on the 48h cap).
        && request.resource.data.turnDeadline is timestamp
        && request.resource.data.turnDeadline > request.time
        && request.resource.data.turnDeadline < request.time + duration.value(48, 'h')
        // Letters: accept (no change) or overrule (the disputed turn's MATCHER
        // takes exactly one letter). The matcher is always the setter's
        // opponent — pin the +1 to opponentUid(currentSetter) so a colluding
        // judge cannot pile letters onto a targeted player (audit HIGH).
        && (
          (request.resource.data.p1Letters == resource.data.p1Letters
           && request.resource.data.p2Letters == resource.data.p2Letters)
          || (opponentUid(resource.data, resource.data.currentSetter) == resource.data.player1Uid
              && request.resource.data.p1Letters == resource.data.p1Letters + 1
              && request.resource.data.p2Letters == resource.data.p2Letters)
          || (opponentUid(resource.data, resource.data.currentSetter) == resource.data.player2Uid
              && request.resource.data.p2Letters == resource.data.p2Letters + 1
              && request.resource.data.p1Letters == resource.data.p1Letters)
        )
        // ── matchVideoUrl bucket pin (audit P2) ──
        // Mirrors the match-resolution branch: dispute resolution can flip
        // matchVideoUrl to a freshly recorded clip, but only when the value
        // is pinned to this project's bucket. Without this, a judge ruling
        // could overwrite the matcher's stored URL with an attacker-hosted
        // payload (or the matcher's pre-rule write could survive into the
        // judge's flow). Accepted shapes: unchanged, null, or bucket regex.
        && matchVideoUrlOk(request.resource.data.matchVideoUrl, resource.data.matchVideoUrl)
        // Must resolve to setting (continue) or complete (game over).
        // Completion path pins winner direction (see match-resolution rule
        // for rationale) — judge-overruled dispute that pushes a player to
        // their 5th letter must record the OTHER player as winner.
        && (
          (request.resource.data.status == 'active'
           && request.resource.data.phase == 'setting'
           && request.resource.data.winner == null)
          || (request.resource.data.status == 'complete'
              && request.resource.data.winner != null
              && (
                (request.resource.data.p1Letters >= 5
                 && request.resource.data.winner == resource.data.player2Uid)
                || (request.resource.data.p2Letters >= 5
                    && request.resource.data.winner == resource.data.player1Uid)
              ))
        )
        // turnHistory growth bound — judge rulings append a single
        // TurnRecord with judgedBy set. Same 1-per-write + ≤200 ceiling
        // the match-resolution branch enforces.
        && turnHistoryGrowthOk()
        && judgeUsernameUnchanged()
        && statsAppliedUnchanged();

      // ── Call BS resolution (judge rules on set trick in setReview phase) ──
      // Judge-only. Clean → back to matching (matcher must attempt).
      // Sketchy → back to setting (same setter re-sets, trick fields cleared).
      // No letter changes, no game completion.
      allow update: if isSignedIn()
        && isJudge(resource.data)
        && resource.data.status == 'active'
        && resource.data.phase == 'setReview'
        && request.auth.uid == resource.data.currentTurn
        && judgeActive(resource.data)
        // Rate limit. New updatedAt must equal request.time so the 2s
        // cooldown can't be defeated by writing a stale value on each turn.
        && 'updatedAt' in request.resource.data
        && request.resource.data.updatedAt == request.time
        && (
          !('updatedAt' in resource.data)
          || resource.data.updatedAt == null
          || request.time > resource.data.updatedAt + duration.value(2, 's')
        )
        && request.resource.data.player1Uid == resource.data.player1Uid
        && request.resource.data.player2Uid == resource.data.player2Uid
        && request.resource.data.player1Username == resource.data.player1Username
        && request.resource.data.player2Username == resource.data.player2Username
        && (
          (!('spotId' in resource.data) && !('spotId' in request.resource.data))
          || ('spotId' in resource.data && 'spotId' in request.resource.data
              && request.resource.data.spotId == resource.data.spotId)
        )
        && (
          (!('trickCategory' in resource.data) && !('trickCategory' in request.resource.data))
          || ('trickCategory' in resource.data && 'trickCategory' in request.resource.data
              && request.resource.data.trickCategory == resource.data.trickCategory)
        )
        // customRules pairs with trickCategory: set at creation, immutable
        // thereafter (a mid-game rewrite of the agreed rules is not allowed).
        && (
          (!('customRules' in resource.data) && !('customRules' in request.resource.data))
          || ('customRules' in resource.data && 'customRules' in request.resource.data
              && request.resource.data.customRules == resource.data.customRules)
        )
        && request.resource.data.judgeId == resource.data.judgeId
        && request.resource.data.judgeStatus == resource.data.judgeStatus
        && request.resource.data.status == 'active'
        && request.resource.data.winner == null
        // turnDeadline must be a timestamp bounded to a sane future window
        // (see create rule for rationale on the 48h cap).
        && request.resource.data.turnDeadline is timestamp
        && request.resource.data.turnDeadline > request.time
        && request.resource.data.turnDeadline < request.time + duration.value(48, 'h')
        && request.resource.data.p1Letters == resource.data.p1Letters
        && request.resource.data.p2Letters == resource.data.p2Letters
        && request.resource.data.currentSetter == resource.data.currentSetter
        // Clean: back to matching with matcher's turn.
        // Sketchy: back to setting with same setter re-setting.
        && (
          (request.resource.data.phase == 'matching'
           && request.resource.data.currentTurn == opponentUid(resource.data, resource.data.currentSetter))
          || (request.resource.data.phase == 'setting'
              && request.resource.data.currentTurn == resource.data.currentSetter
              && request.resource.data.currentTrickName == null
              && request.resource.data.currentTrickVideoUrl == null)
        )
        // turnHistory growth bound — Call BS rulings that go "sketchy"
        // append a TurnRecord noting the invalidated set. Same cap as the
        // other resolution branches.
        && turnHistoryGrowthOk()
        && judgeUsernameUnchanged()
        && statsAppliedUnchanged();

      // ── Judge invite accept / decline ──
      // Only the nominated judge can flip their status from pending. No
      // other field may change on the same write.
      allow update: if isSignedIn()
        && isJudge(resource.data)
        && resource.data.status == 'active'
        && 'judgeStatus' in resource.data
        && resource.data.judgeStatus == 'pending'
        && request.resource.data.judgeId == resource.data.judgeId
        // Re-verify judge isn't either player — defence-in-depth in case the
        // create-time check was bypassed (e.g. older docs written before the
        // check was added). Without this an account that is somehow set as
        // both player and judge could accept their own dispute.
        && resource.data.judgeId != resource.data.player1Uid
        && resource.data.judgeId != resource.data.player2Uid
        && (request.resource.data.judgeStatus == 'accepted'
            || request.resource.data.judgeStatus == 'declined')
        // Everything else must stay identical.
        && request.resource.data.player1Uid == resource.data.player1Uid
        && request.resource.data.player2Uid == resource.data.player2Uid
        && request.resource.data.player1Username == resource.data.player1Username
        && request.resource.data.player2Username == resource.data.player2Username
        && request.resource.data.status == resource.data.status
        && request.resource.data.phase == resource.data.phase
        && request.resource.data.currentTurn == resource.data.currentTurn
        && request.resource.data.currentSetter == resource.data.currentSetter
        && request.resource.data.p1Letters == resource.data.p1Letters
        && request.resource.data.p2Letters == resource.data.p2Letters
        && request.resource.data.winner == resource.data.winner
        && request.resource.data.turnNumber == resource.data.turnNumber
        && (
          (!('turnHistory' in resource.data) && !('turnHistory' in request.resource.data))
          || request.resource.data.turnHistory == resource.data.turnHistory
        )
        // trickCategory is immutable after creation — accepting/declining an
        // invite must not let the judge rewrite the game's trick filter.
        && (
          (!('trickCategory' in resource.data) && !('trickCategory' in request.resource.data))
          || ('trickCategory' in resource.data && 'trickCategory' in request.resource.data
              && request.resource.data.trickCategory == resource.data.trickCategory)
        )
        // customRules pairs with trickCategory: set at creation, immutable
        // thereafter (a mid-game rewrite of the agreed rules is not allowed).
        && (
          (!('customRules' in resource.data) && !('customRules' in request.resource.data))
          || ('customRules' in resource.data && 'customRules' in request.resource.data
              && request.resource.data.customRules == resource.data.customRules)
        )
        && judgeUsernameUnchanged()
        && statsAppliedUnchanged();

      // Either player can forfeit the current-turn player's expired turn
      // Winner must be the opponent of the player whose turn it is
      allow update: if isSignedIn()
        && isPlayer(resource.data)
        && resource.data.status == 'active'
        && request.resource.data.status == 'forfeit'
        // Only forfeit from setting or matching (disputable auto-accepts,
        // setReview auto-clears to matching — neither is a forfeit path).
        && (resource.data.phase == 'setting' || resource.data.phase == 'matching')
        // Turn deadline must have actually expired (prevents premature forfeits)
        && request.time > resource.data.turnDeadline
        // Cannot change player UIDs, usernames, or letters
        && request.resource.data.player1Uid == resource.data.player1Uid
        && request.resource.data.player2Uid == resource.data.player2Uid
        && request.resource.data.player1Username == resource.data.player1Username
        && request.resource.data.player2Username == resource.data.player2Username
        && request.resource.data.p1Letters == resource.data.p1Letters
        && request.resource.data.p2Letters == resource.data.p2Letters
        // spotId is immutable after creation — a forfeit must not change it.
        && (
          (!('spotId' in resource.data) && !('spotId' in request.resource.data))
          || ('spotId' in resource.data && 'spotId' in request.resource.data
              && request.resource.data.spotId == resource.data.spotId)
        )
        // trickCategory is immutable after creation — a forfeit must not change it.
        && (
          (!('trickCategory' in resource.data) && !('trickCategory' in request.resource.data))
          || ('trickCategory' in resource.data && 'trickCategory' in request.resource.data
              && request.resource.data.trickCategory == resource.data.trickCategory)
        )
        // customRules pairs with trickCategory: set at creation, immutable
        // thereafter (a mid-game rewrite of the agreed rules is not allowed).
        && (
          (!('customRules' in resource.data) && !('customRules' in request.resource.data))
          || ('customRules' in resource.data && 'customRules' in request.resource.data
              && request.resource.data.customRules == resource.data.customRules)
        )
        // Winner must be the opponent of the current-turn player (who timed out)
        && request.resource.data.winner == opponentUid(resource.data, resource.data.currentTurn)
        // turnHistory may append exactly ONE closing TurnRecord so consumers
        // walking history can render the "how it ended" frame on a forfeit.
        // Same +1 / ≤200 ceiling every other growth-capable branch uses; the
        // helper also accepts the "unchanged" shape for callers that don't
        // append (forward-compat).
        && turnHistoryGrowthOk()
        && judgeUsernameUnchanged()
        && statsAppliedUnchanged();

      // ── Expired dispute auto-accept ──
      // When the judge's review window expires (24 h), any participant
      // (player or judge) can trigger auto-accept: matcher's "landed" call
      // stands, roles swap, no letters change, game continues.
      allow update: if isSignedIn()
        && isParticipant(resource.data)
        && resource.data.status == 'active'
        && resource.data.phase == 'disputable'
        && request.time > resource.data.turnDeadline
        // Letters must not change (auto-accept = landed)
        && request.resource.data.p1Letters == resource.data.p1Letters
        && request.resource.data.p2Letters == resource.data.p2Letters
        // Cannot change player UIDs or usernames
        && request.resource.data.player1Uid == resource.data.player1Uid
        && request.resource.data.player2Uid == resource.data.player2Uid
        && request.resource.data.player1Username == resource.data.player1Username
        && request.resource.data.player2Username == resource.data.player2Username
        // spotId + judge immutable
        && (
          (!('spotId' in resource.data) && !('spotId' in request.resource.data))
          || ('spotId' in resource.data && 'spotId' in request.resource.data
              && request.resource.data.spotId == resource.data.spotId)
        )
        // trickCategory immutable (mirrors spotId)
        && (
          (!('trickCategory' in resource.data) && !('trickCategory' in request.resource.data))
          || ('trickCategory' in resource.data && 'trickCategory' in request.resource.data
              && request.resource.data.trickCategory == resource.data.trickCategory)
        )
        // customRules pairs with trickCategory: set at creation, immutable
        // thereafter (a mid-game rewrite of the agreed rules is not allowed).
        && (
          (!('customRules' in resource.data) && !('customRules' in request.resource.data))
          || ('customRules' in resource.data && 'customRules' in request.resource.data
              && request.resource.data.customRules == resource.data.customRules)
        )
        && request.resource.data.judgeId == resource.data.judgeId
        && request.resource.data.judgeStatus == resource.data.judgeStatus
        // Must transition back to setting (active, no winner)
        && request.resource.data.status == 'active'
        && request.resource.data.phase == 'setting'
        && request.resource.data.winner == null
        // Turn-order pins (audit HIGH: turn seize) — see autoAcceptRolePinsOk.
        // Without these either participant could seize the setter role out of
        // rotation in this same write.
        && autoAcceptRolePinsOk(resource.data, request.resource.data)
        // turnDeadline must be a fresh, bounded future timestamp. This path
        // fires only after the OLD deadline expired, but the NEW deadline
        // written here is what governs the next turn — so it needs the same
        // 48h cap every other write path enforces.
        && request.resource.data.turnDeadline is timestamp
        && request.resource.data.turnDeadline > request.time
        && request.resource.data.turnDeadline < request.time + duration.value(48, 'h')
        // ── matchVideoUrl bucket pin (audit P2) ──
        // Auto-accept finalises the matcher's "landed" call without judge
        // intervention. The matcher's stored matchVideoUrl is now the canonical
        // record of the trick — without a bucket pin a participant could
        // overwrite it on this transition with an attacker-hosted payload
        // that the clip feed and dispute UI would render verbatim. Same
        // shape as the match-resolution + dispute branches above.
        && matchVideoUrlOk(request.resource.data.matchVideoUrl, resource.data.matchVideoUrl)
        // turnHistory growth bound — auto-accept writes a TurnRecord for
        // the expired dispute. Same 1-per-write + ≤200 ceiling.
        && turnHistoryGrowthOk()
        && judgeUsernameUnchanged()
        && statsAppliedUnchanged();

      // ── Expired setReview auto-clear ──
      // When the judge doesn't rule on a "Call BS" within 24h, the set
      // stands (benefit of the doubt) and matcher is prompted to attempt.
      allow update: if isSignedIn()
        && isParticipant(resource.data)
        && resource.data.status == 'active'
        && resource.data.phase == 'setReview'
        && request.time > resource.data.turnDeadline
        && request.resource.data.p1Letters == resource.data.p1Letters
        && request.resource.data.p2Letters == resource.data.p2Letters
        && request.resource.data.player1Uid == resource.data.player1Uid
        && request.resource.data.player2Uid == resource.data.player2Uid
        && request.resource.data.player1Username == resource.data.player1Username
        && request.resource.data.player2Username == resource.data.player2Username
        && (
          (!('spotId' in resource.data) && !('spotId' in request.resource.data))
          || ('spotId' in resource.data && 'spotId' in request.resource.data
              && request.resource.data.spotId == resource.data.spotId)
        )
        && (
          (!('trickCategory' in resource.data) && !('trickCategory' in request.resource.data))
          || ('trickCategory' in resource.data && 'trickCategory' in request.resource.data
              && request.resource.data.trickCategory == resource.data.trickCategory)
        )
        // customRules pairs with trickCategory: set at creation, immutable
        // thereafter (a mid-game rewrite of the agreed rules is not allowed).
        && (
          (!('customRules' in resource.data) && !('customRules' in request.resource.data))
          || ('customRules' in resource.data && 'customRules' in request.resource.data
              && request.resource.data.customRules == resource.data.customRules)
        )
        && request.resource.data.judgeId == resource.data.judgeId
        && request.resource.data.judgeStatus == resource.data.judgeStatus
        && request.resource.data.status == 'active'
        && request.resource.data.phase == 'matching'
        && request.resource.data.winner == null
        && request.resource.data.currentSetter == resource.data.currentSetter
        && request.resource.data.currentTurn == opponentUid(resource.data, resource.data.currentSetter)
        // turnDeadline must be a fresh, bounded future timestamp. Same
        // rationale as the expired-dispute auto-accept above.
        && request.resource.data.turnDeadline is timestamp
        && request.resource.data.turnDeadline > request.time
        && request.resource.data.turnDeadline < request.time + duration.value(48, 'h')
        // turnHistory growth bound — this path typically leaves the
        // history unchanged (no new turn was completed), but we still run
        // the helper to enforce the absolute 200-entry ceiling and block
        // any sneaky append.
        && turnHistoryGrowthOk()
        && judgeUsernameUnchanged()
        && statsAppliedUnchanged();

      // Players may delete their own non-active games (account deletion flow)
      allow delete: if isSignedIn() && isPlayer(resource.data)
        && resource.data.status != "active";
    }

    // ── Spots ──
    // User-contributed skate spots. The map feature lives entirely on
    // Firestore per charter 2.2 ("no custom backend — Firebase rules are
    // the authorization layer"). Spots are world-readable for any signed-
    // in user; only email-verified users can create them; creators can
    // only update their own spots and cannot change immutable fields
    // (coordinates, createdBy, isVerified, isActive) after creation.
    match /spots/{spotId} {
      // Active spots are readable only by signed-in users. Requiring auth
      // closes the anonymous-scraping attack surface: without it, any drive-
      // by attacker could enumerate every spot + join with clips + users to
      // build a user-location graph (privacy incident + App-Store location-
      // data disclosure exposure). Inactive (soft-deleted or moderation-
      // hidden) spots remain unreadable by anyone through this rule. All
      // write paths below remain auth-gated (unchanged).
      //
      // NOTE: the SpotMap / SpotDetailPage screens are accessed from within
      // the app after auth — there are no public unauth reads in the client
      // (verified by grep over src/services/spots.ts + screens/SpotDetailPage).
      // Deep-links to /spots/:id land on the sign-in gate first when called
      // by a signed-out user.
      allow read: if isSignedIn() && resource.data.isActive == true;

      // Create: signed-in + email-verified, owner-stamped, with full
      // field validation mirroring the shared Spot type. Rate-limited
      // via users/{uid}.lastSpotCreatedAt (30s cooldown), same pattern
      // as game creation above.
      allow create: if isSignedIn()
        && request.auth.token.email_verified == true
        && request.resource.data.createdBy == request.auth.uid
        // name: 1–80 chars
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        // description: optional, ≤500 chars
        && (
          request.resource.data.description == null
          || (request.resource.data.description is string
              && request.resource.data.description.size() <= 500)
        )
        // latitude/longitude: finite numbers in WGS84 range
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        // ratings: integer 1–5
        && request.resource.data.gnarRating is int
        && request.resource.data.gnarRating >= 1
        && request.resource.data.gnarRating <= 5
        && request.resource.data.bustRisk is int
        && request.resource.data.bustRisk >= 1
        && request.resource.data.bustRisk <= 5
        // obstacles: list, ≤14 items (one per obstacle type)
        && request.resource.data.obstacles is list
        && request.resource.data.obstacles.size() <= 14
        // photoUrls: list, max 5
        && request.resource.data.photoUrls is list
        && request.resource.data.photoUrls.size() <= 5
        // Verified and active flags: clients cannot self-verify; active
        // must start true (soft-delete is an update, not a create).
        && request.resource.data.isVerified == false
        && request.resource.data.isActive == true
        // Rate limit: at most one spot creation per 30 seconds per user.
        && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || !('lastSpotCreatedAt' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          || request.time > get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastSpotCreatedAt + duration.value(30, 's')
        );

      // Update: owner-only, and coordinates + ownership + verification +
      // active flag are immutable after creation (soft-delete goes through
      // a separate admin flow, not covered here).
      allow update: if isSignedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.latitude == resource.data.latitude
        && request.resource.data.longitude == resource.data.longitude
        && request.resource.data.isVerified == resource.data.isVerified
        && request.resource.data.isActive == resource.data.isActive
        // Mutable fields still get type-checked.
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && (
          request.resource.data.description == null
          || (request.resource.data.description is string
              && request.resource.data.description.size() <= 500)
        )
        // Re-apply the same validation block that `create` uses for the
        // remaining mutable fields. Without this, an owner could submit
        // out-of-range ratings, oversized obstacle/photo lists, or wrong
        // types via a direct API call and bypass the create-time guards.
        && request.resource.data.gnarRating is int
        && request.resource.data.gnarRating >= 1
        && request.resource.data.gnarRating <= 5
        && request.resource.data.bustRisk is int
        && request.resource.data.bustRisk >= 1
        && request.resource.data.bustRisk <= 5
        && request.resource.data.obstacles is list
        && request.resource.data.obstacles.size() <= 14
        && request.resource.data.photoUrls is list
        && request.resource.data.photoUrls.size() <= 5;

      // Delete: owner only. (Prefer soft-delete via admin in practice.)
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      // ── Spot comments (subcollection) ──
      match /comments/{commentId} {
        allow read: if isSignedIn();

        allow create: if isSignedIn()
          && request.auth.token.email_verified == true
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.content is string
          && request.resource.data.content.size() >= 1
          && request.resource.data.content.size() <= 300;

        // Comments are immutable once posted — no edits, only owner delete.
        allow update: if false;
        allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      }
    }

    // ── Nudges ──
    // A nudge is a push-notification poke sent to an idle opponent.
    match /nudges/{nudgeId} {
      allow create: if isSignedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.gameId is string
        && request.resource.data.senderUsername is string
        // Sender must be a player in the game, recipient must be the other player
        && (
          (request.auth.uid == get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.player1Uid
           && request.resource.data.recipientUid == get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.player2Uid)
          ||
          (request.auth.uid == get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.player2Uid
           && request.resource.data.recipientUid == get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.player1Uid)
        )
        // Only nudge active games
        && get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.status == 'active'
        // Companion-write requirement (May 2026 H1 hardening): in the same
        // batch the sender MUST also write nudge_limits/{senderUid_gameId}
        // with lastNudgedAt pinned to request.time. Without this, the client
        // could write /nudges and skip the rate-limit doc — defeating the
        // 1-hour cooldown server-side. getAfter() reflects the post-batch
        // state, so a missing limit write means the doc isn't there and
        // the rule rejects. Mirrors the /reports pattern (H-R2).
        && getAfter(/databases/$(database)/documents/nudge_limits/$(request.auth.uid + '_' + request.resource.data.gameId)).data.lastNudgedAt == request.time;

      // Immutable. (The old `delivered` flag was vestigial — it was to be
      // flipped by an onNudgeCreated Cloud Function that no longer exists.
      // The client no longer writes it and creates no longer require it;
      // there is no key allowlist here, so old clients still sending
      // `delivered` continue to pass.) Nudge delivery is observable via the
      // recipient's /nudges listener and the /push_dispatch queue instead.
      allow update: if false;

      // Sender or recipient can read nudges
      allow read: if isSignedIn()
        && (resource.data.senderUid == request.auth.uid
            || resource.data.recipientUid == request.auth.uid);

      allow delete: if false;
    }

    // ── Billing alerts (server-only) ──
    // Historically written by the onBillingAlert Cloud Function (removed).
    // No client access; retained so any future external consumer writing
    // here (via Admin SDK) stays locked down to clients.
    match /billingAlerts/{alertId} {
      allow read, write: if false;
    }

    // ── Notifications (in-app alerts for game events) ──
    // Written by the client when a game action occurs (e.g. your turn, challenge).
    // Only the recipient can read their own notifications.
    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.type in ['your_turn', 'new_challenge', 'game_won', 'game_lost', 'judge_invite']
        && request.resource.data.title is string
        // Hard cap on user-visible strings — prevents a malicious sender from
        // wedging multi-megabyte notification docs into the recipient's feed.
        && request.resource.data.title.size() <= 80
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 200
        && request.resource.data.gameId is string
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        // Sender must be a participant (player OR judge) of the referenced game.
        && isParticipant(get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data)
        // Recipient must be a participant (player OR judge) of the same game.
        // Allows: player→player (existing), player→judge (judge_invite),
        // judge→player (your_turn after ruling).
        && (
          request.resource.data.recipientUid == get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.player1Uid
          || request.resource.data.recipientUid == get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.player2Uid
          || (
            'judgeId' in get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data
            && get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.judgeId != null
            && request.resource.data.recipientUid == get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.judgeId
          )
        )
        // Rate limit: at most 1 notification per game per action type per 5 seconds
        && (
          !exists(/databases/$(database)/documents/notification_limits/$(request.auth.uid + '_' + request.resource.data.gameId + '_' + request.resource.data.type))
          || request.time > get(/databases/$(database)/documents/notification_limits/$(request.auth.uid + '_' + request.resource.data.gameId + '_' + request.resource.data.type)).data.lastSentAt + duration.value(5, 's')
        )
        // Companion-write requirement (May 2026 H2 hardening): a /notifications
        // create must commit ATOMICALLY with one of two anchors so a malicious
        // client can't write /notifications and skip the cooldown bookkeeping
        // (or, worse, omit it entirely and spam an opponent's feed).
        //
        //   Path A — standalone (writeNotification): the same batch must write
        //   notification_limits/{senderUid_gameId_type} with lastSentAt pinned
        //   to request.time. Mirrors the /reports + /nudges companion-write
        //   pattern, and refreshes the 5s cooldown anchor in lockstep with
        //   the notification.
        //
        //   Path B — in-tx (writeNotificationInTx): the notification is part
        //   of a runTransaction that also updates /games/{gameId} with
        //   updatedAt = serverTimestamp() (i.e. request.time). Every game
        //   action that emits an in-tx notification already does this, and
        //   game writes are themselves rate-limited (turn-action 2s
        //   server cooldown + turn-order rules), so we don't need a second
        //   limits doc on the in-tx hot path.
        //
        // getAfter() reflects the post-commit state; if neither anchor lands
        // in the same batch the rule rejects.
        && (
          getAfter(/databases/$(database)/documents/notification_limits/$(request.auth.uid + '_' + request.resource.data.gameId + '_' + request.resource.data.type)).data.lastSentAt == request.time
          || getAfter(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.updatedAt == request.time
        );

      // Only the recipient can mark a notification as read
      allow update: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.read == true
        // Cannot change other fields
        && request.resource.data.recipientUid == resource.data.recipientUid
        && request.resource.data.senderUid == resource.data.senderUid
        && request.resource.data.type == resource.data.type
        && request.resource.data.title == resource.data.title
        && request.resource.data.body == resource.data.body
        && request.resource.data.gameId == resource.data.gameId
        && request.resource.data.createdAt == resource.data.createdAt;

      // Only the recipient can delete their own notifications.
      allow delete: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid;
    }

    // ── Notification rate limits ──
    // One doc per sender+game+type combo, enforces 5-second cooldown server-side.
    match /notification_limits/{limitId} {
      // NOTE: Clients only write to this collection (setDoc). If a future
      // read path is added, handle the non-existent-doc case (resource == null).
      allow read: if isSignedIn()
        && resource.data.senderUid == request.auth.uid;

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.senderUid
        && limitId == (request.auth.uid + '_' + request.resource.data.gameId + '_' + request.resource.data.type)
        && request.resource.data.type in ['your_turn', 'new_challenge', 'game_won', 'game_lost', 'judge_invite']
        // lastSentAt must equal the server's current time. Without this, a
        // client could seed the doc with a stale timestamp (e.g. epoch 0)
        // and every subsequent update would instantly satisfy the 5s cooldown
        // below, defeating server-side notification rate limiting.
        && request.resource.data.lastSentAt == request.time;

      allow update: if isSignedIn()
        && request.auth.uid == resource.data.senderUid
        && request.time > resource.data.lastSentAt + duration.value(5, 's')
        // New lastSentAt must equal the server's current time — i.e. the
        // client wrote serverTimestamp(). The previous rule accepted any
        // new value, so a malicious client could back-date lastSentAt on
        // each write and keep the 5s cooldown permanently satisfied.
        && request.resource.data.lastSentAt == request.time
        // Immutable identity fields: the doc id is derived from
        // senderUid + gameId + type, so mutating any of them would desync
        // the cooldown key from its bucket and let a sender silently
        // rewrite another bucket's cooldown state.
        && request.resource.data.senderUid == resource.data.senderUid
        && request.resource.data.gameId == resource.data.gameId
        && request.resource.data.type == resource.data.type;

      // Rate-limit docs are server-managed cooldown state with no user-facing
      // lifecycle. Clients must never delete them — a successful delete would
      // reset the 5-second cooldown and let a sender spam notifications.
      // (The previous rule checked resource.data.recipientUid, which doesn't
      // exist on these docs — so it was a copy-paste from /notifications that
      // always denied. Making the intent explicit matches /nudge_limits.)
      allow delete: if false;
    }

    // ── Push targets (cross-readable token mirror) ──
    // The canonical FCM token list lives at users/{uid}/private/profile
    // .fcmTokens (owner-only). This mirror exposes the same tokens to any
    // signed-in user so a SENDER (game opponent / nominated judge) can
    // embed them into a /push_dispatch doc — the Firebase Extension that
    // dispatches background push reads `tokens` from each dispatch doc.
    //
    // Why cross-readable is bounded risk: FCM tokens alone cannot be turned
    // into a push attack — the FCM HTTP API requires OAuth2 with the
    // project's service account, which only the Extension (running as
    // Admin SDK) has. A leaked token can be paired with a uid (privacy
    // leak surface) but cannot be abused for push spam by another
    // authenticated user. The /push_dispatch create rule below additionally
    // requires the sender to be a game participant AND requires
    // `tokens.hasOnly(<mirror>)` so a sender cannot inject bogus tokens to
    // misroute pushes.
    //
    // Cap mirrors the canonical fcmTokens cap (≤10) — keeps fan-out bounded
    // even when a user is signed in on every device they own.
    match /pushTargets/{uid} {
      allow read: if isSignedIn();

      // Allowlist of accepted keys. setDoc(..., merge:true) is the only
      // legitimate writer (src/services/fcm.ts + pushNotifications.ts), and
      // every write touches both fields together — keep this in lockstep
      // with the writers if you add a field.
      function pushTargetsKeysOk() {
        return request.resource.data.keys().hasOnly(['tokens', 'updatedAt']);
      }

      function pushTargetsShapeOk() {
        return request.resource.data.tokens is list
          && request.resource.data.tokens.size() <= 10
          // updatedAt MUST equal server time — without this, a client could
          // backfill an old timestamp and we'd lose stale-token-cleanup
          // semantics elsewhere (the Extension uses updatedAt to skip
          // long-revoked mirrors when a delivery attempt 404s).
          && request.resource.data.updatedAt == request.time;
      }

      allow create: if isOwner(uid)
        && pushTargetsKeysOk()
        && pushTargetsShapeOk();
      allow update: if isOwner(uid)
        && pushTargetsKeysOk()
        && pushTargetsShapeOk();
      // Owner may wipe their mirror (e.g. on account deletion).
      allow delete: if isOwner(uid);
    }

    // ── Push dispatch (Firebase Extension trigger collection) ──
    // The `firebase/firestore-send-fcm` Extension watches this collection
    // (configured in extensions/firestore-send-fcm.env) and forwards each
    // created doc to the FCM HTTP API. The extension runs as Admin SDK so
    // it bypasses these rules — they only gate CLIENT writes to keep
    // attackers from spamming the FCM API via injected dispatch docs.
    //
    // Why this collection exists: client-side dispatch is the only way to
    // wake offline recipients without a Cloud Function (which the
    // verify-no-cloud-functions CI gate blocks). The Extension is a managed
    // deployment outside functions/src/, so it slips past the gate cleanly.
    //
    // Anti-abuse posture:
    //  1. Sender must be a signed-in game participant
    //  2. Recipient must be a participant of the same game (player or judge)
    //  3. tokens.hasOnly(<recipient's mirror>) — no token injection
    //  4. Title/body caps mirror /notifications (≤80 / ≤200) to bound payload
    //  5. Rate anchor: a fresh /notification_limits or /games update by the
    //     SAME sender for the SAME (game, type) must exist within 10s.
    //     Transfers /notifications' 5s rate limit to /push_dispatch by
    //     reference — a client cannot dispatch faster than they can
    //     legitimately notify.
    //
    // The 10s window (vs the notification's 5s) absorbs the network gap
    // between /notifications commit and /push_dispatch commit. Both anchors
    // are committed BEFORE this rule evaluates, so get() (not getAfter)
    // is the right primitive.
    match /push_dispatch/{dispatchId} {
      // Read: only sender and recipient. The Extension reads via Admin SDK
      // so it ignores these rules. Recipient access lets a debug UI show
      // "delivery pending" state without exposing dispatch payloads
      // cross-user.
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.senderUid
            || request.auth.uid == resource.data.recipientUid);

      allow create: if isSignedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.gameId is string
        // 'nudge' is push-only — it has NO /notifications feed entry (nudges
        // live in /nudges with their own 1-hour cooldown) but it is the one
        // event that is useless without waking an offline device. Adding it
        // here opens no new amplification surface: a nudge dispatch still needs
        // the sender to be a participant, still needs tokens.hasOnly(<mirror>),
        // still needs the companion push_dispatch_limits write, and the
        // originating /nudges write is bounded by /nudge_limits at 1 per hour
        // per (sender, game) — an order of magnitude tighter than the 5s
        // dispatch cooldown. Deliberately NOT added to /notifications or
        // /notification_limits: the in-app feed schema stays as it is.
        //
        // Note this rule does not require games.status == 'active' the way the
        // /nudges create rule does. That asymmetry is intentional and safe: the
        // dispatch doc can only exist if the sender already wrote a /nudges doc
        // that passed the active-game check, and the other push types
        // (game_won / game_lost) are by definition emitted for a game that is
        // no longer active. Adding an active-game requirement here would break
        // game-over pushes.
        && request.resource.data.type in ['your_turn', 'new_challenge', 'game_won', 'game_lost', 'judge_invite', 'nudge']
        // ── Dispatch payload shape ──
        && request.resource.data.notification is map
        && request.resource.data.notification.title is string
        && request.resource.data.notification.title.size() <= 80
        && request.resource.data.notification.body is string
        && request.resource.data.notification.body.size() <= 200
        && request.resource.data.data is map
        && request.resource.data.data.gameId == request.resource.data.gameId
        // ── Tokens ──
        && request.resource.data.tokens is list
        && request.resource.data.tokens.size() >= 1
        && request.resource.data.tokens.size() <= 10
        && request.resource.data.createdAt == request.time
        // ── Participation ──
        // Sender must be a participant (player OR judge) of the referenced game.
        && isParticipant(get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data)
        // Recipient must be a participant of the same game. Mirrors the
        // /notifications create rule — player→player (your_turn / game_*),
        // player→judge (judge_invite, ruling needed), judge→player (rulings).
        && (
          request.resource.data.recipientUid == get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.player1Uid
          || request.resource.data.recipientUid == get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.player2Uid
          || (
            'judgeId' in get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data
            && get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.judgeId != null
            && request.resource.data.recipientUid == get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.judgeId
          )
        )
        // ── Token integrity ──
        // Every token MUST appear in the recipient's /pushTargets mirror.
        // Without this, a malicious sender could embed arbitrary tokens
        // (their own device, a token scraped from another collection, …)
        // and have the Extension deliver pushes to wrong devices.
        // hasOnly is the inverse of hasAll: it checks subset, which is
        // what we want — sender's tokens ⊆ recipient's mirror.
        && request.resource.data.tokens.hasOnly(
          get(/databases/$(database)/documents/pushTargets/$(request.resource.data.recipientUid)).data.tokens
        )
        // ── Companion-write rate limit (Codex P1 hardening) ──
        // Each /push_dispatch create MUST commit atomically with a fresh
        // /push_dispatch_limits/{senderUid_recipientUid_gameId_type} doc
        // pinned to request.time. The limits-doc rules enforce a 5s
        // cooldown on update (matches /notifications), so the sender
        // cannot fire more than 1 dispatch per 5s per
        // (recipient, game, type) tuple.
        //
        // Why this replaces the previous recency-window anchor: a sliding
        // "notification_limits OR games.updatedAt within 10s" gate let one
        // legitimate game action authorize an unbounded burst of
        // /push_dispatch docs in the same window — each triggering an FCM
        // API call. Binding to a unique companion-write closes that
        // amplification surface (see notification_limits / reports_limits
        // / nudge_limits — same pattern).
        //
        // getAfter() resolves to the post-batch state, so the rule checks
        // that the limits doc the sender included in this batch has its
        // lastSentAt server-pinned to request.time. The limits-collection
        // create rule enforces the same pin, so a backdated value can't
        // satisfy both gates.
        && getAfter(/databases/$(database)/documents/push_dispatch_limits/$(request.auth.uid + '_' + request.resource.data.recipientUid + '_' + request.resource.data.gameId + '_' + request.resource.data.type)).data.lastSentAt == request.time;

      // Dispatch docs are immutable once created — the Extension writes its
      // delivery results to a sibling collection (configured by the
      // Extension), so clients never need to update or delete here. The
      // Extension's worker runs as Admin SDK and ignores these rules for
      // its own bookkeeping writes.
      allow update: if false;
      allow delete: if false;
    }

    // ── Push dispatch rate limits ──
    // One doc per (sender, recipient, game, type) tuple, enforces the 5s
    // cooldown server-side that the /push_dispatch create rule's
    // companion-write check anchors against. Mirrors the
    // /notification_limits / /nudge_limits / /reports_limits pattern:
    // every legit dispatch write commits this doc in the SAME writeBatch,
    // and the create/update rules pin lastSentAt to serverTimestamp() so
    // a malicious client can't backdate the cooldown anchor and keep the
    // 5s gate permanently satisfied.
    match /push_dispatch_limits/{limitId} {
      // NOTE: Clients only write to this collection. If a future read
      // path is added, handle the non-existent-doc case (resource == null).
      allow read: if isSignedIn() && resource.data.senderUid == request.auth.uid;

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.senderUid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.gameId is string
        // Doc id MUST be deterministic so the /push_dispatch create rule
        // can look it up by shape (request.auth.uid + '_' + recipientUid
        // + '_' + gameId + '_' + type).
        && limitId == (request.auth.uid + '_' + request.resource.data.recipientUid + '_' + request.resource.data.gameId + '_' + request.resource.data.type)
        // Keep in lockstep with the /push_dispatch create allowlist above — a
        // type accepted there but rejected here could never satisfy that rule's
        // companion-write check, silently killing that push type.
        && request.resource.data.type in ['your_turn', 'new_challenge', 'game_won', 'game_lost', 'judge_invite', 'nudge']
        // lastSentAt server-pinned: a client-supplied timestamp would let
        // them seed a stale anchor and immediately satisfy the cooldown
        // on the very next update. Same back-date defence as
        // notification_limits.
        && request.resource.data.lastSentAt == request.time;

      allow update: if isSignedIn()
        && request.auth.uid == resource.data.senderUid
        // 5s cooldown vs the stored anchor. Matches /notifications.
        && request.time > resource.data.lastSentAt + duration.value(5, 's')
        // New lastSentAt MUST be server time — closes the same back-date
        // bypass as create above.
        && request.resource.data.lastSentAt == request.time
        // Immutable identity fields: doc id is derived from the tuple, so
        // mutating any component would desync the cooldown bucket.
        && request.resource.data.senderUid == resource.data.senderUid
        && request.resource.data.recipientUid == resource.data.recipientUid
        && request.resource.data.gameId == resource.data.gameId
        && request.resource.data.type == resource.data.type;

      // Cooldown anchors must never be deleted — a successful delete
      // would reset the 5s gate and re-enable burst spam.
      allow delete: if false;
    }

    // ── Reports (content/player flagging for Google Play UGC policy) ──
    // Users can report opponents in games they participate in. The previous
    // rule leaned on a client-side "query + check" comment to enforce
    // uniqueness; that's harassment-vector and moderator-queue-DoS bait.
    // Server-side rate limit: one report per (reporter, reported) pair per
    // 1 hour, enforced by requiring a companion write to
    // `reports_limits/{reporterUid}_{reportedUid}` in the SAME batch.
    // (That caps the worst case at 24 reports/day against a single target
    // per reporter — fine for moderation triage; no per-day counter needed.)
    //
    // Report CONTENT is immutable once created; only the moderation
    // close-out fields may change, and only via the Admin SDK or an
    // `admin: true` console operator (see the update rule below).
    match /reports/{reportId} {
      // The reporter reads their own reports (duplicate check in the UI); an
      // admin reads every report — that IS the moderation queue. The reported
      // user must never read it (retaliation vector).
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.reporterUid == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        // Cannot report yourself
        && request.resource.data.reportedUid != request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUsername is string
        // gameId is the game a reported player was encountered in. It stays
        // a mandatory string for game-sourced reports, but a user-uploaded
        // clip has no backing game — those reports carry gameId: null and
        // MUST identify the target clip instead, so a null can never be
        // used to file an unattributable report.
        && (
          request.resource.data.gameId is string
          || (request.resource.data.gameId == null
              && request.resource.data.clipId is string
              && request.resource.data.clipId.size() > 0)
        )
        && request.resource.data.reason is string
        && request.resource.data.reason in ['inappropriate_video', 'abusive_behavior', 'cheating', 'spam', 'non_skate_content', 'other']
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.status == 'pending'
        // Optional clipId: when a report targets a clip from the feed rather
        // than an in-game video, it carries the clip's deterministic id
        // (`${gameId}_${turnNumber}_${role}`). Shape-only check here —
        // moderators dedupe and action via Admin SDK.
        && (
          !('clipId' in request.resource.data)
          || (request.resource.data.clipId is string
              && request.resource.data.clipId.size() > 0
              && request.resource.data.clipId.size() <= 128)
        )
        // Rate-limit gate: EITHER the reporter has never reported this
        // target before (no limits doc exists) OR the previous report was
        // more than 1 hour ago. Checked against the PRE-batch state via
        // get(); getAfter() below covers the companion-write freshness.
        && (
          !exists(/databases/$(database)/documents/reports_limits/$(request.auth.uid + '_' + request.resource.data.reportedUid))
          || request.time > get(/databases/$(database)/documents/reports_limits/$(request.auth.uid + '_' + request.resource.data.reportedUid)).data.lastSentAt + duration.value(1, 'h')
        )
        // Companion-write requirement: in the same batch, the reporter MUST
        // also write the matching reports_limits/{reporter_reported} doc
        // with lastSentAt pinned to request.time. Without this, the
        // cooldown would never advance. getAfter() reflects the batch's
        // post-commit state — if the client didn't include the limit
        // write, the doc won't exist there and the rule rejects.
        && getAfter(/databases/$(database)/documents/reports_limits/$(request.auth.uid + '_' + request.resource.data.reportedUid)).data.lastSentAt == request.time;

      // ── Moderation close-out (admin custom claim) ──
      // Reports stay immutable to everyone else — a reporter can never
      // rewrite their own filing. An admin may only move a report to a
      // TERMINAL state with an audit trail: `pending` is not an accepted
      // target, so a report cannot be silently reopened/recycled, and
      // `hasOnly` keeps reason/description/gameId/clipId (the evidence) and
      // reporterUid/reportedUid (the parties) frozen in the same write.
      //
      // The close-out is ONE-WAY: only a still-`pending` report may be
      // actioned. Without this, a second admin (or a replayed token) could
      // overwrite an existing verdict — flipping resolved→dismissed and
      // rewriting resolvedBy/resolvedAt — which destroys the audit trail of
      // who actually adjudicated the report.
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'resolvedBy', 'resolvedAt'])
        && request.resource.data.status in ['resolved', 'dismissed']
        && request.resource.data.resolvedBy == request.auth.uid
        && request.resource.data.resolvedAt == request.time;
      // Reports are the moderation audit trail — nobody deletes them.
      allow delete: if false;
    }

    // ── Report rate limits ──
    // One doc per (reporter, reported) pair, enforces 1-hour cooldown
    // server-side. Companion write to every /reports create (see above).
    // Mirrors nudge_limits / notification_limits: lastSentAt is pinned to
    // request.time on every create/update to close the back-date bypass
    // where a client seeds epoch 0 and permanently satisfies the gate.
    match /reports_limits/{limitId} {
      // NOTE: Clients only write to this collection. If a future read path
      // is added, handle the non-existent-doc case (resource == null).
      allow read: if isSignedIn()
        && resource.data.reporterUid == request.auth.uid;

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.reporterUid
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid != request.auth.uid
        // Doc id MUST be the deterministic `${reporterUid}_${reportedUid}`
        // so the /reports create rule can look it up by shape.
        && limitId == (request.auth.uid + '_' + request.resource.data.reportedUid)
        // lastSentAt pinned to server time. Any other value lets a client
        // back-date the cooldown anchor and keep the 1h gate permanently
        // satisfied. Same pattern as nudge_limits.lastNudgedAt.
        && request.resource.data.lastSentAt == request.time;

      allow update: if isSignedIn()
        && request.auth.uid == resource.data.reporterUid
        // 1-hour cooldown vs the stored anchor.
        && request.time > resource.data.lastSentAt + duration.value(1, 'h')
        // New lastSentAt must be server time — closes the same back-date
        // bypass on updates as the create rule above.
        && request.resource.data.lastSentAt == request.time
        // Immutable identity fields: the doc id is derived from
        // reporterUid + reportedUid, so mutating either would desync the
        // cooldown key from its bucket and let a reporter silently rewrite
        // another pair's cooldown state.
        && request.resource.data.reporterUid == resource.data.reporterUid
        && request.resource.data.reportedUid == resource.data.reportedUid;

      // Rate-limit docs are server-managed cooldown state with no user-
      // facing lifecycle. Clients must never delete them — a successful
      // delete would reset the 1h cooldown and re-enable spam.
      allow delete: if false;
    }

    // ── Nudge rate limits ──
    // One doc per sender+game pair, enforces 1-hour cooldown server-side.
    match /nudge_limits/{limitId} {
      // NOTE: Clients only write to this collection (setDoc). If a future
      // read path is added, handle the non-existent-doc case (resource == null).
      allow read: if isSignedIn()
        && resource.data.senderUid == request.auth.uid;

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.senderUid
        && limitId == (request.auth.uid + '_' + request.resource.data.gameId)
        // lastNudgedAt must equal the server's current time. Otherwise a
        // client could seed the doc with an ancient timestamp, bypassing
        // the 1-hour cooldown on every subsequent update forever.
        && request.resource.data.lastNudgedAt == request.time;

      allow update: if isSignedIn()
        && request.auth.uid == resource.data.senderUid
        && request.time > resource.data.lastNudgedAt + duration.value(1, 'h')
        // New lastNudgedAt must equal the server's current time — prevents
        // the same back-dating bypass on updates (see create rule above).
        && request.resource.data.lastNudgedAt == request.time
        // Immutable identity fields: the doc id is senderUid + gameId, so
        // mutating either would cross-pollute cooldowns across buckets.
        && request.resource.data.senderUid == resource.data.senderUid
        && request.resource.data.gameId == resource.data.gameId;

      allow delete: if false;
    }

    // ── Clips (landed-trick feed) ──
    // Denormalized from games.turnHistory, written atomically inside the same
    // runTransaction that appends the TurnRecord (see src/services/clips.ts
    // writeLandedClipsInTransaction). Each landed turn can produce up to two
    // clips: `set` (setter's landed set) and `match` (matcher's landed match,
    // only when they actually landed it).
    //
    // Integrity rests on four constraints:
    //   1. Deterministic doc id `${gameId}_${turnNumber}_${role}` — idempotent
    //      under transaction retry and prevents duplicates.
    //   2. Writer must be a participant of the referenced game (verified via
    //      get() against the game doc), matching the write privileges that
    //      already govern turnHistory growth.
    //   3. Create sets moderationStatus == 'active' and cannot be updated by
    //      clients — transitions to 'hidden' happen via Admin SDK in response
    //      to a user report (App Store Guideline 1.2 moderation requirement).
    //   4. Owner (playerUid) can delete their own clip — closes the GDPR /
    //      CCPA right-to-erasure loop from the account-deletion flow.
    //
    // Reads are open to any signed-in user: blocklist filtering is applied
    // client-side (see useBlockedUsers), matching how the rest of the app
    // handles cross-user content.
    match /clips/{clipId} {
      allow read: if isSignedIn();

      // ── Game-sourced clips ──
      // Legacy clips written before the `source` field existed stay
      // READABLE (no source check on read; the service mapper defaults
      // them to 'game'), but every NEW game clip must self-declare, so the
      // two create branches below are mutually exclusive and neither can
      // be used to smuggle the other's shape.
      allow create: if isSignedIn()
        && request.resource.data.source == 'game'
        // Deterministic id must match the clip's self-described coordinates.
        && clipId == (request.resource.data.gameId + '_'
                      + string(request.resource.data.turnNumber) + '_'
                      + request.resource.data.role)
        && request.resource.data.gameId is string
        && request.resource.data.turnNumber is int
        && request.resource.data.turnNumber > 0
        && request.resource.data.role in ['set', 'match']
        && request.resource.data.playerUid is string
        && request.resource.data.playerUsername is string
        && request.resource.data.playerUsername.size() > 0
        && request.resource.data.playerUsername.size() <= 20
        && request.resource.data.trickName is string
        && request.resource.data.trickName.size() > 0
        && request.resource.data.trickName.size() <= 100
        && request.resource.data.videoUrl is string
        && request.resource.data.videoUrl.size() > 0
        && request.resource.data.videoUrl.size() <= 2048
        // ── videoUrl bucket pin (audit P2) ──
        // The clip feed is app-wide readable and renders this URL directly.
        // Without a host pin, any signed-in participant could stamp an
        // attacker-hosted URL ("https://attacker.com/payload.html") into
        // the public feed — same referrer/exfil/content-spoof surface as
        // matchVideoUrl above. Pin to this project's Firebase Storage
        // bucket only; mirrors the currentTrickVideoUrl pin on the games
        // collection — BOTH accepted forms must be allowed here because
        // `writeLandedClipsInTransaction` copies the (already-pinned)
        // games video URL into clips.videoUrl verbatim, and the games
        // rule accepts the bucket-as-host CDN form too.
        && videoUrlBucketPinned(request.resource.data.videoUrl)
        && (request.resource.data.spotId == null
            || (request.resource.data.spotId is string
                && request.resource.data.spotId.size() <= 64))
        && request.resource.data.createdAt == request.time
        // Moderation status must start as 'active'. Transitions to 'hidden'
        // are server-side only (Admin SDK), keeping the App Store takedown
        // path out of client reach.
        && request.resource.data.moderationStatus == 'active'
        // upvoteCount aggregate must seed at 0; client-side ranking reads
        // this field directly so it has to start at the empty state.
        && request.resource.data.upvoteCount == 0
        // downvoteCount is newer than the game-clip writer, so it is
        // optional here — but if present it must seed empty too.
        && request.resource.data.get('downvoteCount', 0) == 0
        // Writer must be a game participant (player OR nominated judge).
        && isParticipant(get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data)
        // playerUid must be one of the game's two players — never the judge,
        // never an arbitrary UID.
        && (
          request.resource.data.playerUid == get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.player1Uid
          || request.resource.data.playerUid == get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.player2Uid
        );

      // ── User-uploaded clips (no backing game) ──
      // Random doc id (there are no game coordinates to derive one from),
      // authored by and attributed to the caller, video pinned to the
      // caller's own `userClips/{uid}/` storage prefix, and rate-limited to
      // one every 30 seconds via the mandatory users/{uid} companion write.
      // The game-only coordinate fields are pinned NULL so a user clip can
      // never masquerade as game history in the feed mapper.
      allow create: if isSignedIn()
        && request.auth.token.email_verified == true
        && notBanned()
        && request.resource.data.source == 'user'
        && request.resource.data.gameId == null
        && request.resource.data.turnNumber == null
        && request.resource.data.role == null
        && request.resource.data.playerUid == request.auth.uid
        && request.resource.data.playerUsername is string
        && request.resource.data.playerUsername.size() > 0
        && request.resource.data.playerUsername.size() <= 20
        && request.resource.data.trickName is string
        && request.resource.data.trickName.size() >= 1
        && request.resource.data.trickName.size() <= 80
        && userClipVideoUrlOk(request.resource.data.videoUrl, request.auth.uid)
        && (request.resource.data.spotId == null
            || (request.resource.data.spotId is string
                && request.resource.data.spotId.size() <= 64))
        && request.resource.data.moderationStatus == 'active'
        && request.resource.data.upvoteCount == 0
        && request.resource.data.downvoteCount == 0
        && request.resource.data.createdAt == request.time
        && clipRateLimitOk();

      // Clips are otherwise immutable once written — content edits and
      // moderation flips both go through Admin SDK to keep the audit trail
      // clean. The narrow exception is the two vote aggregates, which a
      // signed-in user can adjust ONLY when paired with the corresponding
      // clipVotes/{uid}_{clipId} create, delete, or delete+create flip in
      // the same atomic write (see src/services/clips.ts). The
      // exists/existsAfter/getAfter checks in clipVoteDeltaOk bind BOTH
      // deltas to the pre- and post-transaction state of the vote doc AND
      // to its `value`, so a client cannot move a counter without moving
      // its own vote in the matching direction.
      allow update: if isSignedIn()
        && request.auth.token.email_verified == true
        // Only the two aggregates may change — every other field stays put.
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvoteCount', 'downvoteCount'])
        // Legacy clips that pre-date an aggregate lack the field on disk;
        // get(field, default) treats them as 0 on both sides so a
        // first-time vote on a pre-backfill clip isn't rejected as a
        // permission-denied — the service mapper defaults the same way.
        && request.resource.data.get('upvoteCount', 0) is int
        && request.resource.data.get('upvoteCount', 0) >= 0
        && request.resource.data.get('downvoteCount', 0) is int
        && request.resource.data.get('downvoteCount', 0) >= 0
        && clipVoteDeltaOk(clipId);

      // The owning player (the one who actually landed the trick) can delete
      // their own clip. This backs the account-deletion cascade in
      // clips.ts#deleteUserClips and lets a user scrub a clip they no longer
      // want in the feed. Strangers, the opponent, and even the judge cannot
      // delete — only the clip's author.
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.playerUid;

      // ── Clip comments (subcollection) ──
      // Mirrors the spot-comments block: signed-in read, email-verified
      // author-stamped create, immutable, author delete. Two deliberate
      // deltas from spots: banned accounts cannot post (the clip feed is
      // the app's public surface — a ban has to actually silence someone),
      // and an admin may delete any comment, which is the moderation
      // takedown path required for user-generated text.
      match /comments/{commentId} {
        allow read: if isSignedIn();

        allow create: if isSignedIn()
          && request.auth.token.email_verified == true
          && notBanned()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.username is string
          && request.resource.data.username.size() > 0
          && request.resource.data.username.size() <= 20
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 300
          && request.resource.data.createdAt == request.time;

        allow update: if false;
        allow delete: if isSignedIn()
          && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // ── Clip upvotes ──
    //
    // One vote per (uid, clipId) enforced by the deterministic document id
    // (`${uid}_${clipId}`). The id is verified at create time so a client
    // cannot impersonate another user's vote. Votes are immutable:
    //
    //   - update allowed ONLY as a direction flip (up ⇄ down); a vote can
    //     never be silently rewritten into a different shape or retargeted.
    //   - delete owner-only — backs any future account-deletion cascade.
    //
    // Reads are open to signed-in users because the clips feed aggregates
    // votes via `getCountFromServer` and checks whether the current user
    // already upvoted via a direct get — both in `fetchClipUpvoteState`
    // (see src/services/clips.ts), and both require read permission on
    // the collection / doc.
    match /clipVotes/{voteId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        // Email verification mirrors every other content-producing rule
        // (games, spots, comments) — without it, throwaway accounts can
        // inflate vote counts on the public clips feed.
        && request.auth.token.email_verified == true
        && notBanned()
        && voteId == (request.auth.uid + '_' + request.resource.data.clipId)
        && request.resource.data.uid == request.auth.uid
        // Direction is part of the vote doc, and the clips aggregate rule
        // reads it back via getAfter() to decide which counter may move.
        // Anything outside {1, -1} would leave the counters unprovable.
        && request.resource.data.value in [1, -1]
        && request.resource.data.clipId is string
        && request.resource.data.clipId.size() > 0
        && request.resource.data.clipId.size() <= 128
        && request.resource.data.createdAt == request.time
        // Vote target must exist — prevents orphaned votes on clips that
        // were deleted between client-side discovery and the write.
        && exists(/databases/$(database)/documents/clips/$(request.resource.data.clipId))
        // Server-enforced no self-vote (audit MEDIUM): a clip's owner cannot
        // create a vote doc for their own clip. The check is independent of
        // `value`, so it blocks BOTH directions — no ranking self-inflation
        // via upvote, and no self-downvote to fake humility/engagement. The
        // service-layer SelfUpvoteError is UX only.
        && get(/databases/$(database)/documents/clips/$(request.resource.data.clipId)).data.playerUid != request.auth.uid;

      // ── Vote flip (up ⇄ down) ──
      // A flip is issued as delete + set of the SAME voteId inside ONE
      // transaction. Firestore COALESCES multiple writes to one document
      // into a single mutation, so the rules engine sees that pair as an
      // UPDATE — verified against the emulator: a blanket
      // `allow update: if false` rejects every flip outright. This clause
      // is therefore the narrowest opening that makes a flip possible:
      //   • identity fields (uid, clipId) frozen, so a vote can never be
      //     retargeted at another clip or another user;
      //   • `value` must actually INVERT — re-writing the same direction
      //     stays denied, which is what keeps the double-vote guard alive;
      //   • createdAt re-stamped to server time, so the flip is auditable
      //     and cannot be back-dated.
      // Nothing else about a vote is mutable, and the paired counter move
      // on /clips is validated independently by clipVoteDeltaOk.
      allow update: if isSignedIn()
        && request.auth.token.email_verified == true
        && notBanned()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['value', 'createdAt'])
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.clipId == resource.data.clipId
        && request.resource.data.value in [1, -1]
        && request.resource.data.value != resource.data.get('value', 1)
        && request.resource.data.createdAt == request.time;

      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.uid;
    }

    // ── Disputes (community-judged trick calls) ──
    // When a matcher claims "I landed it", the SETTER can send the call to
    // the community instead of accepting it on the honor system. The clip
    // enters the feed and any OTHER signed-in user rules LAND or BAIL.
    //
    // Shape mirrors the clips collection deliberately — same integrity
    // constraints, same proven pattern:
    //   1. Deterministic doc id `${gameId}_${turnNumber}` — idempotent under
    //      transaction retry, and a turn can only be disputed once.
    //   2. Writer must be a participant of the referenced game (get() against
    //      the game doc) AND specifically the SETTER of that turn. Only the
    //      player whose trick was matched gets to question the claim.
    //   3. Create seeds status 'open' / moderationStatus 'active' / tallies
    //      at 0; clients can never forge a pre-loaded verdict, and takedowns
    //      stay Admin-SDK-only (App Store Guideline 1.2).
    //   4. matchVideoUrl is bucket-pinned — it renders in a public feed, the
    //      same exfil / content-spoof surface clips.videoUrl guards against.
    //
    // Reads are open to any signed-in user: blocklist filtering is applied
    // client-side (see useBlockedUsers), matching clips.
    match /disputes/{disputeId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.auth.token.email_verified == true
        // Deterministic id must match the dispute's self-described coordinates.
        && disputeId == (request.resource.data.gameId + '_'
                         + string(request.resource.data.turnNumber))
        && request.resource.data.gameId is string
        && request.resource.data.turnNumber is int
        && request.resource.data.turnNumber > 0
        // Only the setter of the disputed turn may raise it — never the
        // matcher (they'd be disputing their own claim), never the judge.
        //
        // ── Gap A (role self-assertion) — CLOSED (binding-dispute Phase 2) ──
        // Previously the rule could only assert `setterUid == request.auth.uid`
        // (the WRITER is who they claim) but had nothing server-side to prove
        // that uid actually set the trick on `turnNumber` — so the matcher
        // could invert the roles and dispute their OWN claim. That was
        // survivable only while the verdict was non-binding. Now the verdict is
        // binding, so the gap is CLOSED by the freeze: a landed claim parks the
        // game in `pendingReview` with `currentSetter`/`turnNumber` still naming
        // the disputed turn, so the rule binds the disputer to the real frozen
        // setter of the real frozen turn. All three reads below hit the SAME
        // game doc already fetched by isParticipant()/the player pins — Firestore
        // dedupes identical document accesses, so this adds ZERO to the
        // document-access budget (one /games get total for the whole rule).
        && request.resource.data.setterUid == request.auth.uid
        && get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.phase == 'pendingReview'
        && request.resource.data.setterUid == get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.currentSetter
        && request.resource.data.turnNumber == get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.turnNumber
        && request.resource.data.matcherUid is string
        && request.resource.data.matcherUid != request.resource.data.setterUid
        && request.resource.data.setterUsername is string
        && request.resource.data.setterUsername.size() > 0
        && request.resource.data.setterUsername.size() <= 20
        && request.resource.data.matcherUsername is string
        && request.resource.data.matcherUsername.size() > 0
        && request.resource.data.matcherUsername.size() <= 20
        && request.resource.data.trickName is string
        && request.resource.data.trickName.size() > 0
        && request.resource.data.trickName.size() <= 100
        // ── matchVideoUrl bucket pin (audit P2) ──
        // REQUIRED: this is the clip the feed plays. Without a host pin any
        // setter could stamp an attacker-hosted URL into an app-wide feed.
        && request.resource.data.matchVideoUrl is string
        && request.resource.data.matchVideoUrl.size() <= 2048
        && videoUrlBucketPinned(request.resource.data.matchVideoUrl)
        // setVideoUrl is optional (turns that pre-date set recording have
        // none) but must clear the same pin whenever it is present.
        && (request.resource.data.setVideoUrl == null
            || (request.resource.data.setVideoUrl.size() <= 2048
                && videoUrlBucketPinned(request.resource.data.setVideoUrl)))
        && (request.resource.data.spotId == null
            || (request.resource.data.spotId is string
                && request.resource.data.spotId.size() <= 64))
        && request.resource.data.createdAt == request.time
        // A dispute always opens accepting verdicts. The close-out
        // (open → 'resolved', plus the referee's verdict/resolutionApplied
        // fields) is an Admin-SDK-only transition — a client can only ever seed
        // 'open' here, and the update rule below denies any status/verdict
        // write, so clients can never resolve a dispute.
        && request.resource.data.status == 'open'
        && request.resource.data.moderationStatus == 'active'
        // Tallies are read directly for the meter, so they must start empty.
        && request.resource.data.landVotes == 0
        && request.resource.data.bailVotes == 0
        // Writer must be a participant of the referenced game.
        && isParticipant(get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data)
        // Both named uids must be the game's actual players — never the
        // judge, never an arbitrary UID stamped in to fake a matchup.
        && (
          request.resource.data.setterUid == get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.player1Uid
          || request.resource.data.setterUid == get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.player2Uid
        )
        && (
          request.resource.data.matcherUid == get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.player1Uid
          || request.resource.data.matcherUid == get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.player2Uid
        );

      // The ONLY client-writable change is a vote tally delta, bound to the
      // paired disputeVotes create/delete in the same atomic write — the same
      // shape as the clips.upvoteCount ±1 branches. Everything else (status
      // close-out, moderation flips, content) is Admin SDK only.
      //
      // ── Why a symmetric -1 branch exists, despite "a verdict is final" ──
      // "No un-vote" is a PRODUCT rule, enforced where product rules belong:
      // the UI ships no retract affordance. It is deliberately NOT a
      // rules-level invariant, because making it one is strictly worse on two
      // counts. (1) Integrity: with delete allowed but no decrement, one
      // account cycles vote → delete vote doc → the !exists() guard resets →
      // vote again, and every +1 sticks. Unbounded ballot stuffing. Pairing
      // the delete with a mandatory -1 makes that cycle net ZERO — stuffing
      // becomes arithmetically impossible rather than merely forbidden.
      // (2) Erasure: the account-deletion cascade
      // (services/disputes.cascade.ts → deleteUserDisputeVotes) must be able
      // to reap a user's verdicts from OPEN disputes. Gating deletes on
      // status would strand a deleted user's recorded verdict on every live
      // dispute — a real GDPR/CCPA gap in a repo that maintains explicit
      // cascade functions for exactly this.
      //
      // Do NOT "restore" the asymmetry by dropping the -1 branch: that
      // re-opens both holes. Integrity lives here; affordances live in the UI.
      allow update: if isSignedIn()
        && request.auth.token.email_verified == true
        && (
          // ── +1: the verdict doc was created in THIS write ──
          // Absent before AND present after ⇒ genuinely new. Without
          // !exists() a user who already voted could keep incrementing;
          // without existsAfter() they could inflate the meter without
          // recording any verdict at all.
          (
            !exists(/databases/$(database)/documents/disputeVotes/$(request.auth.uid + '_' + disputeId))
            && existsAfter(/databases/$(database)/documents/disputeVotes/$(request.auth.uid + '_' + disputeId))
            // New verdicts are only accepted while the dispute is open. (The
            // -1 branch is deliberately NOT status-gated — erasure has to
            // work on closed disputes too.)
            && resource.data.status == 'open'
            && (
              // LAND: landVotes is the only field that may differ, and only
              // to exactly +1 of its stored value.
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['landVotes'])
                && request.resource.data.landVotes is int
                && request.resource.data.landVotes == resource.data.get('landVotes', 0) + 1
                // The paired verdict must actually say 'land' — otherwise a
                // voter files a BAIL verdict while inflating the LAND meter.
                && getAfter(/databases/$(database)/documents/disputeVotes/$(request.auth.uid + '_' + disputeId)).data.verdict == 'land')
              ||
              // BAIL: mirror image.
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bailVotes'])
                && request.resource.data.bailVotes is int
                && request.resource.data.bailVotes == resource.data.get('bailVotes', 0) + 1
                && getAfter(/databases/$(database)/documents/disputeVotes/$(request.auth.uid + '_' + disputeId)).data.verdict == 'bail')
            )
          )
          ||
          // ── -1: the verdict doc was deleted in THIS write ──
          // Present before AND absent after. The verdict is read from the
          // PRE-state (get, not getAfter — the doc is gone afterwards), so a
          // deleted BAIL vote can only ever decrement bailVotes.
          (
            exists(/databases/$(database)/documents/disputeVotes/$(request.auth.uid + '_' + disputeId))
            && !existsAfter(/databases/$(database)/documents/disputeVotes/$(request.auth.uid + '_' + disputeId))
            && (
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['landVotes'])
                && request.resource.data.landVotes is int
                && request.resource.data.landVotes >= 0
                && request.resource.data.landVotes == resource.data.get('landVotes', 0) - 1
                && get(/databases/$(database)/documents/disputeVotes/$(request.auth.uid + '_' + disputeId)).data.verdict == 'land')
              ||
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bailVotes'])
                && request.resource.data.bailVotes is int
                && request.resource.data.bailVotes >= 0
                && request.resource.data.bailVotes == resource.data.get('bailVotes', 0) - 1
                && get(/databases/$(database)/documents/disputeVotes/$(request.auth.uid + '_' + disputeId)).data.verdict == 'bail')
            )
          )
        );

      // ── Gap B (delete + re-raise wipes an unfavourable tally) — CLOSED ──
      // (binding-dispute Phase 2). Previously the setter could delete their own
      // dispute and re-raise from a zeroed tally to wipe an unfavourable vote.
      // Survivable only while the verdict was non-binding; now that a verdict
      // writes real letters/turn order, that reset is a forgery vector, so the
      // client delete is REMOVED entirely. The dispute lifecycle is now
      // Admin-SDK-only: the server referee's `open → resolved` close-out (not a
      // client delete) ends a dispute, and the deterministic id already caps it
      // at one dispute per turn.
      //
      // Erasure is unaffected on the VOTE side: the account-deletion cascade
      // reaps a user's verdicts through the /disputeVotes owner-delete rule
      // (services/disputes.cascade.ts → deleteUserDisputeVotes), which still
      // carries its paired tally decrement and is NOT touched here.
      //
      // COORDINATION (firebase-engineer): services/disputes.cascade.ts →
      // deleteUserDisputes (client deleteDoc of dispute docs raised by the
      // departing user) now fails closed. It is best-effort / non-blocking
      // (Promise.allSettled, warn-and-swallow) so account deletion still
      // succeeds, but raised-dispute docs must instead be reaped server-side by
      // the referee. Rework that function out of the client cascade when the
      // referee lands (Phase 4).
      allow delete: if false;
    }

    // ── Dispute verdicts ──
    //
    // One verdict per (uid, disputeId), enforced by the deterministic
    // `${uid}_${disputeId}` doc id, verified at create time so a client
    // cannot file a verdict under someone else's name. Verdicts are
    // immutable — update is forbidden outright, so a call cannot be changed
    // after the fact — and delete is owner-only for the deletion cascade.
    match /disputeVotes/{voteId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        // Email verification mirrors clipVotes — without it, throwaway
        // accounts could brigade a public verdict.
        && request.auth.token.email_verified == true
        && voteId == (request.auth.uid + '_' + request.resource.data.disputeId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.disputeId is string
        && request.resource.data.disputeId.size() > 0
        && request.resource.data.disputeId.size() <= 128
        && request.resource.data.verdict in ['land', 'bail']
        && request.resource.data.createdAt == request.time
        // Target must exist — no orphaned verdicts on deleted disputes.
        && exists(/databases/$(database)/documents/disputes/$(request.resource.data.disputeId))
        && get(/databases/$(database)/documents/disputes/$(request.resource.data.disputeId)).data.status == 'open'
        // You never judge your own trick. This is the AUTHORITATIVE check —
        // the client's canVote flag is a UI affordance, not authorization.
        && get(/databases/$(database)/documents/disputes/$(request.resource.data.disputeId)).data.setterUid != request.auth.uid
        && get(/databases/$(database)/documents/disputes/$(request.resource.data.disputeId)).data.matcherUid != request.auth.uid;

      allow update: if false;

      // Owner-only delete, and — crucially — the delete must CARRY ITS OWN
      // TALLY CORRECTION. A bare delete would reset the +1 branch's !exists()
      // guard while leaving the earlier increment on the board, so one
      // account could cycle vote → delete → vote → … and add +1 every lap.
      // Forcing the paired -1 makes that cycle net zero: stuffing is blocked
      // by arithmetic, not by forbidding the delete, which is what keeps the
      // account-deletion cascade working on OPEN disputes (see the update
      // rule above for the full rationale).
      //
      // Note this is NOT status-gated: erasure must succeed on closed
      // disputes too. A closed dispute's tally is "final" as a product
      // statement; it must still shed the verdicts of a deleted account.
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.uid
        && (
          // Orphan: the dispute is already gone, so there is no tally left to
          // keep consistent — just drop the vote.
          !exists(/databases/$(database)/documents/disputes/$(resource.data.disputeId))
          // Nothing to subtract: the counter this verdict fed is already at
          // zero (Admin-SDK close-out, or a dispute that was deleted and
          // re-raised from a zeroed tally). Blocking the delete here would
          // strand the vote doc forever. Not a stuffing vector — re-voting
          // from a zeroed base still only ever contributes a single +1.
          || (resource.data.verdict == 'land'
              && get(/databases/$(database)/documents/disputes/$(resource.data.disputeId)).data.get('landVotes', 0) <= 0)
          || (resource.data.verdict == 'bail'
              && get(/databases/$(database)/documents/disputes/$(resource.data.disputeId)).data.get('bailVotes', 0) <= 0)
          // The normal path: the SAME write must decrement the counter this
          // verdict incremented. A 'bail' vote can only ever pull bailVotes
          // down — never landVotes.
          || (resource.data.verdict == 'land'
              && getAfter(/databases/$(database)/documents/disputes/$(resource.data.disputeId)).data.landVotes
                 == get(/databases/$(database)/documents/disputes/$(resource.data.disputeId)).data.get('landVotes', 0) - 1)
          || (resource.data.verdict == 'bail'
              && getAfter(/databases/$(database)/documents/disputes/$(resource.data.disputeId)).data.bailVotes
                 == get(/databases/$(database)/documents/disputes/$(resource.data.disputeId)).data.get('bailVotes', 0) - 1)
        );
    }
  }
}
