# SkateHubba S.K.A.T.E. Game — Environment Variables
# Get values from: Firebase Console → Project Settings → General → Your Apps → Web App
#
# ── Local Development ──
# Copy this file to .env.local and fill in your Firebase project values:
#   cp .env.example .env.local
#
# ── Vercel Preview / Production ──
# Add these variables in Vercel Dashboard → Project Settings → Environment Variables.
# Scope each variable to the environments you need (Preview, Production, or both).
# Preview deployments are created automatically for non-production branches and PRs.
# Each preview deployment gets a unique URL and a branch-specific URL.

# ── Required: Firebase ──────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Optional: Firebase Cloud Messaging (push notifications) ──────────────────────
# VAPID key for FCM web push — get from Firebase Console → Project Settings →
# Cloud Messaging → Web Push certificates → Key pair
# WITHOUT THIS, PUSH IS ENTIRELY DISABLED: fcm.ts logs `vapid_key_missing` and
# returns null, so no device ever registers a token and /push_dispatch stays empty.
VITE_FIREBASE_VAPID_KEY=

# ── Server-only: cron endpoints (Vercel env, NOT prefixed VITE_) ─────────────────
# These two are read by the serverless handlers under api/cron/ and must never be
# exposed to the browser — anything prefixed VITE_ is inlined into the client
# bundle. Set them in Vercel Dashboard → Project Settings → Environment Variables.
#
# Shared bearer secret for /api/cron/sweep-expired-turns (auto-forfeit referee)
# and /api/cron/drain-push-dispatch (push courier). The SAME value must also be
# added as a GitHub Actions repository secret named CRON_SECRET — the schedules
# live in .github/workflows/ and call these endpoints over HTTPS. If the two
# drift, every scheduled run 401s and both jobs silently stop working.
# CRON_SECRET=
#
# Service-account JSON (the whole file contents, single line) for firebase-admin.
# Firebase Console → Project Settings → Service accounts → Generate new private key.
# Collapse to one line first (`jq -c . file.json`) so the paste can't mangle the
# private_key's \n escapes, and REDEPLOY after setting — Vercel binds env vars
# at deploy time. Full procedure: docs/DEPLOYMENT.md → "Cron Endpoints Runbook".
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Optional: Firebase (recommended for production) ─────────────────────────────
# Measurement ID for Firebase Analytics (found in Firebase Console → Project Settings)
# VITE_FIREBASE_MEASUREMENT_ID=

# ── Optional: Firebase App Check ─────────────────────────────────────────────────
# reCAPTCHA v3 site key — get from Firebase Console → App Check → Register app
# VITE_RECAPTCHA_SITE_KEY=

# App Check is OPT-IN — default OFF. Set to "true" in Vercel AND provide a valid
# VITE_RECAPTCHA_SITE_KEY to turn it on. Default-off prevents the permission-denied
# lockout that happens when Firebase Console enforcement is flipped without the
# reCAPTCHA domain allowlist being updated (see docs/PERMISSION_DENIED_RUNBOOK.md).
# Verify the App Check "verified requests" metric is > 95 % for skatehubba.com
# before enabling.
# VITE_APPCHECK_ENABLED=true

# ── Optional: Sentry Error Tracking (recommended for production) ─────────────────
# DSN from Sentry Dashboard → Project → Settings → Client Keys
# Without this key Sentry is disabled — errors only appear in browser console.
# VITE_SENTRY_DSN=

# ── Optional: PostHog Analytics (funnels, cohorts, retention) ────────────────────
# Project API key — starts with "phc_". Get from PostHog → Project Settings →
# API Keys. Without this key PostHog is disabled and events no-op silently.
# Vercel Analytics still runs in parallel (sees every event either way).
# VITE_POSTHOG_KEY=
# Optional host override. US cloud (default): https://us.i.posthog.com
# EU cloud: https://eu.i.posthog.com — use whichever region you chose at signup.
# VITE_POSTHOG_HOST=

# ── Optional: App URL ─────────────────────────────────────────────────────────────
# Set to your production domain in Vercel env vars. Falls back to window.location.origin.
# Used for Firebase email action links (password reset, verification) and invite links.
# VITE_APP_URL is used as the continue-URL for email verification links.
# If set, the domain MUST be added to Firebase Console → Authentication → Settings →
# Authorized domains, otherwise Firebase returns auth/unauthorized-continue-uri and the
# client silently falls back to the firebaseapp.com default handler (unbranded).
# VITE_APP_URL=https://skatehubba.com

# ── Feature freeze: Map / Clips feed / Verified Pro ─────────────────────────────
# DEFAULT OFF. While unset (or anything other than the literal "true"), the app
# ships only the core S.K.A.T.E. Challenge loop: /map, /spots/:id and /feed
# redirect to /lobby (or / when signed out), and the Clips/Map nav tabs, the
# profile "Add a spot" CTA, the Verified Pro badge and the admin Verify Pro panel
# are hidden. Set to "true" and redeploy to re-enable. See src/lib/featureFlags.ts.
# VITE_FEATURE_EXTRAS_ENABLED=true

# ── Roll Dice (street dice / C-Lo) ─────────────────────────────────────────────
# DEFAULT OFF, and independent of the extras switch above. While unset, /dice,
# /dice/new and /dice/:gameId redirect like any other frozen route, and the
# lobby card and profile button stay hidden. Set to the literal "true" and
# redeploy to show the UI. The callable still rejects everyone until
# DICE_ENABLED or DICE_TESTER_UIDS is set on the function. See docs/DICE.md.
# VITE_FEATURE_DICE_ENABLED=true

# ── Sign in with Apple ──────────────────────────────────────────────────────────
# DEFAULT OFF. The landing page and the sign-in screen hide "Continue with
# Apple" unless this is the literal "true". Leave it unset until the Apple
# provider is enabled in Firebase (Authentication → Sign-in method → Apple).
# Then set it to "true" in Vercel and redeploy — VITE_* values are inlined at
# build time. The iOS TestFlight workflow sets this itself so App Review sees
# the button; do not run that workflow before the Firebase provider is on.
# See docs/IOS_RELEASE.md.
# VITE_FEATURE_APPLE_SIGNIN_ENABLED=true

# ── Referee on new games ────────────────────────────────────────────────────────
# DEFAULT OFF. While unset (or anything other than the literal "true"), the
# challenge screen hides the referee field and createGame ignores any judge
# the caller tries to attach. New games run the honor system: pendingReview,
# then a community vote. Games already in flight with a judge are unchanged.
# Set to "true" and redeploy to restore the optional referee picker.
# See src/lib/featureFlags.ts.
# VITE_FEATURE_REFEREE_ENABLED=true

# ── Required for Map: Mapbox ─────────────────────────────────────────────────────
# Get from Mapbox Dashboard → Access Tokens
# Without this, the /map page will not render. The map silently fails without a token.
# Only needed when VITE_FEATURE_EXTRAS_ENABLED=true (the Map is frozen otherwise).
VITE_MAPBOX_TOKEN=
# Optional: custom Mapbox Studio style URL. Falls back to mapbox://styles/mapbox/dark-v11
# Authoring + publish steps: docs/MAPBOX_STYLE.md
# VITE_MAPBOX_STYLE_URL=

# ── Local development only ────────────────────────────────────────────────────────
# Set to "true" to use Firebase emulators (Auth :9099, Firestore :8080, Storage :9199)
# VITE_USE_EMULATORS=true
