# fastlane match stores the App Store certificate and provisioning profile
# in a private git repo, encrypted with MATCH_PASSWORD. The certificate is
# created once, on the GitHub macOS runner, by the ios-signing-bootstrap
# workflow (MATCH_READONLY=false). Later TestFlight runs only read it.
require_relative "ci_helpers"

git_url(SkatehubbaCI.match_git_url)
git_branch(SkatehubbaCI::MATCH_GIT_BRANCH)
storage_mode "git"

type "appstore"
app_identifier [SkatehubbaCI::APP_IDENTIFIER]

# API key only. Do not set an account email here; that path asks for a
# password and a 2FA code, which the runner cannot answer.
team_id ENV["APPLE_TEAM_ID"]

# Read-only unless the bootstrap workflow sets MATCH_READONLY=false.
readonly ENV["MATCH_READONLY"] != "false"
