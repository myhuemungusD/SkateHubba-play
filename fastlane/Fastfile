# Fastlane configuration for SkateHubba.
#
# Automates beta + production releases for iOS (TestFlight + App Store) and
# Android (internal + closed + production tracks on Google Play). All lanes
# read credentials from GitHub Actions secrets (see `.github/workflows/
# android-aab.yml`, `ios-release.yml`, and `ios-signing-bootstrap.yml`) so
# nothing sensitive lives in the repo.
#
# Run a lane locally:
#   bundle exec fastlane ios beta
#   bundle exec fastlane android internal
#
# Every lane assumes `npm run build && npx cap sync` has already produced a
# fresh web bundle. CI jobs chain those steps explicitly.

require_relative "ci_helpers"

default_platform(:ios)

# ──────────────────────────────────────────────────────────────────────────
# iOS
# ──────────────────────────────────────────────────────────────────────────
platform :ios do
  before_all do
    # `cap add ios` must have been run at least once to materialise the
    # ios/App/ Xcode project. On fresh checkouts (or CI) do that first.
    unless File.exist?(File.expand_path("../ios/App", __dir__))
      UI.user_error!("ios/App/ not found — run `npx cap add ios && npx cap sync ios` first.")
    end
  end

  # One App Store Connect API key for match, TestFlight, and deliver.
  # ASC_KEY_P8 is the .p8 text or the base64 of that text. Memoized so a
  # lane does not parse the key twice. Error text never includes the key.
  def skatehubba_asc_api_key
    return @skatehubba_asc_api_key if @skatehubba_asc_api_key

    begin
      key = SkatehubbaCI.decode_p8(ENV["ASC_KEY_P8"])
    rescue ArgumentError => e
      UI.user_error!(e.message)
    end
    key_id = ENV["ASC_KEY_ID"].to_s.strip
    issuer_id = ENV["ASC_ISSUER_ID"].to_s.strip
    UI.user_error!("ASC_KEY_ID is empty") if key_id.empty?
    UI.user_error!("ASC_ISSUER_ID is empty") if issuer_id.empty?
    @skatehubba_asc_api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key,
      duration: 1200,
      in_house: false,
    )
  end

  def require_apple_team_id!
    team = ENV["APPLE_TEAM_ID"].to_s.strip
    UI.user_error!("APPLE_TEAM_ID is empty") if team.empty?
    team
  end

  # Marketing version: IOS_MARKETING_VERSION when the workflow input is set,
  # otherwise package.json (release-please bumps that). The build number is
  # one higher than the newest TestFlight upload for that version, looked
  # up with the API key. Nothing here is committed.
  def resolve_store_version!
    begin
      version = SkatehubbaCI.marketing_version(
        ENV["IOS_MARKETING_VERSION"],
        File.expand_path("../package.json", __dir__),
      )
    rescue ArgumentError => e
      UI.user_error!(e.message)
    end
    latest = latest_testflight_build_number(
      api_key: skatehubba_asc_api_key,
      app_identifier: SkatehubbaCI::APP_IDENTIFIER,
      version: version,
      platform: "ios",
      # 0 so the first upload of a version becomes build 1 after + 1.
      initial_build_number: 0,
    )
    begin
      build_number = SkatehubbaCI.next_build_number(latest)
    rescue ArgumentError => e
      UI.user_error!(e.message)
    end
    [version, build_number]
  end

  def apply_store_version!(version, build_number)
    google_plist = File.expand_path("../#{SkatehubbaCI::GOOGLE_SERVICE_PLIST}", __dir__)
    unless File.exist?(google_plist)
      UI.user_error!("GoogleService-Info.plist is missing. The TestFlight workflow writes it from GOOGLE_SERVICE_INFO_PLIST_BASE64.")
    end
    scheme = SkatehubbaCI.reversed_client_id(File.read(google_plist))
    if scheme.nil?
      UI.user_error!("GoogleService-Info.plist has no REVERSED_CLIENT_ID. Download the iOS file for com.skatehubba.app from Firebase again.")
    end
    update_info_plist(
      xcodeproj: "ios/App/App.xcodeproj",
      plist_path: "App/Info.plist",
      block: proc do |plist|
        plist["CFBundleShortVersionString"] = version
        plist["CFBundleVersion"] = build_number.to_s
        plist["CFBundleURLTypes"] = SkatehubbaCI.ensure_url_scheme(plist["CFBundleURLTypes"], scheme)
      end,
    )
    SkatehubbaCI.attach_google_service_plist!(File.expand_path("../ios/App/App.xcodeproj", __dir__))
  end

  desc "Sync Apple signing certs + provisioning profiles via fastlane match"
  lane :certificates do
    team = require_apple_team_id!
    # Readonly unless MATCH_READONLY=false. The signing-bootstrap workflow
    # is the only place that sets it false. A normal TestFlight run cannot
    # create or replace the distribution certificate.
    begin
      git_url = SkatehubbaCI.match_git_url
    rescue ArgumentError => e
      UI.user_error!(e.message)
    end
    options = {
      type: "appstore",
      app_identifier: [SkatehubbaCI::APP_IDENTIFIER],
      readonly: ENV["MATCH_READONLY"] != "false",
      api_key: skatehubba_asc_api_key,
      git_url: git_url,
      git_branch: SkatehubbaCI::MATCH_GIT_BRANCH,
      team_id: team,
    }
    keychain_name = ENV["MATCH_KEYCHAIN_NAME"].to_s.strip
    keychain_password = ENV["MATCH_KEYCHAIN_PASSWORD"].to_s
    unless keychain_name.empty?
      options[:keychain_name] = keychain_name
      options[:keychain_password] = keychain_password unless keychain_password.empty?
    end
    match(options)
  end

  desc "Build a signed TestFlight build from the current commit"
  lane :beta do
    team = require_apple_team_id!
    version, build_number = resolve_store_version!
    apply_store_version!(version, build_number)
    certificates
    ipa = build_app(
      # The Capacitor iOS project uses SPM (CapApp-SPM), not CocoaPods —
      # there is no .xcworkspace to build; the shared App scheme lives in
      # App.xcodeproj/xcshareddata/xcschemes/App.xcscheme.
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      clean: true,
      output_directory: "ios/build",
      output_name: "SkateHubba.ipa",
      export_method: "app-store-connect",
      # Release signs manually (see project.pbxproj): the team comes from the
      # environment so no developer identity is hardcoded in the repo, and the
      # profile is the match-managed App Store profile synced by :certificates.
      # NOTE: the profile name below must stay in lockstep with
      # PROVISIONING_PROFILE_SPECIFIER in ios/App/App.xcodeproj/project.pbxproj.
      xcargs: "DEVELOPMENT_TEAM=#{team} CURRENT_PROJECT_VERSION=#{build_number} MARKETING_VERSION=#{version}",
      export_team_id: team,
      export_options: {
        provisioningProfiles: {
          SkatehubbaCI::APP_IDENTIFIER => SkatehubbaCI::PROFILE_NAME,
        },
      },
    )
    UI.user_error!("Signed IPA was not produced") if ipa.to_s.empty? || !File.exist?(ipa.to_s)
    # No changelog: pilot waits for the build to appear before it can save
    # "What to Test". Skipping that wait is the point of this upload.
    pilot(
      api_key: skatehubba_asc_api_key,
      app_identifier: SkatehubbaCI::APP_IDENTIFIER,
      apple_id: SkatehubbaCI::ASC_APP_ID,
      ipa: ipa.to_s,
      skip_submission: true,
      skip_waiting_for_build_processing: true,
      uses_non_exempt_encryption: false,
    )
    UI.success("Uploaded #{version} (#{build_number}) to TestFlight. Apple is still processing it.")
  end

  desc "Submit the latest TestFlight build for App Store review"
  lane :release do
    deliver(
      # Versioned listing copy lives in fastlane/metadata/ (the android/
      # subfolder inside it belongs to supply, not deliver — deliver only
      # reads locale folders like en-US/). No screenshots are versioned yet,
      # so skip that surface entirely instead of wiping the store's set.
      metadata_path: "fastlane/metadata",
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,  # skip interactive confirmation
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false,
      },
      precheck_include_in_app_purchases: false,
      api_key: skatehubba_asc_api_key,
    )
  end
end

# ──────────────────────────────────────────────────────────────────────────
# Android
# ──────────────────────────────────────────────────────────────────────────
platform :android do
  # Release signing config, shared by every lane that runs Gradle. The same
  # four values drive android/app/build.gradle's signingConfigs block (via
  # keystore.properties or these env vars) AND the CI workflow's
  # `-Pandroid.injected.signing.*` overrides — one keystore, three entry
  # points, identical signatures.
  def signing_properties
    keys = %w[KEYSTORE_FILE KEYSTORE_PASSWORD KEY_ALIAS KEY_PASSWORD]
    set = keys.select { |k| ENV[k].to_s.length.positive? }
    # No env vars at all → fall through to android/keystore.properties, which
    # build.gradle's signingConfigs block picks up on its own. build.gradle
    # carries an explicit guard that fails bundleRelease when neither source
    # is configured (AGP would otherwise emit an unsigned AAB silently).
    return {} if set.empty?
    missing = keys - set
    unless missing.empty?
      UI.user_error!("Partial Android signing env: missing #{missing.join(', ')} " \
                     "(set all four of #{keys.join(', ')}, or none and use android/keystore.properties)")
    end
    {
      "android.injected.signing.store.file" => File.expand_path(ENV["KEYSTORE_FILE"]),
      "android.injected.signing.store.password" => ENV["KEYSTORE_PASSWORD"],
      "android.injected.signing.key.alias" => ENV["KEY_ALIAS"],
      "android.injected.signing.key.password" => ENV["KEY_PASSWORD"],
    }
  end

  desc "Build + upload an AAB to Google Play Internal Testing"
  lane :internal do
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "android/",
      properties: signing_properties,
    )
    upload_to_play_store(
      track: "internal",
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      json_key_data: ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"],
      # Deliberate asymmetry with the promote lanes below: lanes that upload
      # a NEW artifact also upload its changelog (fastlane/metadata/android/
      # en-US/changelogs/); promotions reuse the changelog already attached.
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Upload an ALREADY-BUILT AAB to the internal track (no Gradle run). " \
       "Used by CI, which builds + signs the AAB itself; pass AAB_PATH to override."
  lane :publish_internal do
    aab_path = ENV["AAB_PATH"] || "android/app/build/outputs/bundle/release/app-release.aab"
    UI.user_error!("AAB not found at #{aab_path} — build it first (gradlew bundleRelease).") unless File.exist?(aab_path)
    upload_to_play_store(
      track: "internal",
      aab: aab_path,
      json_key_data: ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"],
      # Same changelog policy as :internal — new artifact, so its changelog
      # (fastlane/metadata/android/en-US/changelogs/) uploads with it.
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Promote the latest internal build to the closed testing (beta) track"
  lane :beta do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "beta",
      json_key_data: ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"],
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Promote the latest beta build to production"
  lane :release do
    upload_to_play_store(
      track: "beta",
      track_promote_to: "production",
      rollout: "0.1",  # 10% staged rollout — widen manually after 24-48h
      json_key_data: ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"],
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end
