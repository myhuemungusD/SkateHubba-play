<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links: https://skatehubba.com/... opens the app
                 instead of the browser. `autoVerify` requires
                 /.well-known/assetlinks.json to be served from BOTH hosts with
                 the release signing cert's SHA-256 fingerprint — see
                 ios/NATIVE_SETUP.md §5. www is claimed as well because the
                 vercel.json www -> apex redirect happens after the OS has
                 already matched (or failed to match) the tapped host. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="skatehubba.com" />
                <data android:scheme="https" android:host="www.skatehubba.com" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- FCM / push notifications — runtime-prompted on Android 13+ (API 33+).
         Required for @capacitor/push-notifications registration to surface a
         prompt; older platforms auto-grant and this line is a harmless no-op. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- No media or storage permissions, on purpose (Google Play Photo and
         Video Permissions policy). Every pick goes through a system picker that
         grants access to just the chosen file:
         - <input type="file"> (clip upload, clip editor, banner, Closet Studio)
           opens the system chooser via BridgeWebChromeClient.showFilePicker.
         - @capacitor/camera getPhoto(source: Photos) uses the Android Photo
           Picker (PickVisualMedia; backported below API 33) and reports the
           photos permission as granted.
         - Camera capture never sets saveToGallery, so the plugin only needs
           CAMERA. Recorded clips stay in app storage.
         Add a READ_MEDIA_* permission only with a Play Console declaration for
         a core, broad gallery feature. -->

    <!-- Video recording feature declarations (used by
         @capacitor-community/video-recorder). `required="false"` keeps the
         app installable on devices without these hardware features; the
         service layer checks isNativePlatform() before invoking the
         plugin. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
