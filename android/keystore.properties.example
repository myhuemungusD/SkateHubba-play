# Android release signing — local template.
#
# Copy to android/keystore.properties (gitignored) and fill in real values.
# The same four values can instead be supplied as env vars (KEYSTORE_FILE,
# KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD — all four, or none) — fastlane
# uses that path. When this file exists it takes precedence over the env
# vars; CI's -Pandroid.injected.signing.* properties override both. See
# android/app/build.gradle for the full resolution order.
#
# storeFile is resolved relative to the android/ directory; absolute paths
# also work.
storeFile=app/skatehubba-upload.keystore
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
