rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Game videos: only authenticated users can read/upload
    // Path: games/{gameId}/turn-{turnNumber}/{role}-{uploaderUid}.webm (web)
    //       or {role}-{uploaderUid}.mp4 (native), role = set | match
    // NOTE: Storage rules cannot cross-reference Firestore docs to verify
    // game membership (cross-service firestore.get() only reaches the
    // (default) database; this app uses the NAMED database "skatehubba").
    // Firestore game rules enforce player validation.
    // Storage restricts to auth + size bounds + content type + exact filename.
    match /games/{gameId}/{turnPath}/{fileName} {
      // Read stays filename-agnostic so objects written under the pre-uid
      // naming scheme (`set.webm` / `match.mp4`) remain playable.
      allow read: if request.auth != null;
      // Create: authenticated + size/type constraints + uid binding.
      // The uploader stamps customMetadata.uploaderUid at upload time
      // (see src/services/storage.ts) so delete can verify ownership.
      allow create: if request.auth != null
        // Minimum 1 KB — prevents empty/stub uploads
        && request.resource.size > 1024
        // Maximum 50 MB per video
        && request.resource.size < 50 * 1024 * 1024
        // Filename is pinned to `{role}-{request.auth.uid}.{ext}` so no
        // account can ever OCCUPY another player's upload path. Without the
        // uid suffix an attacker who learned a gameId could pre-create the
        // victim's next path (e.g. .../turn-3/match.webm); because `update`
        // is denied, the victim's own upload then collided with the squatted
        // object, was evaluated as an update, and was rejected — they could
        // never submit their trick and forfeited on the turn timer.
        // Residual: an attacker can still create junk under a game's
        // directory at THEIR OWN uid-suffixed names. That is bounded (≤50 MB,
        // 1 KB min, auth-only readable, never referenced by any Firestore
        // doc) and is reaped by the existing 90-day retention/cleanup sweep.
        // Per-extension content-type pinning: the extension and the
        // contentType MUST agree (mirrors the avatar rule below), so a client
        // cannot ship mp4 bytes behind a `.webm` name. Exact-string equality
        // (not a regex) inherently rejects path traversal and encoded
        // separators.
        && (
          (
            (fileName == ('set-' + request.auth.uid + '.webm') || fileName == ('match-' + request.auth.uid + '.webm'))
            && request.resource.contentType == 'video/webm'
          )
          || (
            (fileName == ('set-' + request.auth.uid + '.mp4') || fileName == ('match-' + request.auth.uid + '.mp4'))
            && request.resource.contentType == 'video/mp4'
          )
        )
        // Bind the new object to its uploader so delete can verify ownership.
        && request.resource.metadata.uploaderUid == request.auth.uid;
      // NOTE: `update` is intentionally NOT granted. Game-video objects are
      // append-only from the rules' perspective: once committed they must
      // not be mutated, because Firestore `clips/*` docs (immutable via
      // `allow update: if false`) reference these URLs as the content-
      // moderation audit trail. Allowing update would let the uploader
      // silently swap the bytes behind an already-moderated clip.
      // If the client needs retry-on-failure semantics, it must `delete`
      // the old object and `create` a fresh one — the `create` rule re-
      // binds uploaderUid, size, MIME, and filename pattern from scratch.
      // (Firebase SDK `uploadBytesResumable` only commits on full success,
      // so a failed first attempt leaves no object to collide with — no
      // client-side delete is needed for the normal retry path.)
      // Delete: only the original uploader may remove their own video
      // (used during account-deletion cleanup for that user's own clips).
      // Filename-agnostic on purpose: legacy objects written under the
      // pre-uid naming scheme must stay deletable by their uploader, and the
      // game-deletion cascade walks the prefix with listAll().
      allow delete: if request.auth != null
        && resource.metadata.uploaderUid == request.auth.uid;
    }

    // ── Avatar uploads (PR-B) ──
    // Owner-only create + delete. ≤2 MB. Content-type pinning.
    // `update: if false` forces delete-then-create on re-upload (audit S11)
    // so a prior moderation pass cannot be silently overwritten with new
    // bytes behind the same URL.
    //
    // Anyone-auth read so /profile/{uid} pages on either own- or opponent-
    // view can render the avatar without a per-user grant. The Firestore
    // rule separately pins `users/{uid}.profileImageUrl` to this
    // bucket + the writer's UID, so a malicious profile cannot point at
    // another user's avatar (audit S5+S12).
    // NOTE: the Storage rules grammar does NOT support `{var}` segments
    // mid-path-segment (only whole path segments). The working equivalent
    // uses a single wildcard `{filename}` and a regex match on the filename
    // — same effect (uid pinning + ext allowlist), syntactically valid.
    match /users/{uid}/{filename} {
      allow read: if request.auth != null && filename.matches('avatar\\.(webp|jpeg|png)');

      allow create: if request.auth != null
        && request.auth.uid == uid
        // Per-extension content-type pinning (audit B-ISSUE-3): the
        // extension and the contentType MUST agree. Previously the
        // bare `matches(...)` allowlist permitted `avatar.webp` with
        // `content-type: image/png`, letting a client lie about the
        // payload format.
        && (
          (filename == 'avatar.webp' && request.resource.contentType == 'image/webp')
          || (filename == 'avatar.jpeg' && request.resource.contentType == 'image/jpeg')
          || (filename == 'avatar.png' && request.resource.contentType == 'image/png')
        )
        && request.resource.size > 1024
        && request.resource.size <= 2 * 1024 * 1024;

      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.uid == uid
        && filename.matches('avatar\\.(webp|jpeg|png)');
    }

    // ── User-uploaded clips (feed uploads with no backing game) ──
    // Path: userClips/{uid}/{fileName}.webm (web) or .mp4 (native).
    // The uid IS the path prefix here (unlike game videos, where turn
    // ownership flips), so ownership is enforced structurally on create
    // and delete. `update: if false` blocks IN-PLACE mutation (including
    // metadata edits) of a committed object. It does NOT make the bytes
    // permanently immutable: the owner may still `delete` and re-`create`
    // at the same name. That is safe here only because the download URL
    // carries a token that ROTATES on re-create, so an already-published
    // (and possibly already-moderated) URL keeps resolving to the bytes it
    // was moderated against and cannot be silently repointed. What
    // `update: false` actually buys is that every set of bytes goes
    // through the full `create` rule — size, MIME, filename and
    // uploaderUid re-validated from scratch — instead of being patched
    // past those checks.
    //
    // NOTE: Storage rules cannot cross-reference Firestore, so the
    // `users/{uid}.banned` flag is NOT enforceable here — a banned user can
    // still push bytes into their own prefix. The Firestore /clips
    // user-source create rule is the real gate: without a clip doc the
    // object is unreachable from the feed, and orphans are swept
    // server-side.
    match /userClips/{uid}/{fileName} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == uid
        // Minimum 1 KB — prevents empty/stub uploads.
        && request.resource.size > 1024
        // Maximum 50 MB per video.
        && request.resource.size < 50 * 1024 * 1024
        // Per-extension content-type pinning: the extension and the
        // contentType MUST agree, so a client cannot ship an HTML/SVG
        // payload behind a `.webm` name. The charset-restricted stem also
        // rejects path traversal (`../`) and encoded separators.
        && (
          (fileName.matches('[A-Za-z0-9_-]+\\.webm') && request.resource.contentType == 'video/webm')
          || (fileName.matches('[A-Za-z0-9_-]+\\.mp4') && request.resource.contentType == 'video/mp4')
        )
        // Mirrors the game-video block so delete-by-metadata stays uniform.
        && request.resource.metadata.uploaderUid == request.auth.uid;

      allow update: if false;

      allow delete: if request.auth != null
        && request.auth.uid == uid;
    }

    // Default: deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
